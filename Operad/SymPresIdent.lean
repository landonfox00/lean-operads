/-
# The step-3 presentations of `Com`, `Lie`, `Ass` and `Pois` are the library's operads

Step 3 of the bridge between symmetric and shuffle operads (`Operad.SymPresComLie`,
`Operad.SymPresAss`, `Operad.SymPresPois`) proves `Koszul.IsKoszul K E r` for graded
presentations `(E, r)` of `Com`, `Lie`, `Ass` and `Pois`, over a field `K` of characteristic zero.
The operad in question is `Koszul.Pres K E r`, the quotient of the free graded operad
`FreeGrL K E` by the ideal generated by `r`; every operation is even. This file identifies it with
the library's ungraded binary quadratic operads `BinCom`, `Lie`, `BinAss` and `Pois`
(`Operad.BinaryQuadratic`, `Operad.BinaryKoszulSym`) **through their algebras**: an algebra over
`Koszul.Pres K E r` on a `K`-module `V` in even degree, a morphism of graded operads into
`SymGr (EndOp K V)` (`SymPresIdent.PresAlg`), is the same as an algebra over the binary quadratic
operad.

* **Generic part.** A morphism out of `Koszul.Pres K E r` is a morphism out of `FreeGrL K E`
  killing the relators (`SymPresIdent.presAlgEquiv`). For generators with a basis `c` indexed by
  binary generators, morphisms out of `FreeGrL K E` agree when they agree on the basis vectors
  (`SymPresIdent.hom_ext_basis`); reversing the inputs of a basis vector reverses those of its
  operation (`SymPresIdent.op2_swap`). An `𝔖₃`-orbit of relators is killed when its
  representatives are (`SymPresIdent.kills_orbitRel_iff`), and the relators `SymPresB.kerRel ψ`
  of a model are killed by `φ` iff every shuffle relator `v ∈ ShuffleBarSym.Rsh` gives a vanishing
  combination `∑ v σ • σ` of the values of the monomials under `φ`
  (`SymPresIdent.kills_kerRel_iff`). A bilinear map `m` gives a model of the representations
  `BinSp K K ρ` of `𝔖₂` (`SymPresIdent.modelB`, `SymPresIdent.μ_modelB`).
* **`Com`**: `SymPresIdent.comAlgEquiv : PresAlg K (ECom K) (rCom K) V ≃ ComAlg K V` and
  **`SymPresIdent.comEquiv : PresAlg K (ECom K) (rCom K) V ≃ SymAlgebra K (FreeBin.BinCom K) V`**,
  through `FreeBin.BinCom.algebraEquiv`.
* **`Lie`**: `SymPresIdent.lieAlgEquiv : PresAlg K (ELie K) (rLie K) V ≃ LieAlg K V` and
  **`SymPresIdent.lieEquiv : PresAlg K (ELie K) (rLie K) V ≃ SymAlgebra K (Lie K) V`**, through
  `Lie.algebraEquiv`.
* **`Ass`**: `SymPresIdent.assAlgEquiv : PresAlg K (SymPresAss.E K) (SymPresAss.rel K) V ≃
  AssAlg K V` and **`SymPresIdent.assEquiv`**, onto `SymAlgebra K (BinAss K) V`. A monomial takes
  the product of its word (`SymPresIdent.lev_model_ass`).
* **`Pois`**: `SymPresIdent.poisAlgEquiv : PresAlg K (SymPresPois.E K) (SymPresPois.rel K) V ≃
  PoisAlg K V` and **`SymPresIdent.poisEquiv`**, onto `SymAlgebra K (Pois K) V`. The six rules of
  `PoisBin.relB` hold in every Poisson algebra (`SymPresIdent.relB_vanish_alg`).

`Com` and `Lie` need `2` invertible, for the symmetrization of a commutative product or a bracket
on the one-dimensional representations of `𝔖₂`. The isomorphisms of graded operads
`Koszul.Pres K E r ≅ SymGr (BinPres …)` are not made here.
-/
import Operad.SymPresComLie
import Operad.SymPresAss
import Operad.SymPresPois
import Operad.BinaryKoszulSym

universe u v w

namespace Operad

open Sym SymPresB

/-! ## The commutative operad as a binary quadratic operad, and its algebras -/

namespace FreeBin

variable {R : Type u} [CommRing R] {V : Type v} [AddCommGroup V] [Module R V]

/-- **Algebras over the binary quadratic commutative operad are commutative associative
algebras.** -/
noncomputable def BinCom.algebraEquiv : SymAlgebra R (BinCom R) V ≃ ComAlg R V :=
  (BinPres.algebraEquiv _ _).trans
    { toFun := fun μ => ⟨μ.1 (), (BinRel.comm_iff μ.1 ()).1 (μ.2.1 _ rfl),
        (BinRel.assoc_iff μ.1 ()).1 (μ.2.2 _ rfl)⟩
      invFun := fun a => ⟨fun _ => a.mul, fun _ h => h ▸ (BinRel.comm_iff _ ()).2 a.comm,
        fun _ h => h ▸ (BinRel.assoc_iff _ ()).2 a.assoc⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }

end FreeBin

namespace SymPresIdent

/-! ## Binary operations as bilinear maps -/

section Bil

variable {K : Type u} [CommRing K] {V : Type v} [AddCommGroup V] [Module K V]

/-- **The bilinear map of a binary operation.** -/
def bil (F : EndOp K V (Fin 2)) : V →ₗ[K] V →ₗ[K] V :=
  LinearMap.mk₂ K (fun x y => F ![x, y])
    (fun x x' y => F.cons_add ![y] x x')
    (fun a x y => F.cons_smul ![y] a x)
    (fun x y y' => by
      have h : ∀ z : V, Function.update ![x, y] 1 z = ![x, z] := fun z => by
        funext i
        fin_cases i <;> rfl
      have := F.map_update_add ![x, y] 1 y y'
      rwa [h, h, h] at this)
    (fun a x y => by
      have h : ∀ z : V, Function.update ![x, y] 1 z = ![x, z] := fun z => by
        funext i
        fin_cases i <;> rfl
      have := F.map_update_smul ![x, y] 1 a y
      rwa [h, h] at this)

@[simp] lemma bil_apply (F : EndOp K V (Fin 2)) (x y : V) : bil F x y = F ![x, y] := rfl

lemma bilinOp_bil (F : EndOp K V (Fin 2)) : FreeBin.bilinOp (bil F) = F :=
  MultilinearMap.ext fun w => by
    rw [EndOp.vec_two w]
    rfl

lemma neg_left (F : EndOp K V (Fin 2)) (x y : V) : F ![-x, y] = -F ![x, y] := by
  rw [← bil_apply, map_neg, LinearMap.neg_apply, bil_apply]

lemma neg_right (F : EndOp K V (Fin 2)) (x y : V) : F ![x, -y] = -F ![x, y] := by
  rw [← bil_apply, map_neg, bil_apply]

lemma sgEv_sub {A : Type} [Fintype A] [DecidableEq A] (x y : SymGr (EndOp K V) A) (w : A → V) :
    sgEv (x - y) w = sgEv x w - sgEv y w := rfl

end Bil

/-- A coordinate vector of one monomial picks its value. -/
lemma sum_vecOf {K : Type u} [Field K] {G : Type} [Fintype G] [DecidableEq G] {W : Type w}
    [AddCommGroup W] [Module K W] (F : LTree G → W) {t : LTree G} (ht : t ∈ LTree.monomials 3) :
    ∑ σ : LTree.Mono G 3, LTree.vecOf K 3 t σ • F σ.1 = F t := by
  rw [Finset.sum_eq_single ⟨t, ht⟩ (fun σ _ hσ => ?_) (by simp)]
  · simp [LTree.vecOf]
  · rw [show LTree.vecOf K 3 t σ = 0 from if_neg fun h => hσ (Subtype.ext h), zero_smul]


/-! ## Algebras over a presented graded operad -/

section Generic

variable (K : Type u) [Field K] (E : (A : Type) → [Fintype A] → [DecidableEq A] → Type u)
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (E A)] [GrSpecies K E]
  (r : ∀ n : ℕ, Set (FreeGrL K E (Fin n))) (V : Type v) [AddCommGroup V] [Module K V]

/-- **An algebra over the presented graded operad `Koszul.Pres K E r`** on a module `V` in even
degree: a morphism of graded operads into `SymGr (EndOp K V)`. -/
abbrev PresAlg := GrOperadHom K (Koszul.Pres K E r) (SymGr (EndOp K V))

variable {K E V}

/-- A morphism out of `FreeGrL K E` **kills the relators** `r`. -/
def Kills {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
    [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
    [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (Q A)] [GrOperad K Q]
    (r : ∀ n : ℕ, Set (FreeGrL K E (Fin n))) (φ : GrOperadHom K (FreeGrL K E) Q) : Prop :=
  ∀ n, ∀ x ∈ r n, φ.app (Fin n) x = 0

/-- **An algebra over `Koszul.Pres K E r` is an algebra over `FreeGrL K E` killing `r`.** -/
noncomputable def presAlgEquiv :
    PresAlg K E r V ≃ {φ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K V)) // Kills r φ} :=
  GrOperadIdeal.presHomEquiv

variable {G : Type} (c : ∀ k, Module.Basis (BinGen G k) K (E (Fin k)))

/-- **Morphisms out of the free graded operad agree when they agree on the basis vectors** of
the generators, all in arity two. -/
theorem hom_ext_basis {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
    [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
    [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (Q A)] [GrOperad K Q]
    {φ ψ : GrOperadHom K (FreeGrL K E) Q}
    (h : ∀ g : G, φ.app (Fin 2) ((FreeGrL.ι K E).app (Fin 2) (c 2 (.op g)))
      = ψ.app (Fin 2) ((FreeGrL.ι K E).app (Fin 2) (c 2 (.op g)))) : φ = ψ := by
  have hfin : ∀ (n : ℕ) (v : E (Fin n)), φ.app (Fin n) ((FreeGrL.ι K E).app (Fin n) v)
      = ψ.app (Fin n) ((FreeGrL.ι K E).app (Fin n) v) := fun n =>
    LinearMap.congr_fun ((c n).ext (f₁ := φ.app (Fin n) ∘ₗ (FreeGrL.ι K E).app (Fin n))
      (f₂ := ψ.app (Fin n) ∘ₗ (FreeGrL.ι K E).app (Fin n)) fun β => by
        cases β with
        | op g => exact h g)
  refine FreeGrL.hom_ext fun A _ _ v => ?_
  let e := Fintype.equivFin A
  have hv : v = SymSpecies.map (R := K) e.symm (SymSpecies.map (R := K) e v) := by
    rw [← SymSpecies.map_trans, Equiv.self_trans_symm, SymSpecies.map_refl]
  rw [hv, (FreeGrL.ι K E).app_map]
  exact (φ.app_map _ _).trans ((congrArg _ (hfin _ _)).trans (ψ.app_map _ _).symm)

/-- **The binary operation of a generator** under a morphism into `SymGr (EndOp K V)`. -/
noncomputable def op2 (φ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K V))) (g : G) :
    EndOp K V (Fin 2) :=
  φ.app (Fin 2) ((FreeGrL.ι K E).app (Fin 2) (c 2 (.op g)))

lemma μ_eq [Fintype G] [DecidableEq G] (φ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K V)))
    (g : G) (x y : V) : SymPresB.μ c φ g x y = op2 c φ g ![x, y] := rfl

/-- **Reversing the inputs of a basis vector reverses those of its operation.** -/
lemma op2_swap (φ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K V))) {g g' : G} {a : K}
    (hsw : SymSpecies.map (R := K) (Equiv.swap (0 : Fin 2) 1) (c 2 (.op g)) = a • c 2 (.op g'))
    (x y : V) : op2 c φ g ![y, x] = a • op2 c φ g' ![x, y] := by
  have h := congrArg (fun F => sgEv F ![x, y])
    ((congrArg (φ.app (Fin 2)) ((FreeGrL.ι K E).app_map (Equiv.swap (0 : Fin 2) 1)
      (c 2 (.op g)))).trans (φ.app_map _ _))
  simp only [hsw, map_smul] at h
  rw [sgEv_map, show (![x, y] ∘ (Equiv.swap (0 : Fin 2) 1)) = ![y, x] from EndOp.vec_swap x y]
    at h
  exact h.symm

/-! ### Orbit relators and the relators of a model -/

/-- **An orbit of relators is killed when its representatives are.** -/
theorem kills_orbitRel_iff (S : Set (FreeGrL K E (Fin 3)))
    (φ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K V))) :
    Kills (ShuffleBarSym.orbitRel S) φ ↔ ∀ x ∈ S, φ.app (Fin 3) x = 0 := by
  refine ⟨fun h x hx => h 3 x ⟨Equiv.refl _, x, hx, (GrOperad.map_refl (R := K) x).symm⟩, ?_⟩
  rintro h n _ ⟨e, x, hx, rfl⟩
  rw [φ.app_map, h x hx, map_zero]

end Generic

section Ker

variable {K : Type u} [Field K] {E : (A : Type) → [Fintype A] → [DecidableEq A] → Type u}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (E A)] [GrSpecies K E]
  {G : Type} [Fintype G] [DecidableEq G]
  (c : ∀ k, Module.Basis (BinGen G k) K (E (Fin k)))
  (hc : ∀ k (β : BinGen G k), GrSpecies.par (R := K) false (c k β) = c k β)
  {V : Type v} [AddCommGroup V] [Module K V]

/-- **The relators of a model `ψ` are killed by `φ`** iff every shuffle relator `v` gives a
combination `∑ v σ • σ` of monomials whose values under `φ` vanish on every family of three
inputs. -/
theorem kills_kerRel_iff {W : Type w} [AddCommGroup W] [Module K W]
    (ψ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K W)))
    (φ : GrOperadHom K (FreeGrL K E) (SymGr (EndOp K V))) :
    Kills (kerRel ψ) φ ↔ ∀ v ∈ ShuffleBarSym.Rsh c hc (kerRel ψ), ∀ w : Fin 3 → V,
      ∑ σ : LTree.Mono G 3, v σ • lev (μ c φ) (ext3 w) σ.1 = 0 := by
  let b := ShuffleBarSym.tBasis c hc (Fin 3)
  constructor
  · intro h v hv w
    have hψ : ψ.app (Fin 3) (b.equivFun.symm (v ∘ monoEquiv)) = 0 := by
      rw [eq_zero_iff]
      intro w'
      rw [Module.Basis.equivFun_symm_apply, sgEv_app_sum c hc ψ]
      refine ((Finset.sum_congr rfl fun σ _ => ?_).trans ((mem_Rsh_kerRel c hc ψ v).1 hv w'))
      simp
    have h1 := sgEv_app_sum c hc φ (v ∘ monoEquiv) w
    rw [← Module.Basis.equivFun_symm_apply, h 3 _ ⟨rfl, hψ⟩, sgEv_zero] at h1
    refine ((Finset.sum_congr rfl fun σ _ => ?_).trans h1.symm)
    simp
  · rintro h n x ⟨rfl, hx⟩
    rw [eq_zero_iff]
    intro w
    have hv : (fun σ => b.repr x (monoEquiv.symm σ)) ∈ ShuffleBarSym.Rsh c hc (kerRel ψ) := by
      rw [mem_Rsh_kerRel]
      intro w'
      rw [← sgEv_app_sum c hc ψ, b.sum_repr, hx]
      rfl
    rw [← b.sum_repr x, sgEv_app_sum c hc φ]
    exact h _ hv w

end Ker


/-! ## A model of the representations of `𝔖₂` in arity two -/

section ModelB

variable {K : Type u} [Field K] {ρ : K →ₗ[K] K} {V : Type v} [AddCommGroup V] [Module K V]

/-- A vector of `BinSp K K ρ A`, as a function on the numberings `Fin 2 ≃ A`. -/
def toReg2 (A : Type) [Fintype A] [DecidableEq A] : BinSp K K ρ A →ₗ[K] Reg2 K A where
  toFun f := fun τ => f.1 τ.symm
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

variable (ρ) in
/-- **The model of `BinSp K K ρ` given by a bilinear map** `m`: a vector `f` to the sum of the
values `f τ⁻¹ • m (x_{τ 0}, x_{τ 1})` over the numberings `τ`. -/
noncomputable def modelBHom (m : V →ₗ[K] V →ₗ[K] V) :
    GrSpeciesHom K (BinSp K K ρ) (SymGr (EndOp K V)) where
  app A _ _ := modelApp m A ∘ₗ toReg2 A
  app_map e f := (modelHom m).app_map e (toReg2 _ f)
  app_par b f := by
    cases b
    · rfl
    · show modelApp m _ (toReg2 _ (BinSp.parL true f)) = 0
      simp [BinSp.parL]

variable (ρ) in
/-- **The model morphism of graded operads** `FreeGrL K (BinSp K K ρ) → SymGr (EndOp K V)`. -/
noncomputable def modelB (m : V →ₗ[K] V →ₗ[K] V) :
    GrOperadHom K (FreeGrL K (BinSp K K ρ)) (SymGr (EndOp K V)) :=
  FreeGrL.homEquiv.symm (modelBHom ρ m)

/-- **The operation of a generator in the model**, on two inputs. -/
lemma μ_modelB {G : Type} [Fintype G] [DecidableEq G]
    (c : ∀ k, Module.Basis (BinGen G k) K (BinSp K K ρ (Fin k))) (m : V →ₗ[K] V →ₗ[K] V)
    (g : G) (x y : V) :
    μ c (modelB ρ m) g x y = (c 2 (BinGen.op g)).1 (Equiv.refl _) • m x y
      + (c 2 (BinGen.op g)).1 (Equiv.swap 0 1) • m y x := by
  rw [μ, modelB, FreeGrL.homEquiv_symm_ι]
  show sgEv (modelApp m _ _) _ = _
  rw [sgEv_modelApp, univ_perm_two, Finset.sum_pair (by decide)]
  rfl

lemma ofV_apply_swap (hρ : ∀ v, ρ (ρ v) = v) (v : K) :
    (BinSp.ofV ρ hρ v).1 (Equiv.swap 0 1) = ρ v := by
  simp [BinSp.ofV, BinSp.ofFun]

end ModelB

/-! ## `Com` -/

section Com

open SymPresComLie

variable (K : Type u) [Field K] (V : Type v) [AddCommGroup V] [Module K V]

lemma cCom_refl (g : ComGen 2) : (cCom K 2 (.op g)).1 (Equiv.refl _) = 1 := by
  rw [cCom, BinSp.basis_op, BinSp.ofV_apply_refl, Module.Basis.singleton_apply]

lemma cCom_swap (g : ComGen 2) : (cCom K 2 (.op g)).1 (Equiv.swap 0 1) = 1 := by
  rw [cCom, BinSp.basis_op, ofV_apply_swap, Module.Basis.singleton_apply]
  rfl

variable {K V}

/-- **The values of the associator** under a morphism: `(xy)z - x(yz)`. -/
lemma sgEv_assoc (φ : GrOperadHom K (FreeGrL K (ECom K)) (SymGr (EndOp K V))) (w : Fin 3 → V) :
    sgEv (φ.app (Fin 3) (SymPresComLie.assoc K)) w
      = μ (cCom K) φ .mu (μ (cCom K) φ .mu (w 0) (w 1)) (w 2)
        - μ (cCom K) φ .mu (w 0) (μ (cCom K) φ .mu (w 1) (w 2)) := by
  rw [SymPresComLie.assoc, LinearMap.map_sub, sgEv_sub, tb, tb, app_tBasis, app_tBasis]
  rfl

/-- The product of an algebra over `FreeGrL K (ECom K)` killing the associator is commutative and
associative. -/
noncomputable def comAlgOf (φ : GrOperadHom K (FreeGrL K (ECom K)) (SymGr (EndOp K V)))
    (hφ : Kills (rCom K) φ) : ComAlg K V where
  mul := op2 (cCom K) φ .mu
  comm x y := (op2_swap (cCom K) φ (swCom K .mu) y x).trans (one_smul K _)
  assoc x y z := by
    have h := sgEv_assoc φ ![x, y, z]
    rw [(kills_orbitRel_iff _ φ).1 hφ _ rfl, sgEv_zero] at h
    exact sub_eq_zero.1 h.symm

variable [CharZero K]

/-- **The algebra over `FreeGrL K (ECom K)` of a commutative product**, through the halved
product. -/
noncomputable def comModel (a : ComAlg K V) :
    GrOperadHom K (FreeGrL K (ECom K)) (SymGr (EndOp K V)) :=
  modelB _ ((2 : K)⁻¹ • bil a.mul)

lemma μ_comModel (a : ComAlg K V) (x y : V) : μ (cCom K) (comModel a) .mu x y = a.mul ![x, y] := by
  rw [comModel, μ_modelB, cCom_refl, cCom_swap, one_smul, one_smul, LinearMap.smul_apply,
    LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply, bil_apply, bil_apply,
    a.comm y x, ← add_smul, ← two_mul, mul_inv_cancel₀ two_ne_zero, one_smul]

lemma kills_comModel (a : ComAlg K V) : Kills (rCom K) (comModel a) :=
  (kills_orbitRel_iff _ _).2 fun x hx => by
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [eq_zero_iff]
    intro w
    rw [sgEv_assoc]
    simp only [μ_comModel]
    exact sub_eq_zero.2 (a.assoc _ _ _)

variable (K V) in
/-- **Algebras over `FreeGrL K (ECom K)` killing the associators are commutative associative
algebras.** -/
noncomputable def comAlgEquiv' :
    {φ : GrOperadHom K (FreeGrL K (ECom K)) (SymGr (EndOp K V)) // Kills (rCom K) φ}
      ≃ ComAlg K V where
  toFun φ := comAlgOf φ.1 φ.2
  invFun a := ⟨comModel a, kills_comModel a⟩
  left_inv φ := Subtype.ext (hom_ext_basis (cCom K) fun g => by
    cases g
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    exact μ_comModel _ _ _)
  right_inv a := by
    obtain ⟨m, h1, h2⟩ := a
    simp only [comAlgOf, ComAlg.mk.injEq]
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    exact μ_comModel ⟨m, h1, h2⟩ _ _

variable (K V) in
/-- **Algebras over the step-3 presentation of `Com` are commutative associative algebras.** -/
noncomputable def comAlgEquiv : PresAlg K (ECom K) (rCom K) V ≃ ComAlg K V :=
  (presAlgEquiv (rCom K)).trans (comAlgEquiv' K V)

variable (K V) in
/-- **Algebras over the step-3 presentation of `Com` are algebras over the binary quadratic
operad `BinCom`.** -/
noncomputable def comEquiv : PresAlg K (ECom K) (rCom K) V ≃ SymAlgebra K (FreeBin.BinCom K) V :=
  (comAlgEquiv K V).trans FreeBin.BinCom.algebraEquiv.symm

end Com

/-! ## `Lie` -/

section Lie

open SymPresComLie

variable (K : Type u) [Field K] (V : Type v) [AddCommGroup V] [Module K V]

lemma cLie_refl (g : ComGen 2) : (cLie K 2 (.op g)).1 (Equiv.refl _) = 1 := by
  rw [cLie, BinSp.basis_op, BinSp.ofV_apply_refl, Module.Basis.singleton_apply]

lemma cLie_swap (g : ComGen 2) : (cLie K 2 (.op g)).1 (Equiv.swap 0 1) = -1 := by
  rw [cLie, BinSp.basis_op, ofV_apply_swap, Module.Basis.singleton_apply]
  rfl

variable {K V}

/-- **The values of the Jacobiator** under a morphism: `[[x, y], z] - [[x, z], y] - [x, [y, z]]`.
-/
lemma sgEv_jacobi (φ : GrOperadHom K (FreeGrL K (ELie K)) (SymGr (EndOp K V)))
    (w : Fin 3 → V) :
    sgEv (φ.app (Fin 3) (SymPresComLie.jacobi K)) w
      = μ (cLie K) φ .mu (μ (cLie K) φ .mu (w 0) (w 1)) (w 2)
        - μ (cLie K) φ .mu (μ (cLie K) φ .mu (w 0) (w 2)) (w 1)
        - μ (cLie K) φ .mu (w 0) (μ (cLie K) φ .mu (w 1) (w 2)) := by
  rw [SymPresComLie.jacobi, LinearMap.map_sub, LinearMap.map_sub, sgEv_sub, sgEv_sub, tb, tb, tb,
    app_tBasis, app_tBasis, app_tBasis]
  rfl

/-- The bracket of an algebra over `FreeGrL K (ELie K)` killing the Jacobiator is antisymmetric
and satisfies the Jacobi identity. -/
noncomputable def lieAlgOf (φ : GrOperadHom K (FreeGrL K (ELie K)) (SymGr (EndOp K V)))
    (hφ : Kills (rLie K) φ) : LieAlg K V where
  bracket := op2 (cLie K) φ .mu
  antisymm x y := (op2_swap (cLie K) φ (swLie K .mu) y x).trans (neg_one_smul K _)
  jacobi x y z := by
    have anti : ∀ p q : V, op2 (cLie K) φ .mu ![p, q] = -op2 (cLie K) φ .mu ![q, p] :=
      fun p q => (op2_swap (cLie K) φ (swLie K .mu) q p).trans (neg_one_smul K _)
    have h := sgEv_jacobi φ ![x, y, z]
    rw [(kills_orbitRel_iff _ φ).1 hφ _ rfl, sgEv_zero] at h
    simp only [μ_eq, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two,
      Matrix.head_cons, Matrix.tail_cons] at h
    rw [anti (op2 (cLie K) φ .mu ![y, z]) x, anti z x, neg_left]
    refine Eq.trans ?_ h.symm
    abel

variable [CharZero K]

/-- **The algebra over `FreeGrL K (ELie K)` of an antisymmetric bracket**, through the halved
bracket. -/
noncomputable def lieModel (a : LieAlg K V) :
    GrOperadHom K (FreeGrL K (ELie K)) (SymGr (EndOp K V)) :=
  modelB _ ((2 : K)⁻¹ • bil a.bracket)

lemma μ_lieModel (a : LieAlg K V) (x y : V) :
    μ (cLie K) (lieModel a) .mu x y = a.bracket ![x, y] := by
  rw [lieModel, μ_modelB, cLie_refl, cLie_swap, one_smul, neg_one_smul, LinearMap.smul_apply,
    LinearMap.smul_apply, LinearMap.smul_apply, LinearMap.smul_apply, bil_apply, bil_apply,
    a.antisymm y x, smul_neg, neg_neg, ← add_smul, ← two_mul, mul_inv_cancel₀ two_ne_zero,
    one_smul]

lemma kills_lieModel (a : LieAlg K V) : Kills (rLie K) (lieModel a) :=
  (kills_orbitRel_iff _ _).2 fun x hx => by
    rw [Set.mem_singleton_iff] at hx
    subst hx
    rw [eq_zero_iff]
    intro w
    rw [sgEv_jacobi]
    simp only [μ_lieModel]
    have h := a.jacobi (w 0) (w 1) (w 2)
    rw [a.antisymm (a.bracket ![w 1, w 2]) (w 0), a.antisymm (w 2) (w 0), neg_left] at h
    refine Eq.trans ?_ h
    abel

variable (K V) in
/-- **Algebras over `FreeGrL K (ELie K)` killing the Jacobiators are Lie algebras.** -/
noncomputable def lieAlgEquiv' :
    {φ : GrOperadHom K (FreeGrL K (ELie K)) (SymGr (EndOp K V)) // Kills (rLie K) φ}
      ≃ LieAlg K V where
  toFun φ := lieAlgOf φ.1 φ.2
  invFun a := ⟨lieModel a, kills_lieModel a⟩
  left_inv φ := Subtype.ext (hom_ext_basis (cLie K) fun g => by
    cases g
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    exact μ_lieModel _ _ _)
  right_inv a := by
    obtain ⟨m, h1, h2⟩ := a
    simp only [lieAlgOf, LieAlg.mk.injEq]
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    exact μ_lieModel ⟨m, h1, h2⟩ _ _

variable (K V) in
/-- **Algebras over the step-3 presentation of `Lie` are Lie algebras.** -/
noncomputable def lieAlgEquiv : PresAlg K (ELie K) (rLie K) V ≃ LieAlg K V :=
  (presAlgEquiv (rLie K)).trans (lieAlgEquiv' K V)

variable (K V) in
/-- **Algebras over the step-3 presentation of `Lie` are algebras over the binary quadratic
operad `Lie`.** -/
noncomputable def lieEquiv : PresAlg K (ELie K) (rLie K) V ≃ SymAlgebra K (Lie K) V :=
  (lieAlgEquiv K V).trans Lie.algebraEquiv.symm

end Lie

/-! ## `Ass` -/

section Ass

open SymPresAss AssShGen

variable {K : Type u} [Field K] {V : Type v} [AddCommGroup V] [Module K V]

/-- **The product of a nonempty list** of elements of `V`, bracketed to the right. -/
def lprod (F : EndOp K V (Fin 2)) : List V → V
  | [] => 0
  | [x] => x
  | x :: y :: l => F ![x, lprod F (y :: l)]

lemma lprod_cons (F : EndOp K V (Fin 2)) (x : V) {l : List V} (hl : l ≠ []) :
    lprod F (x :: l) = F ![x, lprod F l] := by
  cases l with
  | nil => exact absurd rfl hl
  | cons y l => rfl

/-- **The product of a concatenation** of nonempty lists is the product of their products, by
associativity. -/
lemma lprod_append (a : AssAlg K V) :
    ∀ {l₁ l₂ : List V}, l₁ ≠ [] → l₂ ≠ [] →
      lprod a.mul (l₁ ++ l₂) = a.mul ![lprod a.mul l₁, lprod a.mul l₂]
  | [], _, h, _ => absurd rfl h
  | [x], _, _, h₂ => lprod_cons _ x h₂
  | x :: y :: l, l₂, _, h₂ => by
    rw [List.cons_append, lprod_cons _ x (by simp), lprod_append a (List.cons_ne_nil y l) h₂,
      ← a.assoc]
    rfl

/-- The product of an associative algebra, as the bilinear map of the model. -/
noncomputable abbrev assModel (a : AssAlg K V) :
    GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)) :=
  model (bil a.mul)

lemma μ_assModel_mu (a : AssAlg K V) (x y : V) :
    μ (c K) (assModel a) mu x y = a.mul ![x, y] := by
  rw [assModel, μ_model, val_c, val_c]
  simp [genEquiv]

lemma μ_assModel_op (a : AssAlg K V) (x y : V) :
    μ (c K) (assModel a) op x y = a.mul ![y, x] := by
  have hne : Equiv.refl (Fin 2) ≠ Equiv.swap 0 1 := by decide
  rw [assModel, μ_model, val_c, val_c]
  simp [genEquiv, hne]

/-- **A monomial takes the product of its word** in an associative algebra. -/
theorem lev_model_ass (a : AssAlg K V) (v : ℕ → V) :
    ∀ t : LTree (AssShGen 2), lev (μ (c K) (assModel a)) v t = lprod a.mul ((AssBin.ev t).map v)
  | .leaf _ => rfl
  | .node mu l r => by
    rw [lev, μ_assModel_mu, lev_model_ass a v l, lev_model_ass a v r, AssBin.ev, ap,
      List.map_append, lprod_append a (by simpa using AssBin.ev_ne_nil l)
        (by simpa using AssBin.ev_ne_nil r)]
  | .node op l r => by
    rw [lev, μ_assModel_op, lev_model_ass a v l, lev_model_ass a v r, AssBin.ev, ap,
      List.map_append, lprod_append a (by simpa using AssBin.ev_ne_nil r)
        (by simpa using AssBin.ev_ne_nil l)]

lemma kills_assModel (a : AssAlg K V) : Kills (rel K) (assModel a) :=
  (kills_kerRel_iff (c K) (hc K) (φ K) (assModel a)).2 fun v hv w => by
    have hv' : v ∈ AssBin.rel K := by
      rw [← Rsh_eq K]
      exact hv
    have h0 : AssBin.evL K 3 v = 0 := hv'
    rw [AssBin.evL_apply] at h0
    have h1 := congrArg (Finsupp.linearCombination K
      fun l : List ℕ => lprod a.mul (l.map (ext3 w))) h0
    rw [map_zero, map_sum] at h1
    rw [← h1]
    refine Finset.sum_congr rfl fun σ _ => ?_
    rw [lev_model_ass, map_smul, Finsupp.linearCombination_single, one_smul]

/-- The left comb `μ(μ(0, 1), 2)`. -/
def tL : LTree (AssShGen 2) := .node mu (.node mu (.leaf 0) (.leaf 1)) (.leaf 2)

/-- The right comb `μ(0, μ(1, 2))`. -/
def tR : LTree (AssShGen 2) := .node mu (.leaf 0) (.node mu (.leaf 1) (.leaf 2))

lemma tL_mem : tL ∈ LTree.monomials 3 := (LTree.mem_monomials 3 _).2 ⟨by decide, by decide⟩

lemma tR_mem : tR ∈ LTree.monomials 3 := (LTree.mem_monomials 3 _).2 ⟨by decide, by decide⟩

/-- The product of an algebra over `FreeGrL K (Reg2 K)` killing the relators of `Ass` is
associative. -/
noncomputable def assAlgOf (ψ : GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)))
    (hψ : Kills (rel K) ψ) : AssAlg K V where
  mul := op2 (c K) ψ mu
  assoc x y z := by
    have hv : LTree.vecOf K 3 tL - LTree.vecOf K 3 tR
        ∈ ShuffleBarSym.Rsh (c K) (hc K) (kerRel (φ K)) := by
      show _ ∈ ShuffleBarSym.Rsh (c K) (hc K) (rel K)
      rw [Rsh_eq]
      show AssBin.evL K 3 _ = 0
      rw [map_sub, AssBin.evL_vecOf tL_mem, AssBin.evL_vecOf tR_mem]
      exact sub_self _
    have h := (kills_kerRel_iff (c K) (hc K) (φ K) ψ).1 hψ _ hv ![x, y, z]
    simp only [Pi.sub_apply, sub_smul, Finset.sum_sub_distrib, sum_vecOf _ tL_mem,
      sum_vecOf _ tR_mem] at h
    exact sub_eq_zero.1 h

/-- The opposite product is the product with its inputs exchanged. -/
lemma map_swap_c_mu : SymSpecies.map (R := K) (Equiv.swap (0 : Fin 2) 1) (c K 2 (.op mu))
    = (1 : K) • c K 2 (.op op) := by
  funext τ
  show (c K 2 (.op mu)).val (τ.trans (Equiv.swap 0 1).symm) = 1 * (c K 2 (.op op)).val τ
  have hne : Equiv.refl (Fin 2) ≠ Equiv.swap 0 1 := by decide
  rw [val_c, val_c, one_mul]
  rcases SymPresPois.perm_two τ with rfl | rfl <;> simp [genEquiv, hne, hne.symm]

variable (K V) in
/-- **Algebras over `FreeGrL K (Reg2 K)` killing the relators of `Ass` are associative
algebras.** -/
noncomputable def assAlgEquiv' :
    {ψ : GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)) // Kills (rel K) ψ}
      ≃ AssAlg K V where
  toFun ψ := assAlgOf ψ.1 ψ.2
  invFun a := ⟨assModel a, kills_assModel a⟩
  left_inv ψ := Subtype.ext (hom_ext_basis (c K) fun g => by
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    cases g
    · exact μ_assModel_mu _ _ _
    · exact (μ_assModel_op _ _ _).trans
        ((op2_swap (c K) ψ.1 map_swap_c_mu (w 0) (w 1)).trans (one_smul K _)))
  right_inv a := by
    obtain ⟨m, h⟩ := a
    simp only [assAlgOf, AssAlg.mk.injEq]
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    exact μ_assModel_mu ⟨m, h⟩ _ _

variable (K V) in
/-- **Algebras over the step-3 presentation of `Ass` are associative algebras.** -/
noncomputable def assAlgEquiv : PresAlg K (E K) (rel K) V ≃ AssAlg K V :=
  (presAlgEquiv (rel K)).trans (assAlgEquiv' K V)

variable (K V) in
/-- **Algebras over the step-3 presentation of `Ass` are algebras over the binary quadratic
operad `BinAss`.** -/
noncomputable def assEquiv : PresAlg K (E K) (rel K) V ≃ SymAlgebra K (BinAss K) V :=
  (assAlgEquiv K V).trans BinAss.algebraEquiv.symm

end Ass

/-! ## `Pois` -/

section Pois

open SymPresPois PoisShGen

variable {K : Type u} [Field K] [CharZero K] {V : Type v} [AddCommGroup V] [Module K V]

omit [Field K] [CharZero K] in
lemma ext3_zero (w : Fin 3 → V) : ext3 w 0 = w 0 := rfl

omit [Field K] [CharZero K] in
lemma ext3_one (w : Fin 3 → V) : ext3 w 1 = w 1 := rfl

omit [Field K] [CharZero K] in
lemma ext3_two (w : Fin 3 → V) : ext3 w 2 = w 2 := rfl

omit [CharZero K] in
lemma relList_mem (r : Rule) : ∀ x ∈ PoisBin.relList r, x.2 ∈ LTree.monomials 3 := by
  cases r <;> simp [PoisBin.relList, PoisBin.bL_mem, PoisBin.bT_mem, PoisBin.bR_mem]

/-- **The combination of a rule**, as the sum of the values of its monomials. -/
lemma sum_relB (ψ : GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V))) (r : Rule)
    (w : Fin 3 → V) :
    ∑ σ : LTree.Mono (PoisShGen 2) 3, PoisBin.relB K r σ • lev (μ (c K) ψ) (ext3 w) σ.1
      = ((PoisBin.relList r).map fun x => (x.1 : K) • lev (μ (c K) ψ) (ext3 w) x.2).sum := by
  rw [PoisBin.relB]
  exact sum_combo _ _ (relList_mem r)

/-- **The rules hold in an algebra killing the relators of `Pois`.** -/
lemma rule_of (ψ : GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)))
    (hψ : Kills (rel K) ψ) (r : Rule) (w : Fin 3 → V) :
    ((PoisBin.relList r).map fun x => (x.1 : K) • lev (μ (c K) ψ) (ext3 w) x.2).sum = 0 := by
  rw [← sum_relB]
  refine (kills_kerRel_iff (c K) (hc K) (φ K) ψ).1 hψ _ ?_ w
  show _ ∈ ShuffleBarSym.Rsh (c K) (hc K) (rel K)
  rw [Rsh_eq, PoisBin.rel_eq_span_relB]
  exact Submodule.subset_span ⟨r, rfl⟩

omit [CharZero K] in
lemma tr_refl_swap : (Equiv.refl (Fin 2)).trans (Equiv.swap 0 1).symm = Equiv.swap 0 1 := by
  decide

omit [CharZero K] in
lemma tr_swap_swap : (Equiv.swap (0 : Fin 2) 1).trans (Equiv.swap 0 1).symm = Equiv.refl _ := by
  decide

/-- The product is symmetric. -/
lemma map_swap_c_mul : SymSpecies.map (R := K) (Equiv.swap (0 : Fin 2) 1) (c K 2 (.op mul))
    = (1 : K) • c K 2 (.op mul) := by
  funext τ
  show (c K 2 (.op mul)).val (τ.trans (Equiv.swap 0 1).symm) = 1 * (c K 2 (.op mul)).val τ
  rw [val_c, val_c]
  rcases perm_two τ with rfl | rfl
  · rw [tr_refl_swap, symm_swap, symm_refl]
    simp
  · rw [tr_swap_swap, symm_refl, symm_swap]
    simp

/-- The bracket is antisymmetric. -/
lemma map_swap_c_br : SymSpecies.map (R := K) (Equiv.swap (0 : Fin 2) 1) (c K 2 (.op br))
    = (-1 : K) • c K 2 (.op br) := by
  funext τ
  show (c K 2 (.op br)).val (τ.trans (Equiv.swap 0 1).symm) = -1 * (c K 2 (.op br)).val τ
  rw [val_c, val_c]
  rcases perm_two τ with rfl | rfl
  · rw [tr_refl_swap, symm_swap, symm_refl]
    simp
    ring
  · rw [tr_swap_swap, symm_refl, symm_swap]
    simp
    ring

/-- The product and the bracket of an algebra over `FreeGrL K (Reg2 K)` killing the relators of
`Pois` form a Poisson algebra. -/
noncomputable def poisAlgOf (ψ : GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)))
    (hψ : Kills (rel K) ψ) : PoisAlg K V where
  mul := op2 (c K) ψ mul
  bracket := op2 (c K) ψ br
  comm x y := (op2_swap (c K) ψ map_swap_c_mul y x).trans (one_smul K _)
  assoc x y z := by
    have h := rule_of ψ hψ .as₁ ![x, y, z]
    simp only [PoisBin.relList, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
      PoisBin.bL, PoisBin.bR, lev, Int.cast_one, Int.cast_neg, one_smul,
      neg_one_smul, add_zero, μ_eq, ext3_zero, ext3_one, ext3_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at h
    refine (sub_eq_zero.1 (Eq.trans ?_ h)).symm
    abel
  antisymm x y := (op2_swap (c K) ψ map_swap_c_br y x).trans (neg_one_smul K _)
  jacobi x y z := by
    have anti : ∀ p q : V, op2 (c K) ψ br ![p, q] = -op2 (c K) ψ br ![q, p] :=
      fun p q => (op2_swap (c K) ψ map_swap_c_br q p).trans (neg_one_smul K _)
    have h := rule_of ψ hψ .jac ![x, y, z]
    simp only [PoisBin.relList, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
      PoisBin.bL, PoisBin.bT, PoisBin.bR, lev, Int.cast_one, Int.cast_neg, one_smul,
      neg_one_smul, add_zero, μ_eq, ext3_zero, ext3_one, ext3_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at h
    rw [anti (op2 (c K) ψ br ![y, z]) x, anti z x, neg_left]
    refine Eq.trans ?_ h
    abel
  leibniz x y z := by
    have comm : ∀ p q : V, op2 (c K) ψ mul ![p, q] = op2 (c K) ψ mul ![q, p] :=
      fun p q => (op2_swap (c K) ψ map_swap_c_mul q p).trans (one_smul K _)
    have h := rule_of ψ hψ .leib₁ ![x, y, z]
    simp only [PoisBin.relList, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
      PoisBin.bL, PoisBin.bT, PoisBin.bR, lev, Int.cast_one, Int.cast_neg, one_smul,
      neg_one_smul, add_zero, μ_eq, ext3_zero, ext3_one, ext3_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons, Matrix.tail_cons] at h
    rw [comm (op2 (c K) ψ br ![x, z]) y] at h
    rw [← sub_eq_zero]
    refine Eq.trans ?_ h
    abel

/-- **The algebra over `FreeGrL K (Reg2 K)` of a Poisson algebra**: the model of the product
plus the bracket. -/
noncomputable abbrev poisModel (a : PoisAlg K V) :
    GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)) :=
  model (bil a.mul + bil a.bracket)

lemma μ_poisModel_mul (a : PoisAlg K V) (x y : V) :
    μ (c K) (poisModel a) mul x y = a.mul ![x, y] := by
  rw [poisModel, μ_model, val_c, val_c, symm_refl, symm_swap]
  simp only [LinearMap.add_apply, bil_apply, Pi.single_apply, reduceCtorEq, if_true, if_false]
  rw [a.comm y x, a.antisymm y x]
  module

lemma μ_poisModel_br (a : PoisAlg K V) (x y : V) :
    μ (c K) (poisModel a) br x y = a.bracket ![x, y] := by
  rw [poisModel, μ_model, val_c, val_c, symm_refl, symm_swap]
  simp only [LinearMap.add_apply, bil_apply, Pi.single_apply, reduceCtorEq, if_true, if_false]
  rw [a.comm y x, a.antisymm y x]
  module

/-- **The six rules of `PoisBin.relB` hold in every Poisson algebra.** -/
theorem relB_vanish_alg (a : PoisAlg K V) (r : Rule) (w : Fin 3 → V) :
    ∑ σ : LTree.Mono (PoisShGen 2) 3,
      PoisBin.relB K r σ • lev (μ (c K) (poisModel a)) (ext3 w) σ.1 = 0 := by
  rw [sum_relB]
  cases r <;>
    simp only [PoisBin.relList, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,
      PoisBin.bL, PoisBin.bT, PoisBin.bR, lev, Int.cast_one, Int.cast_neg, one_smul,
      neg_one_smul, add_zero, μ_poisModel_mul, μ_poisModel_br, ext3_zero, ext3_one, ext3_two]
  · have h := a.jacobi (w 0) (w 1) (w 2)
    rw [a.antisymm (a.bracket ![w 1, w 2]) (w 0), a.antisymm (w 2) (w 0), neg_left] at h
    refine Eq.trans ?_ h
    abel
  · rw [a.comm (a.bracket ![w 0, w 2]) (w 1), a.leibniz]
    abel
  · rw [a.antisymm (a.mul ![w 0, w 2]) (w 1), a.leibniz (w 1) (w 0) (w 2),
      a.antisymm (w 1) (w 0), neg_left]
    abel
  · rw [a.antisymm (a.mul ![w 0, w 1]) (w 2), a.leibniz (w 2) (w 0) (w 1),
      a.antisymm (w 2) (w 0), a.antisymm (w 2) (w 1), neg_left, neg_right]
    abel
  · rw [a.assoc]
    abel
  · rw [a.assoc, a.assoc, a.comm (w 2) (w 1)]
    abel

lemma kills_poisModel (a : PoisAlg K V) : Kills (rel K) (poisModel a) :=
  (kills_kerRel_iff (c K) (hc K) (φ K) (poisModel a)).2 fun v hv w => by
    have hv' : v ∈ PoisBin.rel K := by
      rw [← Rsh_eq K]
      exact hv
    rw [PoisBin.rel_eq_span_relB] at hv'
    clear hv
    induction hv' using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨r, rfl⟩ := hx
      exact relB_vanish_alg a r w
    | zero => simp
    | add x y _ _ hx hy =>
      simp only [Pi.add_apply, add_smul, Finset.sum_add_distrib, hx, hy, add_zero]
    | smul b x _ hx =>
      simp only [Pi.smul_apply, smul_eq_mul, mul_smul, ← Finset.smul_sum, hx, smul_zero]

variable (K V) in
/-- **Algebras over `FreeGrL K (Reg2 K)` killing the relators of `Pois` are Poisson
algebras.** -/
noncomputable def poisAlgEquiv' :
    {ψ : GrOperadHom K (FreeGrL K (Reg2 K)) (SymGr (EndOp K V)) // Kills (rel K) ψ}
      ≃ PoisAlg K V where
  toFun ψ := poisAlgOf ψ.1 ψ.2
  invFun a := ⟨poisModel a, kills_poisModel a⟩
  left_inv ψ := Subtype.ext (hom_ext_basis (c K) fun g => by
    refine MultilinearMap.ext fun w => ?_
    rw [EndOp.vec_two w]
    cases g
    · exact μ_poisModel_mul _ _ _
    · exact μ_poisModel_br _ _ _)
  right_inv a := by
    obtain ⟨m, b, h1, h2, h3, h4, h5⟩ := a
    simp only [poisAlgOf, PoisAlg.mk.injEq]
    refine ⟨MultilinearMap.ext fun w => ?_, MultilinearMap.ext fun w => ?_⟩
    · rw [EndOp.vec_two w]
      exact μ_poisModel_mul ⟨m, b, h1, h2, h3, h4, h5⟩ _ _
    · rw [EndOp.vec_two w]
      exact μ_poisModel_br ⟨m, b, h1, h2, h3, h4, h5⟩ _ _

variable (K V) in
/-- **Algebras over the step-3 presentation of `Pois` are Poisson algebras.** -/
noncomputable def poisAlgEquiv : PresAlg K (E K) (rel K) V ≃ PoisAlg K V :=
  (presAlgEquiv (rel K)).trans (poisAlgEquiv' K V)

variable (K V) in
/-- **Algebras over the step-3 presentation of `Pois` are algebras over the binary quadratic
operad `Pois`.** -/
noncomputable def poisEquiv : PresAlg K (E K) (rel K) V ≃ SymAlgebra K (Pois K) V :=
  (poisAlgEquiv K V).trans Pois.algebraEquiv.symm

end Pois

end SymPresIdent

end Operad
