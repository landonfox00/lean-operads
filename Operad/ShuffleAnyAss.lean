/-
# The associative operad: a quadratic Gröbner basis, its PBW basis, and Koszulness

As a shuffle operad, the associative operad is generated by two binary operations, the product
`x₁x₂` (`AssShGen.mu`) and the opposite product `x₂x₁` (`AssShGen.op`); in the shuffle operad of
the symmetric `Ass` the transposition of the inputs is no longer an operation, so `x₂x₁` is a
second generator. A tree evaluates to the arrangement of its leaves computed by the products
(`AssShGen.ev`), and substituting into a context respects the words (`AssShGen.ev_ctx`). In arity
three there are twelve monomials and six arrangements, each the word of two monomials.

* **The rules** (`AssShGen.rules`). For the path-lexicographic order whose letters are the inputs
  taken, two more through `x₂x₁` (`AssShGen.order`), the leading monomials are the six left combs
  `e(f(0, 1), 2)` and `e(f(0, 2), 1)` with `(e, f) ≠ (x₁x₂, x₂x₁)`, each rewriting to the other
  monomial with its word (`AssShGen.tailOf`): the four with `e = f` to right combs, where the
  word of the leaf `0` is shorter, and `x₂x₁(x₁x₂(0, 1), 2)`, `x₂x₁(x₁x₂(0, 2), 1)` to
  `x₁x₂(x₂x₁(0, 2), 1)`, `x₁x₂(x₂x₁(0, 1), 2)`, where the word of the leaf `0` starts with `x₁x₂`.
* **The shape of the normal monomials** (`AssShGen.Good`, `AssShGen.good_of_normal`): every
  vertex whose first input is a vertex is `x₁x₂` above `x₂x₁`. The word of such a monomial splits
  at its least leaf (`AssShGen.exists_split`), so **it is determined by its word**
  (`AssShGen.ev_inj`).
* **The rules are a Gröbner basis** (`AssShGen.disjoint_normal`): the evaluation to words
  vanishes on the ideal generated by the rules (`AssShGen.ideal_le_ker`) and is injective on the
  normal monomials (`AssShGen.eq_zero_of_evL`). So every ambiguity is resolvable
  (`AssShGen.res_amb`), the critical ones of arity four in particular, the Buchberger criterion
  gives the PBW basis (`AssShGen.basis`), and **the associative operad is Koszul**
  (`AssShGen.isKoszul`), by `Operad.Rules.isKoszul_of_critical`.
* **The rules present the operad of arrangements**: the ideal they generate is the kernel of the
  evaluation to words (`AssShGen.ideal_eq_ker`), and every arrangement of distinct leaves is the
  word of a shuffle tree (`AssShGen.exists_ev`, `AssShGen.range_evL`). So on every nonempty set
  `A` of leaves the quotient is the span of the arrangements of `A`, of dimension `|A|!`
  (`AssShGen.finrank_eq_factorial`), and substitution of trees is substitution of words
  (`AssShGen.ev_subst`).

The identification of the presented shuffle operad with the shuffle operad of `Sym.Ass`, through
`SymOperad.toShuffle`, is not constructed: the statements above are in each arity, for the
evaluation to words. `Operad.ShuffleBinAss` proves the associative operad Koszul as a binary
shuffle operad too (`Operad.AssBin.isKoszul_and`), separately.
-/
import Operad.ShuffleAnyKoszul
import Operad.ShuffleAnyOrder
import Mathlib.Data.List.Permutation
import Mathlib.LinearAlgebra.Dimension.Constructions
import Mathlib.LinearAlgebra.Isomorphisms
import Mathlib.LinearAlgebra.FreeModule.StrongRankCondition

namespace Operad

/-- **The generators of the shuffle associative operad**: the product `x₁x₂` and the opposite
product `x₂x₁`, the two binary operations of `Ass` as a shuffle operad. -/
inductive AssShGen : ℕ → Type
  /-- the product `x₁x₂` -/
  | mu : AssShGen 2
  /-- the opposite product `x₂x₁` -/
  | op : AssShGen 2

open STree

namespace AssShGen

/-! ## Binary trees -/

/-- **The product of two trees** by a generator. -/
def bin (e : AssShGen 2) (x y : STree AssShGen) : STree AssShGen := node e ![x, y]

/-- Every vertex is a product. -/
lemma node_eq_bin (e : AssShGen 2) (c : Fin 2 → STree AssShGen) : node e c = bin e (c 0) (c 1) := by
  rw [bin]
  congr 1
  funext i
  fin_cases i <;> rfl

/-- The least leaf of a product. -/
@[simp] lemma first_bin (e : AssShGen 2) (x y : STree AssShGen) : (bin e x y).first = x.first := by
  rw [bin]
  exact first_node (k := 2) e ![x, y] (by norm_num)

/-- The leaves of a product. -/
@[simp] lemma labels_bin (e : AssShGen 2) (x y : STree AssShGen) :
    (bin e x y).labels = x.labels + y.labels := by
  simp [bin, Fin.sum_univ_two]

/-- Substitution in a product. -/
@[simp] lemma subst_bin (e : AssShGen 2) (x y : STree AssShGen) (xs : ℕ → STree AssShGen) :
    (bin e x y).subst xs = bin e (x.subst xs) (y.subst xs) := by
  rw [bin, bin, subst_node]
  congr 1
  funext i
  fin_cases i <;> rfl

/-- **A product is a shuffle tree** when its factors are, in the order of their least leaves. -/
lemma isShuffle_bin {e : AssShGen 2} {x y : STree AssShGen} :
    (bin e x y).IsShuffle ↔ x.IsShuffle ∧ y.IsShuffle ∧ x.first < y.first := by
  rw [bin, isShuffle_node, Fin.forall_fin_two]
  refine ⟨fun ⟨_, ⟨hx, hy⟩, hm⟩ => ⟨hx, hy, hm (show (0 : Fin 2) < 1 by decide)⟩,
    fun ⟨hx, hy, hxy⟩ => ⟨by norm_num, ⟨hx, hy⟩, Fin.strictMono_iff_lt_succ.2 fun i => ?_⟩⟩
  fin_cases i
  exact hxy

/-! ## Evaluation to words -/

/-- **The value of a generator on two words**: `x₁x₂` concatenates them, `x₂x₁` in the opposite
order. -/
def ap : AssShGen 2 → List ℕ → List ℕ → List ℕ
  | mu, u, w => u ++ w
  | op, u, w => w ++ u

/-- **The evaluation of a tree to a word**: the arrangement of its leaves computed by the
products. -/
def ev : STree AssShGen → List ℕ
  | leaf a => [a]
  | node mu c => ev (c 0) ++ ev (c 1)
  | node op c => ev (c 1) ++ ev (c 0)

@[simp] lemma ev_leaf (a : ℕ) : ev (leaf a) = [a] := rfl

@[simp] lemma ev_bin (e : AssShGen 2) (x y : STree AssShGen) :
    ev (bin e x y) = ap e (ev x) (ev y) := by
  cases e <;> rfl

lemma ev_node_congr {k : ℕ} (e : AssShGen k) {c c' : Fin k → STree AssShGen}
    (h : ∀ i, ev (c i) = ev (c' i)) : ev (node e c) = ev (node e c') := by
  cases e <;> simp only [ev, h]

/-- **The word of a tree arranges its leaves.** -/
theorem coe_ev : ∀ t : STree AssShGen, (ev t : Multiset ℕ) = t.labels
  | leaf a => rfl
  | node mu c => by
    rw [node_eq_bin, ev_bin, labels_bin, ap, ← Multiset.coe_add, coe_ev (c 0), coe_ev (c 1)]
  | node op c => by
    rw [node_eq_bin, ev_bin, labels_bin, ap, ← Multiset.coe_add, coe_ev (c 0), coe_ev (c 1),
      add_comm]

/-- **The word of a tree is not empty.** -/
theorem ev_ne_nil : ∀ t : STree AssShGen, ev t ≠ []
  | leaf _ => List.cons_ne_nil _ _
  | node mu c => by
    simp only [ev, ne_eq, List.append_eq_nil_iff, not_and]
    exact fun h => absurd h (ev_ne_nil (c 0))
  | node op c => by
    simp only [ev, ne_eq, List.append_eq_nil_iff, not_and]
    exact fun h => absurd h (ev_ne_nil (c 1))

/-- **Replacing a subtree by one with the same word keeps the word.** -/
theorem ev_replace : ∀ (T : STree AssShGen) (p : List ℕ) {u u' : STree AssShGen},
    ev u = ev u' → ev (T.replace p u) = ev (T.replace p u')
  | _, [], _, _, h => by rwa [replace_nil, replace_nil]
  | leaf _, _ :: _, _, _, _ => rfl
  | node e c, i :: p, _, _, h => by
    rw [replace_node_cons, replace_node_cons]
    refine ev_node_congr e fun j => ?_
    split_ifs
    · exact ev_replace (c j) p h
    · rfl

/-- **The word of a substituted tree**: each leaf replaced by the word of its input. -/
theorem ev_subst : ∀ (t : STree AssShGen) (xs : ℕ → STree AssShGen),
    ev (t.subst xs) = (ev t).flatMap fun a => ev (xs a)
  | leaf a, xs => by simp
  | node mu c, xs => by
    rw [subst_node]
    simp only [ev, List.flatMap_append, ev_subst (c 0), ev_subst (c 1)]
  | node op c, xs => by
    rw [subst_node]
    simp only [ev, List.flatMap_append, ev_subst (c 0), ev_subst (c 1)]

/-- **Contexts respect the words**: two monomials with the same word have images with the same
word. -/
theorem ev_ctx {A B : Finset ℕ} {f : SMono AssShGen A → SMono AssShGen B} (hf : IsSCtx f)
    {g h : SMono AssShGen A} (hgh : ev g.1 = ev h.1) : ev (f g).1 = ev (f h).1 := by
  obtain ⟨T, p, xs, -, -, hfe⟩ := hf
  rw [hfe, hfe]
  exact ev_replace T p (by rw [ev_subst, ev_subst, hgh])

/-! ## The rules -/

/-- **The leaves in arity three.** -/
abbrev three : Finset ℕ := {0, 1, 2}

/-- **The left comb** `e(f(0, 1), 2)`. -/
def lcomb (e f : AssShGen 2) : SMono AssShGen three :=
  ⟨bin e (bin f (leaf 0) (leaf 1)) (leaf 2), by simp [isShuffle_bin],
    by rw [labels_bin, labels_bin]; decide⟩

/-- **The twisted left comb** `e(f(0, 2), 1)`. -/
def tcomb (e f : AssShGen 2) : SMono AssShGen three :=
  ⟨bin e (bin f (leaf 0) (leaf 2)) (leaf 1), by simp [isShuffle_bin],
    by rw [labels_bin, labels_bin]; decide⟩

/-- **The right comb** `e(0, f(1, 2))`. -/
def rcomb (e f : AssShGen 2) : SMono AssShGen three :=
  ⟨bin e (leaf 0) (bin f (leaf 1) (leaf 2)), by simp [isShuffle_bin],
    by rw [labels_bin, labels_bin]; decide⟩

/-- **The letters of the path words**: the input taken through `x₁x₂`, or two more through
`x₂x₁`. -/
def letter : ∀ k, AssShGen k → ℕ → ℕ
  | _, mu, i => i
  | _, op, i => 2 + i

/-- **The path-lexicographic order** on the shuffle monomials of `AssShGen`. -/
def order : AdmOrder AssShGen := pathLexOrder letter

lemma word_lcomb (e f : AssShGen 2) :
    word letter (lcomb e f).1 0 = [letter 2 e 0, letter 2 f 0] := by
  rw [word, pos_eq (lcomb e f).nodup (q := [0, 0]) rfl]
  rfl

lemma word_tcomb (e f : AssShGen 2) :
    word letter (tcomb e f).1 0 = [letter 2 e 0, letter 2 f 0] := by
  rw [word, pos_eq (tcomb e f).nodup (q := [0, 0]) rfl]
  rfl

lemma word_rcomb (e f : AssShGen 2) : word letter (rcomb e f).1 0 = [letter 2 e 0] := by
  rw [word, pos_eq (rcomb e f).nodup (q := [0]) rfl]
  rfl

/-- Two monomials of arity three compare as the words of their leaf `0`, when these differ. -/
lemma pathLex_of_word {x y : SMono AssShGen three}
    (h : DegLex (word letter x.1 0) (word letter y.1 0)) : pathLex letter x y :=
  ⟨⟨0, by simp⟩, fun j hj => (Nat.not_lt_zero _ hj).elim, h⟩

/-- **The rules**: the left combs `e(f(0, 1), 2)` (`true`) and `e(f(0, 2), 1)` (`false`) with
`(e, f) ≠ (x₁x₂, x₂x₁)`. -/
abbrev Rule : Type := {ef : AssShGen 2 × AssShGen 2 // ef ≠ (mu, op)} × Bool

/-- **The leading monomial of a rule.** -/
def leadOf (e f : AssShGen 2) : Bool → SMono AssShGen three
  | true => lcomb e f
  | false => tcomb e f

/-- **The monomial with the same word as a leading monomial**, smaller than it. -/
def tailOf : AssShGen 2 → AssShGen 2 → Bool → SMono AssShGen three
  | mu, mu, true => rcomb mu mu
  | mu, mu, false => rcomb mu op
  | op, op, true => rcomb op op
  | op, op, false => rcomb op mu
  | op, mu, true => tcomb mu op
  | op, mu, false => lcomb mu op
  | mu, op, _ => rcomb mu mu

/-- **A leading monomial and its tail have the same word.** -/
lemma ev_leadOf_eq {e f : AssShGen 2} (hef : (e, f) ≠ (mu, op)) (s : Bool) :
    ev (leadOf e f s).1 = ev (tailOf e f s).1 := by
  cases e <;> cases f <;> cases s <;> first | rfl | exact absurd rfl hef

/-- **The tail is smaller than the leading monomial.** -/
lemma tailOf_lt {e f : AssShGen 2} (hef : (e, f) ≠ (mu, op)) (s : Bool) :
    pathLex letter (tailOf e f s) (leadOf e f s) := by
  refine pathLex_of_word ?_
  cases e <;> cases f <;> cases s <;>
    simp only [tailOf, leadOf, word_lcomb, word_tcomb, word_rcomb]
  all_goals first
    | exact absurd rfl hef
    | exact Or.inl (by decide)
    | exact Or.inr ⟨rfl, List.Lex.rel (by decide)⟩

variable (K : Type*) [CommRing K]

/-- **The rules of the associative operad**: each left comb `e(f(-, -), -)` with
`(e, f) ≠ (x₁x₂, x₂x₁)` rewrites to the other monomial with the same word. -/
noncomputable def rules : Rules K Rule order.toCtxOrder where
  src _ := three
  lead r := leadOf r.1.1.1 r.1.1.2 r.2
  tail r := Finsupp.single (tailOf r.1.1.1 r.1.1.2 r.2) 1
  tail_lt r m hm := by
    rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hm)]
    exact tailOf_lt r.1.2 r.2

variable {K}

/-! ## Normal monomials -/

/-- **Three inputs**, for the leaves `0`, `1` and `2`. -/
def ins (x y z : STree AssShGen) : ℕ → STree AssShGen
  | 0 => x
  | 1 => y
  | _ => z

/-- Three inputs increasing with their least leaves. -/
lemma strictMonoOn_ins {x y z : STree AssShGen} (hxy : x.first < y.first)
    (hyz : y.first < z.first) :
    StrictMonoOn (fun a => (ins x y z a).first) ((three : Finset ℕ) : Set ℕ) := by
  intro a ha b hb hab
  simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
    Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl <;>
    first | omega | (simp only [ins]; omega)

/-- **In a normal monomial, a vertex whose first input is a vertex is `x₁x₂` above `x₂x₁`**:
otherwise the leading monomial `e(f(0, 1), 2)` or `e(f(0, 2), 1)` occurs there, as the least
leaf of the second input of the inner vertex is smaller or larger than that of the second input
of the outer one. -/
theorem eq_of_get? {A : Finset ℕ} (t : SMono AssShGen A) {p : List ℕ} {e f : AssShGen 2}
    {x y z : STree AssShGen} (hp : t.1.get? p = some (bin e (bin f x y) z))
    (hN : (rules K).Normal t) : e = mu ∧ f = op := by
  by_contra hne'
  have hne : (e, f) ≠ (mu, op) := fun h => hne' (Prod.mk.inj h)
  have hu := isShuffle_get? t.isShuffle hp
  have hn : (bin e (bin f x y) z).labels.Nodup := Multiset.nodup_of_le (labels_get?_le hp) t.nodup
  rw [isShuffle_bin, isShuffle_bin, first_bin] at hu
  obtain ⟨⟨hx, hy, hxy⟩, hz, hxz⟩ := hu
  rw [labels_bin, labels_bin, Multiset.nodup_add] at hn
  have hyz : y.first ≠ z.first := fun h => Multiset.disjoint_left.1 hn.2.2
    (Multiset.mem_add.2 (Or.inr (first_mem hy))) (h ▸ first_mem hz)
  rcases lt_or_gt_of_ne hyz with h | h
  · have hU : t.1.get? p = some (((rules K).lead (⟨(e, f), hne⟩, true)).1.subst (ins x y z)) := by
      rw [hp]
      show _ = some ((bin e (bin f (leaf 0) (leaf 1)) (leaf 2)).subst _)
      rw [subst_bin, subst_bin]
      rfl
    exact hN _ _ (isSCtx_ctxOf t p _ _ hU (strictMonoOn_ins hxy h))
      (ctxOf_self t p _ _ hU (strictMonoOn_ins hxy h))
  · have hU : t.1.get? p = some (((rules K).lead (⟨(e, f), hne⟩, false)).1.subst (ins x z y)) := by
      rw [hp]
      show _ = some ((bin e (bin f (leaf 0) (leaf 2)) (leaf 1)).subst _)
      rw [subst_bin, subst_bin]
      rfl
    exact hN _ _ (isSCtx_ctxOf t p _ _ hU (strictMonoOn_ins hxz h))
      (ctxOf_self t p _ _ hU (strictMonoOn_ins hxz h))

/-- **The shape of the normal monomials**: every vertex whose first input is a vertex is `x₁x₂`
above `x₂x₁`. -/
def Good (t : STree AssShGen) : Prop :=
  ∀ (p : List ℕ) (e f : AssShGen 2) (x y z : STree AssShGen),
    t.get? p = some (bin e (bin f x y) z) → e = mu ∧ f = op

/-- **Normal monomials have the shape.** -/
lemma good_of_normal {A : Finset ℕ} {t : SMono AssShGen A} (h : (rules K).Normal t) : Good t.1 :=
  fun _ _ _ _ _ _ hp => eq_of_get? t hp h

lemma Good.left {e : AssShGen 2} {x y : STree AssShGen} (h : Good (bin e x y)) : Good x :=
  fun p e' f' a b c hp => h (0 :: p) e' f' a b c ((get?_node_cons_fin e ![x, y] 0 p).trans hp)

lemma Good.right {e : AssShGen 2} {x y : STree AssShGen} (h : Good (bin e x y)) : Good y :=
  fun p e' f' a b c hp => h (1 :: p) e' f' a b c ((get?_node_cons_fin e ![x, y] 1 p).trans hp)

lemma Good.root {e f : AssShGen 2} {x y z : STree AssShGen} (h : Good (bin e (bin f x y) z)) :
    e = mu ∧ f = op :=
  h [] e f x y z rfl

/-- **The word of a monomial of the shape, split at its least leaf**: the least leaf comes first
under `x₁x₂(a, -)`, last under `x₂x₁(a, -)`, and between the words of the two other inputs under
`x₁x₂(x₂x₁(a, -), -)`. -/
theorem exists_split {e : AssShGen 2} {l r : STree AssShGen} (hg : Good (bin e l r)) :
    ∃ A B, ev (bin e l r) = A ++ l.first :: B ∧
      (e = mu ∧ l = leaf l.first ∧ A = [] ∧ B = ev r ∨
        e = op ∧ l = leaf l.first ∧ A = ev r ∧ B = [] ∨
        e = mu ∧ ev l = A ++ [l.first] ∧ A ≠ [] ∧ B = ev r) := by
  cases l with
  | leaf a =>
    cases e
    · exact ⟨[], ev r, rfl, Or.inl ⟨rfl, rfl, rfl, rfl⟩⟩
    · exact ⟨ev r, [], by simp [ap], Or.inr (Or.inl ⟨rfl, rfl, rfl, rfl⟩)⟩
  | node g d =>
    cases g
    · rw [node_eq_bin] at hg
      exact absurd hg.root.2 (fun h => by cases h)
    · rw [node_eq_bin] at hg ⊢
      obtain ⟨rfl, -⟩ := hg.root
      cases h0 : d 0 with
      | leaf a =>
        refine ⟨ev (d 1), ev r, ?_, Or.inr (Or.inr ⟨rfl, ?_, ev_ne_nil _, rfl⟩)⟩
        · simp [ap]
        · simp [ap]
      | node g d' =>
        exfalso
        have hl := hg.left
        rw [h0] at hl
        cases g
        · rw [node_eq_bin] at hl
          exact absurd hl.root.1 (fun h => by cases h)
        · rw [node_eq_bin] at hl
          exact absurd hl.root.1 (fun h => by cases h)

/-- A vertex does not have the word of a leaf. -/
lemma ev_node_ne {k : ℕ} (e : AssShGen k) (c : Fin k → STree AssShGen) (a : ℕ) :
    ev (node e c) ≠ [a] := by
  cases e <;> intro h <;> have h' := congrArg List.length h <;>
    have h0 := List.length_pos_iff.2 (ev_ne_nil (c 0)) <;>
    have h1 := List.length_pos_iff.2 (ev_ne_nil (c 1)) <;>
    simp only [ev, List.length_append, List.length_singleton] at h' <;> omega

/-- **The step of the injectivity**: two products of the shape with the same word are equal when
their factors are determined by their words. -/
theorem ev_inj_bin {e e' : AssShGen 2} {l r l' r' : STree AssShGen}
    (ihl : ∀ {y : STree AssShGen}, l.IsShuffle → y.IsShuffle → l.labels.Nodup →
      y.labels.Nodup → Good l → Good y → ev l = ev y → l = y)
    (ihr : ∀ {y : STree AssShGen}, r.IsShuffle → y.IsShuffle → r.labels.Nodup →
      y.labels.Nodup → Good r → Good y → ev r = ev y → r = y)
    (hs : (bin e l r).IsShuffle) (hs' : (bin e' l' r').IsShuffle)
    (hn : (bin e l r).labels.Nodup) (hn' : (bin e' l' r').labels.Nodup)
    (hg : Good (bin e l r)) (hg' : Good (bin e' l' r'))
    (h : ev (bin e l r) = ev (bin e' l' r')) : bin e l r = bin e' l' r' := by
  have hm : l.first = l'.first := by
    have := first_eq_of_labels_eq hs hs' (by rw [← coe_ev, ← coe_ev, h])
    simpa using this
  obtain ⟨hl, hr, -⟩ := isShuffle_bin.1 hs
  obtain ⟨hl', hr', -⟩ := isShuffle_bin.1 hs'
  have hnd : (ev (bin e l r)).Nodup := by rw [← Multiset.coe_nodup, coe_ev]; exact hn
  rw [labels_bin, Multiset.nodup_add] at hn hn'
  obtain ⟨A, B, hA, hx⟩ := exists_split hg
  obtain ⟨A', B', hA', hy⟩ := exists_split hg'
  rw [hA, List.nodup_middle, List.nodup_cons, List.mem_append, not_or, hm] at hnd
  obtain ⟨rfl, -, rfl⟩ :=
    (List.append_cons_inj_of_notMem hnd.1.1 hnd.1.2).1 (hA.symm.trans (h.trans hA'))
  have hR : ∀ {y : STree AssShGen}, (bin e' y r').IsShuffle → ev r = ev r' → r = r' :=
    fun hy hrr => ihr hr (isShuffle_bin.1 hy).2.1 hn.2.1 hn'.2.1 hg.right hg'.right hrr
  rcases hx with ⟨rfl, hl1, rfl, rfl⟩ | ⟨rfl, hl1, rfl, rfl⟩ | ⟨rfl, hl1, hA0, rfl⟩ <;>
    rcases hy with ⟨rfl, hl1', hA0', hB'⟩ | ⟨rfl, hl1', hA0', hB'⟩ | ⟨rfl, hl1', hA0', hB'⟩
  · rw [hR hs' hB', hl1, hl1', hm]
  · exact absurd hA0'.symm (ev_ne_nil r')
  · exact absurd rfl hA0'
  · exact absurd hA0' (ev_ne_nil r)
  · rw [hR hs' hA0', hl1, hl1', hm]
  · exact absurd hB'.symm (ev_ne_nil r')
  · exact absurd hA0' hA0
  · exact absurd hB' (ev_ne_nil r)
  · rw [hR hs' hB', ihl hl hl' hn.1 hn'.1 hg.left hg'.left (by rw [hl1, hl1', hm])]

/-- **A monomial of the shape is determined by its word.** -/
theorem ev_inj (x : STree AssShGen) : ∀ {y : STree AssShGen}, x.IsShuffle → y.IsShuffle →
    x.labels.Nodup → y.labels.Nodup → Good x → Good y → ev x = ev y → x = y := by
  induction x with
  | leaf a =>
    intro y _ _ _ _ _ _ h
    cases y with
    | leaf b =>
      rw [ev_leaf, ev_leaf, List.singleton_inj] at h
      rw [h]
    | node e c => exact absurd h.symm (ev_node_ne e c a)
  | node e c ih =>
    intro y hs hs' hn hn' hg hg' h
    cases y with
    | leaf b => exact absurd h (ev_node_ne e c b)
    | node e' c' =>
      cases e <;> cases e' <;> rw [node_eq_bin] at hs hn hg h ⊢ <;>
        rw [node_eq_bin] at hs' hn' hg' h ⊢ <;>
        exact ev_inj_bin (ih 0) (ih 1) hs hs' hn hn' hg hg' h

/-! ## The Gröbner basis -/

variable (K) in
/-- **The evaluation to words**: every monomial to its word. -/
noncomputable def evL (A : Finset ℕ) : (SMono AssShGen A →₀ K) →ₗ[K] (List ℕ →₀ K) :=
  Finsupp.lmapDomain K K fun t => ev t.1

/-- **The evaluation vanishes on the ideal generated by the rules**: a relation is the
difference of two monomials with the same word, and contexts respect the words. -/
theorem ideal_le_ker (A : Finset ℕ) :
    ((rules K).rw A).ideal ≤ LinearMap.ker (evL K A) := by
  rw [Rules.ideal_eq_span]
  refine Submodule.span_le.2 ?_
  rintro _ ⟨r, f, hf, rfl⟩
  have ht : (rules K).tail r = Finsupp.single (tailOf r.1.1.1 r.1.1.2 r.2) 1 := rfl
  rw [SetLike.mem_coe, LinearMap.mem_ker, evL, Finsupp.lmapDomain_apply,
    ← Finsupp.mapDomain_comp, Finsupp.mapDomain_sub, Finsupp.mapDomain_single, ht]
  erw [Finsupp.mapDomain_single]
  rw [sub_eq_zero, Function.comp_apply, Function.comp_apply]
  exact congrArg (Finsupp.single · 1) (ev_ctx hf (ev_leadOf_eq r.1.2 r.2))

/-- **The evaluation is injective on the normal monomials.** -/
theorem eq_zero_of_evL {A : Finset ℕ} {v : SMono AssShGen A →₀ K}
    (hv : v ∈ Finsupp.supported K K {t : SMono AssShGen A | (rules K).Normal t})
    (h0 : evL K A v = 0) : v = 0 := by
  have hs := (Finsupp.mem_supported K v).1 hv
  have hinj : Set.InjOn (fun t : SMono AssShGen A => ev t.1) {t | (rules K).Normal t} :=
    fun s hs' t ht h => Subtype.ext (ev_inj s.1 s.isShuffle t.isShuffle s.nodup t.nodup
      (good_of_normal hs') (good_of_normal ht) h)
  ext m
  by_cases hm : (rules K).Normal m
  · rw [Finsupp.zero_apply, ← Finsupp.mapDomain_apply' _ v hs hinj hm]
    exact congrArg (· (ev m.1)) h0
  · exact Finsupp.notMem_support_iff.1 fun h => hm (hs h)

/-- **The normal monomials are independent modulo the ideal generated by the rules**: the
evaluation to words vanishes on the ideal and is injective on the normal monomials. -/
theorem disjoint_normal (A : Finset ℕ) :
    Disjoint (Finsupp.supported K K {t : SMono AssShGen A | (rules K).Normal t})
      ((rules K).rw A).ideal := by
  rw [Submodule.disjoint_def]
  exact fun v hv hI => eq_zero_of_evL hv (ideal_le_ker A hI)

/-- **Every ambiguity of the rules is resolvable**, the critical ones in particular. -/
theorem res_amb {C : Finset ℕ} {r₁ r₂ : Rule} (B : (rules K).Amb C r₁ r₂) : B.Res :=
  B.res_of_isCompl (disjoint_normal C)

/-! ## PBW and Koszul -/

/-- **The leading monomials are quadratic.** -/
lemma weight_lead (r : Rule) : ((rules K).lead r).1.weight = 2 := by
  obtain ⟨⟨⟨e, f⟩, -⟩, s⟩ := r
  cases s <;> rfl

/-- **The tails are quadratic.** -/
lemma weight_tail (r : Rule) : ∀ m ∈ ((rules K).tail r).support, m.1.weight = 2 := fun m hm => by
  rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hm)]
  obtain ⟨⟨⟨e, f⟩, -⟩, s⟩ := r
  cases e <;> cases f <;> cases s <;> rfl

/-- **The associative operad is Koszul**: its rules are a quadratic Gröbner basis for the
path-lexicographic order. -/
theorem isKoszul : (rules K).IsKoszul :=
  (rules K).isKoszul_of_critical weight_lead weight_tail fun B _ => res_amb B

/-- **The PBW basis of the associative operad**: on every set of leaves, the normal monomials
are a basis of the quotient by the ideal generated by the rules. -/
noncomputable def basis (A : Finset ℕ) :
    Module.Basis ((rules K).rw A).Irr K ((SMono AssShGen A →₀ K) ⧸ ((rules K).rw A).ideal) :=
  STree.basisOfCritical (rules K) ((rules K).hlead_of_quad weight_lead) (fun B _ => res_amb B) A

/-- **The rules present the operad of words**: on every set of leaves, the ideal generated by
the rules is the kernel of the evaluation to words. -/
theorem ideal_eq_ker (A : Finset ℕ) : ((rules K).rw A).ideal = LinearMap.ker (evL K A) := by
  refine le_antisymm (ideal_le_ker A) fun v hv => ?_
  have hc := STree.isCompl_of_critical (rules K) ((rules K).hlead_of_quad weight_lead)
    (fun B _ => res_amb B) A
  have hv' : v ∈ Finsupp.supported K K {t : SMono AssShGen A | (rules K).Normal t} ⊔
      ((rules K).rw A).ideal := by
    rw [hc.sup_eq_top]
    exact Submodule.mem_top
  obtain ⟨n, hn, i, hi, rfl⟩ := Submodule.mem_sup.1 hv'
  rw [LinearMap.mem_ker, map_add, LinearMap.mem_ker.1 (ideal_le_ker A hi), add_zero] at hv
  rw [eq_zero_of_evL hn hv, zero_add]
  exact hi

/-! ## Every arrangement is a word -/

/-- **Every arrangement of distinct leaves is the word of a shuffle tree**: split it at its
least leaf `m`, and take `x₁x₂(m, -)`, `x₂x₁(m, -)` or `x₁x₂(x₂x₁(m, -), -)` on the trees of the
two sides. -/
theorem exists_ev : ∀ (n : ℕ) (w : List ℕ), w.length ≤ n → w ≠ [] → w.Nodup →
    ∃ t : STree AssShGen, t.IsShuffle ∧ ev t = w
  | 0, w, hl, hw, _ => absurd (List.length_eq_zero_iff.1 (Nat.le_zero.1 hl)) hw
  | n + 1, w, hl, hw, hnd => by
    have hne : w.toFinset.Nonempty := ⟨_, List.mem_toFinset.2 (List.head_mem hw)⟩
    obtain ⟨m, hm, hmin⟩ : ∃ m ∈ w, ∀ a ∈ w, m ≤ a :=
      ⟨_, List.mem_toFinset.1 (w.toFinset.min'_mem hne),
        fun a ha => w.toFinset.min'_le a (List.mem_toFinset.2 ha)⟩
    obtain ⟨P, Q, rfl⟩ := List.append_of_mem hm
    rw [List.nodup_middle, List.nodup_cons, List.mem_append, not_or] at hnd
    obtain ⟨⟨hmP, hmQ⟩, hPQ⟩ := hnd
    have hlt : ∀ a ∈ P ++ Q, m < a := fun a ha => lt_of_le_of_ne
      (hmin a (List.mem_append.2 ((List.mem_append.1 ha).imp id (List.mem_cons_of_mem m))))
      fun h => by
        rcases List.mem_append.1 ha with ha | ha
        · exact hmP (h ▸ ha)
        · exact hmQ (h ▸ ha)
    simp only [List.length_append, List.length_cons] at hl
    have key : ∀ u : List ℕ, u.length ≤ n → u ≠ [] → u.Nodup → (∀ a ∈ u, m < a) →
        ∃ t : STree AssShGen, t.IsShuffle ∧ ev t = u ∧ m < t.first := fun u hu hu' hun hum => by
      obtain ⟨t, hts, hte⟩ := exists_ev n u hu hu' hun
      refine ⟨t, hts, hte, hum _ ?_⟩
      rw [← Multiset.mem_coe, ← hte, coe_ev]
      exact first_mem hts
    have hP := (List.nodup_append.1 hPQ).1
    have hQ := (List.nodup_append.1 hPQ).2.1
    have hltP : ∀ a ∈ P, m < a := fun a ha => hlt a (List.mem_append_left Q ha)
    have hltQ : ∀ a ∈ Q, m < a := fun a ha => hlt a (List.mem_append_right P ha)
    rcases eq_or_ne P [] with rfl | hP0 <;> rcases eq_or_ne Q [] with rfl | hQ0
    · exact ⟨leaf m, trivial, rfl⟩
    · obtain ⟨tQ, hsQ, heQ, hfQ⟩ := key Q (by simp at hl; omega) hQ0 hQ hltQ
      exact ⟨bin mu (leaf m) tQ, isShuffle_bin.2 ⟨trivial, hsQ, hfQ⟩, by simp [ap, heQ]⟩
    · obtain ⟨tP, hsP, heP, hfP⟩ := key P (by simp at hl; omega) hP0 hP hltP
      exact ⟨bin op (leaf m) tP, isShuffle_bin.2 ⟨trivial, hsP, hfP⟩, by simp [ap, heP]⟩
    · obtain ⟨tP, hsP, heP, hfP⟩ := key P (by omega) hP0 hP hltP
      obtain ⟨tQ, hsQ, heQ, hfQ⟩ := key Q (by omega) hQ0 hQ hltQ
      refine ⟨bin mu (bin op (leaf m) tP) tQ,
        isShuffle_bin.2 ⟨isShuffle_bin.2 ⟨trivial, hsP, hfP⟩, hsQ, by simpa using hfQ⟩, ?_⟩
      simp [ap, heP, heQ]

/-- **The arrangements of a finite set**: the lists of its elements, each once. -/
noncomputable def arr (A : Finset ℕ) : Finset (List ℕ) := A.toList.permutations.toFinset

lemma mem_arr {A : Finset ℕ} {w : List ℕ} : w ∈ arr A ↔ (w : Multiset ℕ) = A.val := by
  rw [arr, List.mem_toFinset, List.mem_permutations, ← Multiset.coe_eq_coe, Finset.coe_toList]

/-- **There are `|A|!` arrangements of `A`.** -/
lemma card_arr (A : Finset ℕ) : (arr A).card = A.card.factorial := by
  rw [arr, List.toFinset_card_of_nodup (List.nodup_permutations _ A.nodup_toList),
    List.length_permutations, Finset.length_toList]

/-- **The words of the monomials on a nonempty set `A` are its arrangements.** -/
theorem range_evL {A : Finset ℕ} (hA : A.Nonempty) :
    LinearMap.range (evL K A) = Finsupp.supported K K (arr A : Set (List ℕ)) := by
  rw [LinearMap.range_eq_map, ← Finsupp.supported_univ, evL, Finsupp.lmapDomain_supported,
    Set.image_univ]
  congr 1
  ext w
  constructor
  · rintro ⟨t, rfl⟩
    exact mem_arr.2 (by rw [coe_ev, t.labels_eq])
  · intro hw
    have hw' := mem_arr.1 (Finset.mem_coe.1 hw)
    have hnd : w.Nodup := by rw [← Multiset.coe_nodup, hw']; exact A.nodup
    have hne : w ≠ [] := by
      rintro rfl
      exact hA.ne_empty (Finset.val_eq_zero.1 hw'.symm)
    obtain ⟨t, hs, he⟩ := exists_ev w.length w le_rfl hne hnd
    exact ⟨⟨t, hs, by rw [← coe_ev, he, hw']⟩, he⟩

/-- **The associative operad has dimension `n!` in arity `n`**: on a nonempty set `A` of leaves,
the quotient by the ideal generated by the rules is the span of the arrangements of `A`. -/
theorem finrank_eq_factorial [Nontrivial K] {A : Finset ℕ} (hA : A.Nonempty) :
    Module.finrank K ((SMono AssShGen A →₀ K) ⧸ ((rules K).rw A).ideal) = A.card.factorial := by
  have e := (Submodule.quotEquivOfEq _ _ (ideal_eq_ker A)).trans
    (LinearMap.quotKerEquivRange (evL K A))
  rw [e.finrank_eq, range_evL hA, (Finsupp.supportedEquivFinsupp _).finrank_eq,
    Module.finrank_finsupp_self]
  simp [card_arr]

end AssShGen

end Operad
