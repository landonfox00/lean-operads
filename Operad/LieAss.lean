/-
# The Lie operad inside the associative operad

The commutator morphism `Lie → Ass` is injective, so `Lie` is the suboperad of the associative
operad generated by the commutator. `Ass` is `Lin R AssSet`, the operad of associative algebras
without unit; `Lie.toSymAss` is the composite with `Sym.Ass`.

* **Morphisms out of `Lie`** (`Lie.homOfBracket`): an operation of arity two of an operad `Q`
  which acts on every `Q`-algebra as an antisymmetric bracket with the Jacobi identity defines a
  morphism `Lie → Q`. The relations hold in `Q` because free algebras are faithful
  (`SymAlgebra.eq_zero_of_forall`).
* **The commutator morphism** (`Lie.toAss`): the bracket goes to `x₀ x₁ - x₁ x₀`
  (`Ass.commutator`, `Lie.toAss_bracket`), which acts on an associative algebra as its
  commutator (`Ass.app_commutator`), a Lie bracket (`AssAlg.jacobi`).
* **It is injective in every arity**, over a field in which `2` is invertible
  (`Lie.toAss_injective`, `Lie.toSymAss_injective`). An operation `x` of arity `n` killed by it
  acts by zero on the enveloping algebra of the free `Lie`-algebra `L` on `n` generators, with
  its commutator. The map `L → U(L)` is a morphism of `Lie`-algebras, and it is injective by the
  Poincaré–Birkhoff–Witt theorem (`UniversalEnvelopingAlgebra.ι_injective_of_free`), so `x`
  vanishes on the generators of `L`; and an operation is read off its action on the generators
  of the free algebra (`Schur.read_act`).
* **The image is the suboperad generated by the commutator**: it contains the commutator
  (`Lie.commutator_mem_range`), and every suboperad containing the commutator contains it
  (`Lie.range_toAss_le`). An injective morphism is an isomorphism onto its image
  (`SymOperadHom.isoRange`), so `Lie` is that suboperad (`Lie.isoCommutator`).

The dimension `(n - 1)!` of `Lie` in arity `n` is not proved here.
-/
import Operad.LieFree
import Operad.FaithfulAlgebra
import Operad.PBW
import Operad.Algebras
import Operad.DerivationAlong
import Operad.ShuffleIsoComAss
import Operad.SymSuboperad
import Operad.SymIso
import Mathlib.LinearAlgebra.Basis.VectorSpace

universe u v w

namespace Operad

open Sym

/-! ## Morphisms out of `Lie` -/

section Hom

variable {R : Type u} [CommRing R]
  {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (Q A)] [SymOperad R Q]

/-- The generator values given by one operation of arity two. -/
def unitVal (c : Q (Fin 2)) : ∀ n, BinGen Unit n → Q (Fin n)
  | _, .op _ => c

/-- An algebra restricted along the morphism of generator values is the algebra of the binary
operation by which the generator acts. -/
lemma comp_linHom_unitVal (c : Q (Fin 2)) {V : Type v} [AddCommGroup V] [Module R V]
    (α : SymAlgebra R Q V) :
    α.comp (FreeSet.linHom R (unitVal c)) = binHom fun _ : Unit => α.app (Fin 2) c := by
  rw [← freeBinEquiv_symm, Equiv.eq_symm_apply]
  funext g
  show α.app (Fin 2) ((FreeSet.linHom R (unitVal c)).app (Fin 2)
    (Finsupp.single (Pres.gen (BinGen.op g)) 1)) = _
  rw [FreeSet.linHom_gen]
  rfl

/-- **A morphism out of the Lie operad**: an operation of arity two which acts on every algebra
as an antisymmetric bracket with the Jacobi identity. -/
noncomputable def Lie.homOfBracket (c : Q (Fin 2))
    (hanti : ∀ (V : Type (max u w)) [AddCommGroup V] [Module R V] (α : SymAlgebra R Q V)
      (x y : V), α.app (Fin 2) c ![x, y] = -α.app (Fin 2) c ![y, x])
    (hjac : ∀ (V : Type (max u w)) [AddCommGroup V] [Module R V] (α : SymAlgebra R Q V)
      (x y z : V), α.app (Fin 2) c ![α.app (Fin 2) c ![x, y], z]
        + α.app (Fin 2) c ![α.app (Fin 2) c ![y, z], x]
        + α.app (Fin 2) c ![α.app (Fin 2) c ![z, x], y] = 0) :
    SymOperadHom R (Lie R) Q :=
  SymOperadIdeal.presHomEquiv.symm ⟨FreeSet.linHom R (unitVal c), forall_rel23.2
    ⟨fun x hx => by
        obtain rfl := Set.mem_singleton_iff.1 hx
        refine SymAlgebra.eq_zero_of_forall (R := R) _ fun V _ _ α => ?_
        have h := (BinRel.antisymm_iff (fun _ : Unit => α.app (Fin 2) c) ()).2 (hanti V α)
        rw [← comp_linHom_unitVal] at h
        exact h,
      fun x hx => by
        obtain rfl := Set.mem_singleton_iff.1 hx
        refine SymAlgebra.eq_zero_of_forall (R := R) _ fun V _ _ α => ?_
        have h := (BinRel.jacobi_iff (fun _ : Unit => α.app (Fin 2) c) ()).2 (hjac V α)
        rw [← comp_linHom_unitVal] at h
        exact h⟩⟩

/-- The morphism sends the bracket to the operation. -/
lemma Lie.homOfBracket_bracket (c : Q (Fin 2)) (hanti) (hjac) :
    (Lie.homOfBracket (R := R) c hanti hjac).app (Fin 2) (Lie.bracket R) = c := by
  show (FreeSet.linHom R (unitVal c)).app (Fin 2) (Finsupp.single (Pres.gen (BinGen.op ())) 1) = _
  rw [FreeSet.linHom_gen]
  rfl

end Hom

/-! ## The commutator in the associative operad -/

section Commutator

variable (R : Type u) [CommRing R]

/-- **The product of the associative operad.** -/
noncomputable def Ass.mul : Lin R AssSet (Fin 2) :=
  (Ass.homEquiv R (SymOperadHom.id : SymOperadHom R (Lin R AssSet) (Lin R AssSet))).m

/-- **The commutator** `x₀ x₁ - x₁ x₀` of the associative operad. -/
noncomputable def Ass.commutator : Lin R AssSet (Fin 2) :=
  Ass.mul R - SymOperad.map (R := R) (Equiv.swap (0 : Fin 2) 1) (Ass.mul R)

variable {R} {V : Type v} [AddCommGroup V] [Module R V]

/-- The product of the operad acts as the product of the algebra. -/
lemma Ass.app_mul (α : SymAlgebra R (Lin R AssSet) V) :
    α.app (Fin 2) (Ass.mul R) = (Ass.algebraEquiv α).mul := rfl

/-- The commutator of the operad acts as the commutator of the algebra. -/
lemma Ass.app_commutator (α : SymAlgebra R (Lin R AssSet) V) (x y : V) :
    α.app (Fin 2) (Ass.commutator R) ![x, y] =
      (Ass.algebraEquiv α).mul ![x, y] - (Ass.algebraEquiv α).mul ![y, x] := by
  rw [Ass.commutator, map_sub, MultilinearMap.sub_apply, α.app_map, Ass.app_mul]
  congr 1
  show (Ass.algebraEquiv α).mul (fun a => ![x, y] (Equiv.swap (0 : Fin 2) 1 a)) = _
  rw [EndOp.vec_swap]

lemma EndOp.two_sub_left (F : EndOp R V (Fin 2)) (x x' y : V) :
    F ![x - x', y] = F ![x, y] - F ![x', y] := by
  have h := F.map_update_sub ![x, y] 0 x x'
  simp only [show ∀ t : V, Function.update ![x, y] 0 t = ![t, y] from fun t => by
    funext k
    fin_cases k <;> rfl] at h
  exact h

lemma EndOp.two_sub_right (F : EndOp R V (Fin 2)) (x y y' : V) :
    F ![x, y - y'] = F ![x, y] - F ![x, y'] := by
  have h := F.map_update_sub ![x, y] 1 y y'
  simp only [show ∀ t : V, Function.update ![x, y] 1 t = ![x, t] from fun t => by
    funext k
    fin_cases k <;> rfl] at h
  exact h

/-- **The commutator of an associative algebra satisfies the Jacobi identity.** -/
lemma AssAlg.jacobi (a : AssAlg R V) (x y z : V) :
    (a.mul ![a.mul ![x, y] - a.mul ![y, x], z] - a.mul ![z, a.mul ![x, y] - a.mul ![y, x]])
      + (a.mul ![a.mul ![y, z] - a.mul ![z, y], x] - a.mul ![x, a.mul ![y, z] - a.mul ![z, y]])
      + (a.mul ![a.mul ![z, x] - a.mul ![x, z], y] - a.mul ![y, a.mul ![z, x] - a.mul ![x, z]])
      = 0 := by
  simp only [EndOp.two_sub_left, EndOp.two_sub_right, a.assoc]
  abel

variable (R) in
/-- **The commutator morphism** from the Lie operad to the associative operad: the bracket to
`x₀ x₁ - x₁ x₀`. -/
noncomputable def Lie.toAss : SymOperadHom R (Lie R) (Lin R AssSet) :=
  Lie.homOfBracket (Ass.commutator R)
    (fun V _ _ α x y => by rw [Ass.app_commutator, Ass.app_commutator, neg_sub])
    (fun V _ _ α x y z => by
      simp only [Ass.app_commutator]
      exact AssAlg.jacobi _ x y z)

lemma Lie.toAss_bracket : (Lie.toAss R).app (Fin 2) (Lie.bracket R) = Ass.commutator R :=
  Lie.homOfBracket_bracket _ _ _

end Commutator

/-! ## Injectivity -/

section Injective

variable (K : Type u) [Field K] [Invertible (2 : K)]

/-- The product of an associative algebra, as a bilinear operation. -/
def mulML (U : Type v) [Ring U] [Algebra K U] : EndOp K U (Fin 2) :=
  MultilinearMap.mk' (fun v => v 0 * v 1)
    (fun v i x y => by fin_cases i <;> simp [add_mul, mul_add])
    (fun v i c x => by fin_cases i <;> simp)

/-- **The associative algebra structure of an algebra.** -/
def AssAlg.ofAlgebra (U : Type v) [Ring U] [Algebra K U] : AssAlg K U where
  mul := mulML K U
  assoc x y z := by
    show x * y * z = x * (y * z)
    exact mul_assoc x y z

/-- **The commutator morphism is injective on `Fin n`**: an operation `x` of `Lie` killed by it
acts by zero on the enveloping algebra of the free `Lie`-algebra on `n` generators, a
`Lie`-algebra through the commutator; that Lie algebra embeds in its enveloping algebra, so `x`
vanishes on the generators, and an operation is read off its action on them. -/
theorem Lie.toAss_injective_fin (n : ℕ) :
    Function.Injective ((Lie.toAss K).app (Fin n)) := by
  refine (injective_iff_map_eq_zero _).2 fun x hx => ?_
  let α : SymAlgebra K (Lin K AssSet)
      (UniversalEnvelopingAlgebra K (Schur K (Lie K) (Fin n → K))) :=
    Ass.algebraEquiv.symm (AssAlg.ofAlgebra K _)
  have hβ : ∀ p q : UniversalEnvelopingAlgebra K (Schur K (Lie K) (Fin n → K)),
      (Lie.algebraEquiv (α.comp (Lie.toAss K))).br p q = p * q - q * p := fun p q => by
    show α.app (Fin 2) ((Lie.toAss K).app (Fin 2) (Lie.bracket K)) ![p, q] = _
    rw [Lie.toAss_bracket, Ass.app_commutator, Equiv.apply_symm_apply]
    rfl
  let F : SymAlgebraHom (Schur.algebra K (Lie K) (Fin n → K)) (α.comp (Lie.toAss K)) :=
    (Lie.homEquiv _ _).symm
      ⟨(UniversalEnvelopingAlgebra.ι K : Schur K (Lie K) (Fin n → K) →ₗ⁅K⁆ _).toLinearMap,
        fun p q => by
          rw [hβ]
          exact ((UniversalEnvelopingAlgebra.ι K :
            Schur K (Lie K) (Fin n → K) →ₗ⁅K⁆ _).map_lie p q).trans (Ring.lie_def _ _)⟩
  have h0 : UniversalEnvelopingAlgebra.ι K
      (Schur.act x fun k => Schur.ι K (Lie K) (Fin n → K) (Pi.single k 1)) = 0 := by
    refine (F.map_act x fun k => Schur.ι K (Lie K) (Fin n → K) (Pi.single k 1)).trans ?_
    show α.app (Fin n) ((Lie.toAss K).app (Fin n) x) _ = 0
    rw [hx, map_zero]
    rfl
  have h1 := UniversalEnvelopingAlgebra.ι_injective_of_free K (Schur K (Lie K) (Fin n → K))
    (h0.trans (map_zero _).symm)
  rw [← Schur.read_act (R := K) n x, h1, map_zero]

/-- **The Lie operad is a suboperad of the associative operad**: the commutator morphism is
injective in every arity, over a field in which `2` is invertible. -/
theorem Lie.toAss_injective (A : Type) [Fintype A] [DecidableEq A] :
    Function.Injective ((Lie.toAss K).app A) := by
  intro x y h
  refine SymOperad.map_injective (R := K) (Fintype.equivFin A) (Lie.toAss_injective_fin K _ ?_)
  rw [(Lie.toAss K).app_map, (Lie.toAss K).app_map, h]

end Injective

/-! ## The suboperad generated by the commutator -/

section Range

variable {R : Type u} [CommRing R]
  {P : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (P A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (P A)] [SymOperad R P]
  {Q : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (Q A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (Q A)] [SymOperad R Q]

/-- **A morphism corestricted to its image.** -/
def SymOperadHom.rangeRestrict (f : SymOperadHom R P Q) : SymOperadHom R P f.range.Op where
  app A _ _ := (f.app A).rangeRestrict
  app_map e x := Subtype.ext (f.app_map e x)
  app_one := Subtype.ext f.app_one
  app_comp i x y := Subtype.ext (f.app_comp i x y)

lemma SymOperadHom.rangeRestrict_bijective (f : SymOperadHom R P Q)
    (hf : ∀ (A : Type) [Fintype A] [DecidableEq A], Function.Injective (f.app A))
    (A : Type) [Fintype A] [DecidableEq A] : Function.Bijective (f.rangeRestrict.app A) :=
  ⟨fun _ _ h => hf A (congrArg Subtype.val h), fun ⟨_, x, hx⟩ => ⟨x, Subtype.ext hx⟩⟩

/-- **An injective morphism is an isomorphism onto its image.** -/
noncomputable def SymOperadHom.isoRange (f : SymOperadHom R P Q)
    (hf : ∀ (A : Type) [Fintype A] [DecidableEq A], Function.Injective (f.app A)) :
    SymOperadIso R P f.range.Op :=
  SymOperadIso.ofBijective f.rangeRestrict fun A _ _ => f.rangeRestrict_bijective hf A

variable (R) in
/-- The commutator is in the image of the commutator morphism. -/
lemma Lie.commutator_mem_range : Ass.commutator R ∈ (Lie.toAss R).range.sub (Fin 2) :=
  ⟨Lie.bracket R, Lie.toAss_bracket⟩

/-- **The image of the commutator morphism is the suboperad generated by the commutator**: every
suboperad of the associative operad containing the commutator contains it. -/
theorem Lie.range_toAss_le (S : SymSuboperad R (Lin R AssSet))
    (h : Ass.commutator R ∈ S.sub (Fin 2)) (A : Type) [Fintype A] [DecidableEq A] :
    (Lie.toAss R).range.sub A ≤ S.sub A := by
  rintro _ ⟨x, rfl⟩
  refine (S.mem_comap (Lie.toAss R) x).1
    (SymSuboperad.mem_of_presGen (S.comap (Lie.toAss R)) (fun n g => ?_) x)
  cases g with
  | op u =>
    cases u
    show (Lie.toAss R).app (Fin 2) (Lie.bracket R) ∈ S.sub (Fin 2)
    rw [Lie.toAss_bracket]
    exact h

end Range

section Sub

variable (K : Type u) [Field K]

/-- **The commutator morphism into `Sym.Ass`.** -/
noncomputable def Lie.toSymAss : SymOperadHom K (Lie K) (Sym.Ass K) :=
  (AssShGen.toAss K).comp (Lie.toAss K)

variable [Invertible (2 : K)]

/-- **`Lie` is the suboperad of the associative operad generated by the commutator.** -/
noncomputable def Lie.isoCommutator : SymOperadIso K (Lie K) (Lie.toAss K).range.Op :=
  (Lie.toAss K).isoRange fun A _ _ => Lie.toAss_injective K A

/-- **The commutator morphism `Lie → Sym.Ass` is injective in every arity.** -/
theorem Lie.toSymAss_injective (A : Type) [Fintype A] [DecidableEq A] :
    Function.Injective ((Lie.toSymAss K).app A) := by
  rcases isEmpty_or_nonempty A with hA | hA
  · haveI : IsEmpty (AssSet A) := ⟨fun y => hA.elim y.2.down.some⟩
    haveI : Subsingleton (Lin K AssSet A) := inferInstanceAs (Subsingleton (AssSet A →₀ K))
    exact fun x y _ => Lie.toAss_injective K A (Subsingleton.elim _ _)
  · exact fun x y h => Lie.toAss_injective K A ((AssShGen.toAss_bijective K A).1 h)

end Sub

end Operad
