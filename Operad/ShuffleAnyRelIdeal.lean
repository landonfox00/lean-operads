/-
# The relator ideal of the free graded operad in shuffle coordinates, for generators of any arity

The any-arity version of the first half of `Operad.ShuffleRelIdeal`: the ideal generated by the
relators in the symmetric operad `T(E)` lies, in the coordinates of the shuffle trees, in the
ideal of the rules.

* **The basis on a set of leaves** (`labBasis`): the shuffle monomials with leaves `Y` are a
  basis of `T(E) (Lab Y)`, and a partial composition of two of them is the monomial of the
  grafted tree (`comp_labBasis`).
* **Grafting is a context** (`graftR`, `graftL`, `isSCtx_graftR`, `isSCtx_graftL`), and partial
  composition with a monomial is, in coordinates, the map of monomials induced by the graft
  (`repr_comp_graftR`, `repr_comp_graftL`).
* **The operations whose coordinates lie in the ideal of the rules, under every bijection of the
  inputs with a set of leaves, form an ideal of `T(E)`** (`relIdeal`).
* **The relators lie in it** (`span_le_relIdeal`), for relators stable under the symmetric groups
  whose coordinates lie in the ideal of the rules: a relabelling of a relator is an increasing
  relabelling after a permutation, and an increasing relabelling is a context. Hence
  `repr_mem_ideal_of_mem_span`: the coordinates of an operation of the ideal of the relators lie
  in the ideal of the rules.

The other inclusion and the bridge without hypothesis on the ideals are in
`Operad.ShuffleAnyCtxIdeal`.
-/
import Operad.ShuffleAnyBridge
import Operad.ShuffleRelIdeal

universe u

namespace Operad

open Function Sym GerBV GrComposite STree FreeGr Bar

namespace ShuffleAnySym

open ShuffleBarSym

/-! ## The basis on a set of leaves, and composites -/

section LabBasis

variable {K : Type u} [Field K] {E : (A : Type) → [Fintype A] → [DecidableEq A] → Type u}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (E A)] [GrSpecies K E]
  {T : ℕ → Type} [IsEmpty (T 0)]
  (c : ∀ k, Module.Basis (T k) K (E (Fin k)))
  (hc : ∀ k (β : T k), GrSpecies.par (R := K) false (c k β) = c k β)

/-- **The basis of `T(E) (Lab Y)`**: the shuffle monomials with leaves `Y`. -/
noncomputable abbrev labBasis (Y : Finset ℕ) :
    Module.Basis (SMono T Y) K (FreeGrL K E (Lab Y)) :=
  FreeGrL.shBasisLab c (p := fun _ _ => false) hc Y

omit [IsEmpty (T 0)] in
/-- **The grafted tree of a composite named by values is a shuffle monomial on its leaves.** -/
lemma subst_mem {Y₁ Y₂ Y : Finset ℕ} (t₁ : SMono T Y₁) (t₂ : SMono T Y₂)
    (i₁ : Lab Y₁) (hf : t₂.1.first = i₁.1) (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y)
    (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) :
    (t₁.1.subst (update STree.leaf i₁.1 t₂.1)).IsShuffle ∧
      (t₁.1.subst (update STree.leaf i₁.1 t₂.1)).labels = Y.val := by
  obtain ⟨hd, hY⟩ := svalEquiv_spec Ψ hΨ
  refine ⟨FreeGrL.isShuffle_subst_update t₁.2.1 t₂.2.1 hf, ?_⟩
  rw [FreeGrL.labels_subst_update t₁.2.2 t₂.2.2 i₁.2 hd, hY]

/-- **Composing basis vectors at the least leaf of the inner one**, the inputs named by values,
gives the basis vector of the grafted tree. -/
theorem comp_labBasis {Y₁ Y₂ Y : Finset ℕ} (t₁ : SMono T Y₁) (t₂ : SMono T Y₂)
    (i₁ : Lab Y₁) (hf : t₂.1.first = i₁.1) (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y)
    (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) (t : SMono T Y)
    (ht : t.1 = t₁.1.subst (update STree.leaf i₁.1 t₂.1)) :
    GrOperad.map (R := K) Ψ (GrOperad.comp (R := K) i₁ (labBasis c hc Y₁ t₁)
      (labBasis c hc Y₂ t₂)) = labBasis c hc Y t := by
  obtain ⟨hd, hY⟩ := svalEquiv_spec Ψ hΨ
  obtain ⟨m, hm⟩ := i₁
  let E' : Lab ((Y₁.erase m).disjUnion Y₂ hd) ≃ Without (Lab Y₁) ⟨m, hm⟩ ⊕ Lab Y₂ :=
    (Equiv.subtypeEquivRight fun x => by rw [hY]).trans Ψ.symm
  have hE : ∀ x, FreeGrL.sval (E' x) = x.1 := fun x => by
    rw [← hΨ]
    show (Ψ (Ψ.symm _)).1 = _
    rw [Equiv.apply_symm_apply]
    rfl
  rw [labBasis, FreeGrL.comp_shBasisLab c hc t₁ t₂ hm hf hd E' hE, vpar_false, Bool.false_and,
    σ_false, one_smul, ← GrOperad.map_trans, FreeGrL.shBasisLab_apply, FreeGrL.shBasisLab_apply]
  exact FreeGrL.map_shEv _ ht.symm hY _ _ _ fun x => by
    show (Ψ (Ψ.symm _)).1 = x.1
    rw [Equiv.apply_symm_apply]
    rfl

/-- **Elements are combinations of the basis vectors**, as a statement about a submodule. -/
lemma mem_of_basis {Y : Finset ℕ} (S : Submodule K (FreeGrL K E (Lab Y)))
    (h : ∀ t, labBasis c hc Y t ∈ S) (x : FreeGrL K E (Lab Y)) : x ∈ S := by
  have hle : Submodule.span K (Set.range (labBasis c hc Y)) ≤ S :=
    Submodule.span_le.2 (Set.range_subset_iff.2 h)
  rw [(labBasis c hc Y).span_eq] at hle
  exact hle Submodule.mem_top

omit [IsEmpty (T 0)] in
lemma first_eq_of_min {Y : Finset ℕ} (t : SMono T Y) {i : ℕ} (hi : i ∈ Y)
    (hmin : ∀ y ∈ Y, i ≤ y) : t.1.first = i := by
  refine le_antisymm (first_le t.2.1 i (by rw [t.2.2]; exact hi)) (hmin _ ?_)
  have := first_mem t.2.1
  rwa [t.2.2] at this

include c hc in
/-- The parity projections of `T(E)`, `E` even. -/
lemma par_labBasis {Y : Finset ℕ} (b : Bool) (x : FreeGrL K E (Lab Y)) :
    GrOperad.par (R := K) b x = if b then 0 else x := by
  have h0 : ∀ t, GrOperad.par (R := K) false (labBasis c hc Y t) = labBasis c hc Y t := fun t => by
    rw [labBasis, FreeGrL.shBasisLab_apply]
    have := FreeGrL.par_shEv c hc t.1 Y t.2.2
    rwa [vpar_false] at this
  have hfalse : GrOperad.par (R := K) (P := FreeGrL K E) (A := Lab Y) false = LinearMap.id :=
    (labBasis c hc Y).ext h0
  have htrue : GrOperad.par (R := K) (P := FreeGrL K E) (A := Lab Y) true = 0 :=
    (labBasis c hc Y).ext fun t => by
      rw [← h0 t, GrOperad.par_par, if_neg (by decide), LinearMap.zero_apply]
  cases b
  · exact LinearMap.congr_fun hfalse x
  · exact LinearMap.congr_fun htrue x

end LabBasis

/-! ## Grafting as contexts -/

section Graft

open STree

variable {T : ℕ → Type} {Y₁ Y₂ Y : Finset ℕ}

/-- **Grafting a monomial at a leaf**, as a map of monomials: `t₁ ↦ t₁ ∘ t₂` at the leaf `i₁`,
the least leaf of `t₂`. -/
def graftR (t₂ : SMono T Y₂) (i₁ : Lab Y₁) (hf : t₂.1.first = i₁.1)
    (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y) (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) :
    SMono T Y₁ → SMono T Y :=
  fun t₁ => ⟨t₁.1.subst (update STree.leaf i₁.1 t₂.1), subst_mem t₁ t₂ i₁ hf Ψ hΨ⟩

/-- **Grafting into a monomial at a leaf**, as a map of monomials: `t₂ ↦ t₁ ∘ t₂` at the leaf
`i₁`, the least leaf of `Y₂`. -/
def graftL (t₁ : SMono T Y₁) (i₁ : Lab Y₁) (hi₂ : i₁.1 ∈ Y₂) (hmin : ∀ y ∈ Y₂, i₁.1 ≤ y)
    (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y) (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) :
    SMono T Y₂ → SMono T Y :=
  fun t₂ => ⟨t₁.1.subst (update STree.leaf i₁.1 t₂.1),
    subst_mem t₁ t₂ i₁ (first_eq_of_min t₂ hi₂ hmin) Ψ hΨ⟩

/-- **Grafting a monomial at a leaf is a context.** -/
theorem isSCtx_graftR (t₂ : SMono T Y₂) (i₁ : Lab Y₁) (hf : t₂.1.first = i₁.1)
    (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y) (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) :
    IsSCtx (graftR t₂ i₁ hf Ψ hΨ) := by
  obtain ⟨hd, hY⟩ := svalEquiv_spec Ψ hΨ
  have hfirst : ∀ a, (update STree.leaf i₁.1 t₂.1 a).first = a := fun a => by
    by_cases ha : a = i₁.1
    · rw [ha, update_self, hf]
    · rw [update_of_ne ha, first_leaf]
  refine ⟨.leaf 0, [], update STree.leaf i₁.1 t₂.1, rfl, ⟨fun a _ => ?_, fun a ha b hb => ?_,
    fun a _ a' _ h => ?_⟩, fun g => by rw [replace_nil]; rfl⟩
  · by_cases h : a = i₁.1
    · rw [h, update_self]
      exact t₂.2.1
    · rw [update_of_ne h]
      trivial
  · rw [← hY]
    by_cases h : a = i₁.1
    · rw [h, update_self, t₂.2.2] at hb
      exact Finset.mem_disjUnion.2 (Or.inr hb)
    · rw [update_of_ne h, labels_leaf, Multiset.mem_singleton] at hb
      rw [hb]
      exact Finset.mem_disjUnion.2 (Or.inl (Finset.mem_erase.2 ⟨h, ha⟩))
  · show (update STree.leaf i₁.1 t₂.1 a).first < (update STree.leaf i₁.1 t₂.1 a').first
    rw [hfirst, hfirst]
    exact h

/-- **Grafting into a monomial at a leaf is a context.** -/
theorem isSCtx_graftL (t₁ : SMono T Y₁) (i₁ : Lab Y₁) (hi₂ : i₁.1 ∈ Y₂)
    (hmin : ∀ y ∈ Y₂, i₁.1 ≤ y) (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y)
    (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) : IsSCtx (graftL t₁ i₁ hi₂ hmin Ψ hΨ) := by
  obtain ⟨hd, hY⟩ := svalEquiv_spec Ψ hΨ
  have hget : t₁.1.get? (t₁.1.pos i₁.1) = some (.leaf i₁.1) :=
    STree.get?_pos (t₁.mem_labels.2 i₁.2)
  refine ⟨t₁.1, t₁.1.pos i₁.1, STree.leaf, by rw [hget]; rfl, ⟨fun _ _ => trivial,
    fun a ha b hb => ?_, fun _ _ _ _ h => h⟩, fun g => ?_⟩
  · rw [labels_leaf, Multiset.mem_singleton] at hb
    rw [hb, ← hY]
    exact Finset.mem_disjUnion.2 (Or.inr ha)
  · show t₁.1.subst (update STree.leaf i₁.1 g.1) = t₁.1.replace _ (g.1.subst STree.leaf)
    rw [subst_update t₁.nodup hget STree.leaf g.1, subst_leaf, subst_leaf]

end Graft

/-! ## The operations with coordinates in the ideal of the rules -/

section RelIdeal

open STree

variable {K : Type u} [Field K] {E : (A : Type) → [Fintype A] → [DecidableEq A] → Type u}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (E A)] [GrSpecies K E]
  {T : ℕ → Type} [IsEmpty (T 0)]
  (c : ∀ k, Module.Basis (T k) K (E (Fin k)))
  (hc : ∀ k (β : T k), GrSpecies.par (R := K) false (c k β) = c k β)
  {ρ : Type*} {O : STree.AdmOrder T} (G : Rules K ρ O.toCtxOrder)
  {Y₁ Y₂ Y : Finset ℕ}

/-- **The coordinates of a composite with a basis vector on the right**: graft it. -/
theorem repr_comp_graftR (t₂ : SMono T Y₂) (i₁ : Lab Y₁) (hf : t₂.1.first = i₁.1)
    (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y) (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z)
    (x : FreeGrL K E (Lab Y₁)) :
    (labBasis c hc Y).repr (GrOperad.map (R := K) Ψ
        (GrOperad.comp (R := K) i₁ x (labBasis c hc Y₂ t₂)))
      = Finsupp.mapDomain (graftR t₂ i₁ hf Ψ hΨ) ((labBasis c hc Y₁).repr x) := by
  have h : ((labBasis c hc Y).repr : FreeGrL K E (Lab Y) →ₗ[K] _) ∘ₗ
      (GrOperad.map (R := K) Ψ) ∘ₗ ((GrOperad.comp (R := K) i₁).flip (labBasis c hc Y₂ t₂))
      = (Finsupp.lmapDomain K K (graftR t₂ i₁ hf Ψ hΨ)) ∘ₗ
        ((labBasis c hc Y₁).repr : FreeGrL K E (Lab Y₁) →ₗ[K] _) :=
    (labBasis c hc Y₁).ext fun t₁ => by
      simp only [LinearMap.comp_apply, LinearMap.flip_apply, LinearEquiv.coe_coe,
        Module.Basis.repr_self, Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      rw [comp_labBasis c hc t₁ t₂ i₁ hf Ψ hΨ (graftR t₂ i₁ hf Ψ hΨ t₁) rfl,
        Module.Basis.repr_self]
  exact LinearMap.congr_fun h x

/-- **The coordinates of a composite with a basis vector on the left**: graft into it. -/
theorem repr_comp_graftL (t₁ : SMono T Y₁) (i₁ : Lab Y₁) (hi₂ : i₁.1 ∈ Y₂)
    (hmin : ∀ y ∈ Y₂, i₁.1 ≤ y) (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y)
    (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z) (z : FreeGrL K E (Lab Y₂)) :
    (labBasis c hc Y).repr (GrOperad.map (R := K) Ψ
        (GrOperad.comp (R := K) i₁ (labBasis c hc Y₁ t₁) z))
      = Finsupp.mapDomain (graftL t₁ i₁ hi₂ hmin Ψ hΨ) ((labBasis c hc Y₂).repr z) := by
  have h : ((labBasis c hc Y).repr : FreeGrL K E (Lab Y) →ₗ[K] _) ∘ₗ
      (GrOperad.map (R := K) Ψ) ∘ₗ (GrOperad.comp (R := K) i₁ (labBasis c hc Y₁ t₁))
      = (Finsupp.lmapDomain K K (graftL t₁ i₁ hi₂ hmin Ψ hΨ)) ∘ₗ
        ((labBasis c hc Y₂).repr : FreeGrL K E (Lab Y₂) →ₗ[K] _) :=
    (labBasis c hc Y₂).ext fun t₂ => by
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Module.Basis.repr_self,
        Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      rw [comp_labBasis c hc t₁ t₂ i₁ (first_eq_of_min t₂ hi₂ hmin) Ψ hΨ
        (graftL t₁ i₁ hi₂ hmin Ψ hΨ t₂) rfl, Module.Basis.repr_self]
  exact LinearMap.congr_fun h z

/-- **The operations on the leaves `Y` whose coordinates lie in the ideal of the rules.** -/
noncomputable def ShI (Y : Finset ℕ) : Submodule K (FreeGrL K E (Lab Y)) :=
  ((G.rw Y).ideal).comap ((labBasis c hc Y).repr : FreeGrL K E (Lab Y) →ₗ[K] _)

lemma mem_ShI {Y : Finset ℕ} {x : FreeGrL K E (Lab Y)} :
    x ∈ ShI c hc G Y ↔ (labBasis c hc Y).repr x ∈ (G.rw Y).ideal := Iff.rfl

/-- The ideal of the rules is closed under the composites on the right, named by values. -/
theorem comp_mem_ShI_left (i₁ : Lab Y₁) (hi₂ : i₁.1 ∈ Y₂) (hmin : ∀ y ∈ Y₂, i₁.1 ≤ y)
    (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y) (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z)
    {x : FreeGrL K E (Lab Y₁)} (hx : x ∈ ShI c hc G Y₁) (z : FreeGrL K E (Lab Y₂)) :
    GrOperad.map (R := K) Ψ (GrOperad.comp (R := K) i₁ x z) ∈ ShI c hc G Y := by
  refine mem_of_basis c hc ((ShI c hc G Y).comap
    ((GrOperad.map (R := K) Ψ) ∘ₗ (GrOperad.comp (R := K) i₁ x))) (fun t₂ => ?_) z
  show (labBasis c hc Y).repr (GrOperad.map (R := K) Ψ
    (GrOperad.comp (R := K) i₁ x (labBasis c hc Y₂ t₂))) ∈ (G.rw Y).ideal
  rw [repr_comp_graftR c hc t₂ i₁ (first_eq_of_min t₂ hi₂ hmin) Ψ hΨ]
  exact G.mapDomain_mem_ideal (isSCtx_graftR _ _ _ _ _) hx

/-- The ideal of the rules is closed under the composites on the left, named by values. -/
theorem comp_mem_ShI_right (i₁ : Lab Y₁) (hi₂ : i₁.1 ∈ Y₂) (hmin : ∀ y ∈ Y₂, i₁.1 ≤ y)
    (Ψ : Without (Lab Y₁) i₁ ⊕ Lab Y₂ ≃ Lab Y) (hΨ : ∀ z, (Ψ z).1 = FreeGrL.sval z)
    (x : FreeGrL K E (Lab Y₁)) {z : FreeGrL K E (Lab Y₂)} (hz : z ∈ ShI c hc G Y₂) :
    GrOperad.map (R := K) Ψ (GrOperad.comp (R := K) i₁ x z) ∈ ShI c hc G Y := by
  refine mem_of_basis c hc ((ShI c hc G Y).comap
    ((GrOperad.map (R := K) Ψ) ∘ₗ ((GrOperad.comp (R := K) i₁).flip z))) (fun t₁ => ?_) x
  show (labBasis c hc Y).repr (GrOperad.map (R := K) Ψ
    (GrOperad.comp (R := K) i₁ (labBasis c hc Y₁ t₁) z)) ∈ (G.rw Y).ideal
  rw [repr_comp_graftL c hc t₁ i₁ hi₂ hmin Ψ hΨ]
  exact G.mapDomain_mem_ideal (isSCtx_graftL _ _ _ _ _ _) hz

/-- **The ideal of the rules as an ideal of the free graded operad**: the operations whose
relabellings onto every set of leaves have their coordinates in the ideal of the rules. -/
noncomputable def relIdeal : GrOperadIdeal K (FreeGrL K E) where
  sub A := ⨅ (Y : Finset ℕ), ⨅ (e : A ≃ Lab Y), (ShI c hc G Y).comap (GrOperad.map (R := K) e)
  par_mem {A} _ _ b {x} hx := by
    simp only [Submodule.mem_iInf, Submodule.mem_comap] at hx ⊢
    intro Y e
    rw [GrOperad.map_par, par_labBasis c hc]
    split_ifs
    · exact zero_mem _
    · exact hx Y e
  map_mem {A B} _ _ _ _ e {x} hx := by
    simp only [Submodule.mem_iInf, Submodule.mem_comap] at hx ⊢
    intro Y e'
    rw [← GrOperad.map_trans]
    exact hx Y (e.trans e')
  comp_mem_left {A B} _ _ _ _ i {x} y hx := by
    simp only [Submodule.mem_iInf, Submodule.mem_comap] at hx ⊢
    intro Y e
    by_cases hB : IsEmpty B
    · have : y = 0 := GrOperadIdeal.eq_zero_of_card_eq_zero K (FreeGrL K E) (free_zero c hc)
        Fintype.card_eq_zero y
      rw [this, map_zero, map_zero]
      exact zero_mem _
    obtain ⟨b₀⟩ := not_isEmpty_iff.1 hB
    obtain ⟨Y₁, Y₂, e₁, e₂, Ψ, hΨ, hi₂, hmin, hcomp⟩ :=
      FreeGrL.exists_sort (R := K) (P := FreeGrL K E) i b₀ e
    rw [hcomp]
    exact comp_mem_ShI_left c hc G (e₁ i) hi₂ hmin Ψ hΨ (hx Y₁ e₁) _
  comp_mem_right {A B} _ _ _ _ i x {y} hy := by
    simp only [Submodule.mem_iInf, Submodule.mem_comap] at hy ⊢
    intro Y e
    by_cases hB : IsEmpty B
    · have : y = 0 := GrOperadIdeal.eq_zero_of_card_eq_zero K (FreeGrL K E) (free_zero c hc)
        Fintype.card_eq_zero y
      rw [this, map_zero, map_zero]
      exact zero_mem _
    obtain ⟨b₀⟩ := not_isEmpty_iff.1 hB
    obtain ⟨Y₁, Y₂, e₁, e₂, Ψ, hΨ, hi₂, hmin, hcomp⟩ :=
      FreeGrL.exists_sort (R := K) (P := FreeGrL K E) i b₀ e
    rw [hcomp]
    exact comp_mem_ShI_right c hc G (e₁ i) hi₂ hmin Ψ hΨ _ (hy Y₂ e₂)

lemma mem_relIdeal {A : Type} [Fintype A] [DecidableEq A] {x : FreeGrL K E A} :
    x ∈ (relIdeal c hc G).sub A ↔
      ∀ (Y : Finset ℕ) (e : A ≃ Lab Y), GrOperad.map (R := K) e x ∈ ShI c hc G Y := by
  simp only [relIdeal, Submodule.mem_iInf, Submodule.mem_comap]

/-! ### Increasing relabellings -/

/-- The values of a naming of `0, …, n - 1`. -/
def valFn {n : ℕ} {Y : Finset ℕ} (e₀ : Fin n ≃ Lab Y) (a : ℕ) : ℕ :=
  if h : a < n then (e₀ ⟨a, h⟩).1 else 0

omit [IsEmpty (T 0)] in
lemma valFn_fin {n : ℕ} {Y : Finset ℕ} (e₀ : Fin n ≃ Lab Y) (j : Fin n) :
    valFn e₀ j = (e₀ j).1 := by
  rw [valFn, dif_pos j.2]

omit [IsEmpty (T 0)] in
lemma strictMonoOn_valFn {n : ℕ} {Y : Finset ℕ} (e₀ : Fin n ≃ Lab Y)
    (hmono : StrictMono fun j => (e₀ j).1) :
    StrictMonoOn (valFn e₀) (Finset.range n : Set ℕ) := by
  intro a ha b hb hab
  have ha' := Finset.mem_range.1 (Finset.mem_coe.1 ha)
  have hb' := Finset.mem_range.1 (Finset.mem_coe.1 hb)
  rw [valFn, dif_pos ha', valFn, dif_pos hb']
  exact hmono (show (⟨a, ha'⟩ : Fin n) < ⟨b, hb'⟩ from hab)

omit [IsEmpty (T 0)] in
lemma image_valFn {n : ℕ} {Y : Finset ℕ} (e₀ : Fin n ≃ Lab Y) :
    (Finset.range n).image (valFn e₀) = Y := by
  ext y
  rw [Finset.mem_image]
  constructor
  · rintro ⟨a, ha, rfl⟩
    rw [valFn, dif_pos (Finset.mem_range.1 ha)]
    exact (e₀ _).2
  · intro hy
    refine ⟨(e₀.symm ⟨y, hy⟩ : ℕ), Finset.mem_range.2 (e₀.symm ⟨y, hy⟩).2, ?_⟩
    rw [valFn_fin, Equiv.apply_symm_apply]

/-- **The coordinates of an increasing relabelling**: relabel the monomials. -/
theorem repr_map_mono {n : ℕ} {Y : Finset ℕ} (e₀ : Fin n ≃ Lab Y)
    (hmono : StrictMono fun j => (e₀ j).1) (x : FreeGrL K E (Fin n)) :
    (labBasis c hc Y).repr (GrOperad.map (R := K) e₀ x)
      = Finsupp.mapDomain (ShuffleBridge.relabelM (valFn e₀) (strictMonoOn_valFn e₀ hmono)
        (image_valFn e₀)) ((tBasisN c hc n).repr x) := by
  have h : ((labBasis c hc Y).repr : FreeGrL K E (Lab Y) →ₗ[K] (SMono T Y →₀ K)) ∘ₗ
      (GrOperad.map (R := K) e₀)
      = (Finsupp.lmapDomain K K (ShuffleBridge.relabelM (valFn e₀)
          (strictMonoOn_valFn e₀ hmono) (image_valFn e₀))) ∘ₗ
        ((tBasisN c hc n).repr : FreeGrL K E (Fin n) →ₗ[K] (SMono T (Finset.range n) →₀ K)) :=
    (tBasisN c hc n).ext fun m => by
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, Module.Basis.repr_self,
        Finsupp.lmapDomain_apply, Finsupp.mapDomain_single]
      have hlab : ((m.cast (by rw [Fintype.card_fin]) :
          SMono T (Finset.range (Fintype.card (Fin n)))).1.relabel (valFn e₀)).labels = Y.val :=
        (ShuffleBridge.relabelM (valFn e₀) (strictMonoOn_valFn e₀ hmono) (image_valFn e₀) m).2.2
      have h1 : GrOperad.map (R := K) e₀ (tBasisN c hc n m)
          = labBasis c hc Y (ShuffleBridge.relabelM (valFn e₀) (strictMonoOn_valFn e₀ hmono)
            (image_valFn e₀) m) := by
        rw [tBasisN_apply, map_tBasis c hc _ e₀ (valFn e₀) (fun j => (valFn_fin e₀ j).symm) hlab,
          labBasis, FreeGrL.shBasisLab_apply]
        rfl
      rw [h1, Module.Basis.repr_self]
  exact LinearMap.congr_fun h x

end RelIdeal

/-! ## The relators lie in the ideal of the rules -/

section Relators

open STree

variable {K : Type u} [Field K] {E : (A : Type) → [Fintype A] → [DecidableEq A] → Type u}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (E A)] [GrSpecies K E]
  {T : ℕ → Type} [IsEmpty (T 0)]
  (c : ∀ k, Module.Basis (T k) K (E (Fin k)))
  (hc : ∀ k (β : T k), GrSpecies.par (R := K) false (c k β) = c k β)
  (r : ∀ n : ℕ, Set (FreeGrL K E (Fin n)))
  {ρ : Type*} {O : STree.AdmOrder T} (G : Rules K ρ O.toCtxOrder)
  (hrS : ∀ n (σ : Equiv.Perm (Fin n)), ∀ x ∈ r n,
    GrOperad.map (R := K) σ x ∈ Submodule.span K (r n))
  (hG : ∀ n, ∀ x ∈ r n, (tBasisN c hc n).repr x ∈ (G.rw (Finset.range n)).ideal)

include hrS hG in
/-- **The ideal of the relators lies in the ideal of the rules**, for relators stable under the
symmetric groups whose coordinates lie in the ideal of the rules: a relabelling of a relator is
an increasing one after a permutation, and an increasing relabelling is a context. -/
theorem span_le_relIdeal : GrOperadIdeal.span K r ≤ relIdeal c hc G := by
  refine GrOperadIdeal.span_le.2 fun n x hx => (mem_relIdeal c hc G).2 fun Y e => ?_
  have hcard : Y.card = n := by
    have := Fintype.card_congr e
    simpa using this.symm
  let e₀ : Fin n ≃ Lab Y := (Y.orderIsoOfFin hcard).toEquiv
  have hmono : StrictMono fun j => (e₀ j).1 := fun a b hab =>
    (Y.orderIsoOfFin hcard).strictMono hab
  have he : e = (e.trans e₀.symm).trans e₀ := by
    ext j
    simp
  have hspan : Submodule.span K (r n) ≤ (ShI c hc G Y).comap (GrOperad.map (R := K) e₀) :=
    Submodule.span_le.2 fun x' hx' => by
      show (labBasis c hc Y).repr (GrOperad.map (R := K) e₀ x') ∈ (G.rw Y).ideal
      rw [repr_map_mono c hc e₀ hmono]
      exact G.mapDomain_mem_ideal (ShuffleBridge.isSCtx_relabelM _ _ _) (hG n x' hx')
  rw [he, GrOperad.map_trans]
  exact hspan (hrS n _ x hx)

/-- The inputs `0, …, k - 1` named by themselves. -/
def idLab (k : ℕ) : Fin k ≃ Lab (Finset.range k) where
  toFun j := ⟨j.1, Finset.mem_range.2 j.2⟩
  invFun x := ⟨x.1, Finset.mem_range.1 x.2⟩
  left_inv _ := rfl
  right_inv _ := rfl

omit [IsEmpty (T 0)] in
lemma relabelM_idLab (k : ℕ) (hmono : StrictMono fun j => (idLab k j).1) :
    ShuffleBridge.relabelM (E := T) (valFn (idLab k)) (strictMonoOn_valFn (idLab k) hmono)
      (image_valFn (idLab k)) = id :=
  funext fun m => Subtype.ext (relabel_id fun a ha => by
    have ha' := Finset.mem_range.1 (m.mem_labels.1 ha)
    rw [valFn, dif_pos ha']
    rfl)

/-- The coordinates on the leaves `0, …, k - 1` are the coordinates in `tBasisN`. -/
theorem repr_map_idLab (k : ℕ) (y : FreeGrL K E (Fin k)) :
    (labBasis c hc (Finset.range k)).repr (GrOperad.map (R := K) (idLab k) y)
      = (tBasisN c hc k).repr y := by
  have hmono : StrictMono fun j => (idLab k j).1 := fun _ _ h => h
  rw [repr_map_mono c hc (idLab k) hmono, relabelM_idLab k hmono, Finsupp.mapDomain_id]

include hrS hG in
/-- **The coordinates of an operation of the ideal of the relators lie in the ideal of the
rules.** -/
theorem repr_mem_ideal_of_mem_span {k : ℕ} {y : FreeGrL K E (Fin k)}
    (hy : y ∈ (GrOperadIdeal.span K r).sub (Fin k)) :
    (tBasisN c hc k).repr y ∈ (G.rw (Finset.range k)).ideal := by
  have h1 := (mem_relIdeal c hc G).1 (span_le_relIdeal c hc r G hrS hG (Fin k) hy)
    (Finset.range k) (idLab k)
  rw [mem_ShI, repr_map_idLab] at h1
  exact h1

end Relators

end ShuffleAnySym

end Operad
