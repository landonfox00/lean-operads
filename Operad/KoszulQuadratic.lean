/-
# Quadratic data and the cooperad `C(sE, s²R)`

The trees with `n` vertices span the weight `n` part `T(V)^{(n)}` of the free graded operad on a
graded linear species (`FreeGrL.wtEqL`), and every element is a sum of such parts
(`FreeGrL.iSup_wtEqL`); in every cut of a tree with `n` vertices the vertices of the two parts add
up to `n` (`FreeGrL.decomp_mem_wtEqL`). Relators are **quadratic** when they lie in `T(E)^{(2)}`
(`Koszul.IsQuadratic`); the **relations** `R` are the graded subspecies they generate
(`Koszul.relSp`).

* **The weight two part of the ideal is `R`**: `(r) ∩ T(E)^{(2)} = R` for quadratic relators
  (`Koszul.ideal_inf_vx_two`), since `R` plus the trees with at least three vertices is an ideal
  (`Koszul.quadIdeal`).
* **`κ_T ⋆ κ_T` only sees the trees with two vertices** (`Koszul.star_wtEqL`) and sends them into
  `T(E)^{(2)}` (`Koszul.star_mem_vx`): the desuspension map lands in the trees with one vertex and
  vanishes on the others (`Koszul.kapL_mem_vx`, `Koszul.kapL_vx`).
* **The corelations** `s²R ⊆ T^c(sE)^{(2)}` are the trees with two vertices whose image under
  `κ_T ⋆ κ_T`, the composite of the desuspensions of their two vertices, is a relation
  (`Koszul.coRel`), and **the cooperad `C(sE, s²R)` cogenerated by `sE` with corelations `s²R`** is
  the largest subcooperad of `T^c(sE)` on which the projection `T^c(sE) → T^c(sE)^{(2)}/s²R`
  vanishes (`Koszul.coquadSub`), the subcooperad cogenerated by its kernel `Koszul.coRelKer`.
* **`P^¡ = C(sE, s²R)`** for quadratic relators (`Koszul.dualSub_eq_coquadSub`): the elements on
  which `κ_T ⋆ κ_T` lands in the ideal are that kernel (`Koszul.admissible_eq`). In particular the
  trees with two vertices of `P^¡` are corelations (`Koszul.dual_inf_wtEqL_le`).

The comparisons use the eigenspaces of the vertex count (`FreeGrL.vx`), which split the free graded
operad over a `ℚ`-algebra, so the theorems assume a field of characteristic zero; the definitions
do not. The corelations are defined as a preimage under `κ_T ⋆ κ_T`: that it is a bijection
`T^c(sE)^{(2)} → T(E)^{(2)}`, so that `s²R` is the image of `R`, is not proved here, nor is the
reverse inclusion `s²R ⊆ P^¡`.
-/
import Operad.ConvFilt

universe u v

namespace Operad

open Sym GerBV
open scoped TensorProduct

section Weights

variable {R : Type u} [CommRing R]
  {A B : Type} [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B]

namespace FreeGr

variable {T : ℕ → Type v} {gp : ∀ k, T k → Bool}

variable (R gp) in
/-- The span of the trees with `n` vertices. -/
noncomputable def wtEq (n : ℕ) (A : Type) [Fintype A] [DecidableEq A] :
    Submodule R (FreeGr R gp A) :=
  Submodule.span R {z | ∃ x : Reg (TreeOfArity T) A, vtx x = n ∧ SgnLin.bas (treeSgn gp) R x = z}

lemma bas_mem_wtEq (x : Reg (TreeOfArity T) A) :
    SgnLin.bas (treeSgn gp) R x ∈ wtEq R gp (vtx x) A :=
  Submodule.subset_span ⟨x, rfl, rfl⟩

/-- **Every tree has a number of vertices.** -/
lemma iSup_wtEq (A : Type) [Fintype A] [DecidableEq A] : ⨆ n, wtEq R gp n A = ⊤ :=
  eq_top_iff.2 fun y _ => by
    simpa using mem_of_bas (R := R) (gp := gp) LinearMap.id (⨆ n, wtEq R gp n A)
      (fun t => Submodule.mem_iSup_of_mem (vtx t) (bas_mem_wtEq t)) y

lemma par_mem_wtEq (b : Bool) {n : ℕ} {z : FreeGr R gp A} (hz : z ∈ wtEq R gp n A) :
    GrOperad.par (R := R) b z ∈ wtEq R gp n A := by
  refine (Submodule.span_le (p := (wtEq R gp n A).comap (GrOperad.par (R := R) b))).2 ?_ hz
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, par_bas_eq]
  split_ifs
  · exact Submodule.subset_span ⟨x, hx, rfl⟩
  · exact zero_mem _

lemma map_mem_wtEq (e : A ≃ B) {n : ℕ} {z : FreeGr R gp A} (hz : z ∈ wtEq R gp n A) :
    GrOperad.map (R := R) e z ∈ wtEq R gp n B := by
  refine (Submodule.span_le (p := (wtEq R gp n B).comap (GrOperad.map (R := R) e))).2 ?_ hz
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, SgnLin.map_bas]
  exact Submodule.subset_span ⟨_, by rw [vtx, FreeReg.cntR_map]; exact hx, rfl⟩

variable (R gp) in
/-- The tensors of trees with `a` and `b` vertices, for `a + b = n`. -/
noncomputable def wtPair (n : ℕ) (A B : Type) [Fintype A] [DecidableEq A] [Fintype B]
    [DecidableEq B] : Submodule R (FreeGr R gp A ⊗[R] FreeGr R gp B) :=
  ⨆ (a : ℕ) (b : ℕ) (_ : a + b = n),
    LinearMap.range (TensorProduct.map (wtEq R gp a A).subtype (wtEq R gp b B).subtype)

/-- **The decomposition of a tree with `n` vertices**: in every cut, the vertices of the two parts
add up to `n`. -/
lemma decomp_mem_wtEq (i : A) {n : ℕ} {z : FreeGr R gp (Without A i ⊕ B)}
    (hz : z ∈ wtEq R gp n (Without A i ⊕ B)) :
    GrCooperad.decomp (R := R) (C := FreeGr R gp) i z ∈ wtPair R gp n A B := by
  refine (Submodule.span_le (p := (wtPair R gp n A B).comap
    (GrCooperad.decomp (R := R) (C := FreeGr R gp) i))).2 ?_ hz
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap]
  have e : GrCooperad.decomp (R := R) (C := FreeGr R gp) i (SgnLin.bas (treeSgn gp) R x)
      = ∑ pq ∈ (SetOperad.FiniteFact.finite i x).toFinset,
          σ R (SgnData.sgn i ((treeSgn gp).app A pq.1) ((treeSgn gp).app B pq.2)) •
            ((SgnLin.bas (treeSgn gp) R pq.1 : FreeGr R gp A) ⊗ₜ[R]
              (SgnLin.bas (treeSgn gp) R pq.2 : FreeGr R gp B)) := by
    have h := SgnLin.decompT_single (R := R) (δ := treeSgn gp) i x 1
    simp only [mul_one] at h
    exact h
  rw [e]
  refine Submodule.sum_mem _ fun pq hpq => Submodule.smul_mem _ _ ?_
  have h := (SgnLin.mem_fact_iff i x pq).1 hpq
  have hv : vtx pq.1 + vtx pq.2 = n := by
    rw [vtx, vtx, ← FreeReg.cntR_comp, h]
    exact hx
  exact Submodule.mem_iSup_of_mem (vtx pq.1) (Submodule.mem_iSup_of_mem (vtx pq.2)
    (Submodule.mem_iSup_of_mem hv ⟨⟨_, bas_mem_wtEq pq.1⟩ ⊗ₜ ⟨_, bas_mem_wtEq pq.2⟩, rfl⟩))

end FreeGr

namespace FreeGrL

variable {V : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (V A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (V A)] [GrSpecies R V]

local notation "𝒥" => GrOperadIdeal.span R (grLinRel R V)

variable (R V) in
/-- **The trees with `n` vertices**, in the free graded operad on a graded linear species: the
weight `n` part `T(V)^{(n)}`. -/
noncomputable def wtEqL (n : ℕ) (A : Type) [Fintype A] [DecidableEq A] :
    Submodule R (FreeGrL R V A) :=
  (FreeGr.wtEq R (grGenPar R V) n A).map ((𝒥).proj A)

/-- **Every element is a sum of trees with numbers of vertices.** -/
lemma iSup_wtEqL (A : Type) [Fintype A] [DecidableEq A] : ⨆ n, wtEqL R V n A = ⊤ := by
  simp only [wtEqL]
  rw [← Submodule.map_iSup, FreeGr.iSup_wtEq, Submodule.map_top]
  exact LinearMap.range_eq_top.2 ((𝒥).proj_surjective A)

lemma par_mem_wtEqL (b : Bool) {n : ℕ} {y : FreeGrL R V A} (hy : y ∈ wtEqL R V n A) :
    GrOperad.par (R := R) b y ∈ wtEqL R V n A := by
  obtain ⟨z, hz, rfl⟩ := hy
  exact ⟨_, FreeGr.par_mem_wtEq b hz, rfl⟩

lemma map_mem_wtEqL (e : A ≃ B) {n : ℕ} {y : FreeGrL R V A} (hy : y ∈ wtEqL R V n A) :
    GrOperad.map (R := R) e y ∈ wtEqL R V n B := by
  obtain ⟨z, hz, rfl⟩ := hy
  exact ⟨_, FreeGr.map_mem_wtEq e hz, rfl⟩

/-- **The trees with no vertex are the relabellings of the unit.** -/
lemma wtEqL_zero_le_unitSpan : wtEqL R V 0 A ≤ GrCooperad.unitSpan R (FreeGrL R V) A :=
  wtZeroL_le_unitSpan

/-- **The trees with `n` vertices have weight `n`** for the vertex count. -/
lemma wtEqL_le_vx (n : ℕ) : wtEqL R V n A ≤ vx R V n A := by
  rw [wtEqL, Submodule.map_le_iff_le_comap, FreeGr.wtEq, Submodule.span_le]
  rintro _ ⟨x, hx, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, mem_eig, ← Cobar.wtD_eq_derSp, wtD_proj_bas,
    ← Tree.cnt_one, ← hx]
  rfl

/-- **The decomposition of a tree with `n` vertices**, in the cut cooperad. -/
lemma decomp_mem_wtEqL (i : A) {n : ℕ} {y : FreeGrL R V (Without A i ⊕ B)}
    (hy : y ∈ wtEqL R V n (Without A i ⊕ B)) :
    GrCooperad.decomp (R := R) (C := FreeGrL R V) i y
      ∈ ⨆ (a : ℕ) (b : ℕ) (_ : a + b = n),
        LinearMap.range (TensorProduct.map (wtEqL R V a A).subtype (wtEqL R V b B).subtype) := by
  obtain ⟨z, hz, rfl⟩ := hy
  have hm := Submodule.mem_map_of_mem (f := TensorProduct.map ((𝒥).proj A) ((𝒥).proj B))
    (FreeGr.decomp_mem_wtEq i hz)
  simp only [FreeGr.wtPair, Submodule.map_iSup] at hm
  refine SetLike.le_def.1 (iSup_mono fun a => iSup_mono fun b => iSup_mono fun _ => ?_) hm
  exact map_range_map_subtype_le _ _ _ _

end FreeGrL

end Weights

/-! ## Quadratic data -/

section Quadratic

variable {R : Type u} [Field R] {E : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (E A)] [GrSpecies R E]
  {A B : Type} [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B]

namespace Koszul

open FreeGrL

variable (r : ∀ n : ℕ, Set (FreeGrL R E (Fin n)))

variable (R E) in
/-- **Quadratic relators**: every relator is a combination of trees with two vertices, an element
of the weight two part `T(E)^{(2)}`. -/
def IsQuadratic : Prop := ∀ n, r n ⊆ wtEqL R E 2 (Fin n)

variable (R E) in
/-- **The relations** `R ⊆ T(E)^{(2)}` of quadratic relators: the graded subspecies generated by
the relators, spanned by the parts of each parity of their relabellings. -/
noncomputable def relSp (A : Type) [Fintype A] [DecidableEq A] : Submodule R (FreeGrL R E A) :=
  Submodule.span R {y | ∃ (n : ℕ) (x : FreeGrL R E (Fin n)) (_ : x ∈ r n) (e : Fin n ≃ A)
    (b : Bool), GrOperad.par (R := R) b (GrOperad.map (R := R) e x) = y}

variable {r}

lemma mem_relSp {n : ℕ} {x : FreeGrL R E (Fin n)} (hx : x ∈ r n) : x ∈ relSp R E r (Fin n) := by
  rw [← GrOperad.par_add (R := R) x]
  refine add_mem (Submodule.subset_span ⟨n, x, hx, Equiv.refl _, false, ?_⟩)
    (Submodule.subset_span ⟨n, x, hx, Equiv.refl _, true, ?_⟩) <;>
  rw [GrOperad.map_refl]

lemma par_mem_relSp (c : Bool) {y : FreeGrL R E A} (hy : y ∈ relSp R E r A) :
    GrOperad.par (R := R) c y ∈ relSp R E r A := by
  refine (Submodule.span_le (p := (relSp R E r A).comap (GrOperad.par (R := R) c))).2 ?_ hy
  rintro _ ⟨n, x, hx, e, b, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, GrOperad.par_par]
  split_ifs
  · exact Submodule.subset_span ⟨n, x, hx, e, b, rfl⟩
  · exact zero_mem _

lemma map_mem_relSp (σ' : A ≃ B) {y : FreeGrL R E A} (hy : y ∈ relSp R E r A) :
    GrOperad.map (R := R) σ' y ∈ relSp R E r B := by
  refine (Submodule.span_le (p := (relSp R E r B).comap (GrOperad.map (R := R) σ'))).2 ?_ hy
  rintro _ ⟨n, x, hx, e, b, rfl⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, GrOperad.map_par, ← GrOperad.map_trans]
  exact Submodule.subset_span ⟨n, x, hx, e.trans σ', b, rfl⟩

/-- **The relations lie in the ideal generated by the relators.** -/
lemma relSp_le_ideal : relSp R E r A ≤ (GrOperadIdeal.span R r).sub A := by
  rw [relSp, Submodule.span_le]
  rintro _ ⟨n, x, hx, e, b, rfl⟩
  exact (GrOperadIdeal.span R r).par_mem b
    ((GrOperadIdeal.span R r).map_mem e (GrOperadIdeal.subset_span n hx))

lemma par_mem_vx (c : Bool) {j : ℕ} {y : FreeGrL R E A} (hy : y ∈ vx R E j A) :
    GrOperad.par (R := R) c y ∈ vx R E j A := by
  refine mem_eig.2 ?_
  rw [GrDer.app_par, Bool.xor_false, mem_eig.1 hy, map_smul]

/-- **Quadratic relations have two vertices.** -/
lemma relSp_le_vx (hq : IsQuadratic R E r) : relSp R E r A ≤ vx R E 2 A := by
  rw [relSp, Submodule.span_le]
  rintro _ ⟨n, x, hx, e, b, rfl⟩
  exact par_mem_vx b (map_mem_eig e (wtEqL_le_vx 2 (hq n hx)))

lemma par_mem_vxGe (c : Bool) {p : ℕ} {y : FreeGrL R E A} (hy : y ∈ vxGe R E p A) :
    GrOperad.par (R := R) c y ∈ vxGe R E p A :=
  Submodule.iSup_induction _ (motive := fun y => GrOperad.par (R := R) c y ∈ vxGe R E p A) hy
    (fun k y hy => Submodule.mem_iSup_of_mem k (par_mem_vx c hy))
    (by beta_reduce; rw [map_zero]; exact zero_mem _)
    (fun y y' hy hy' => by beta_reduce at hy hy' ⊢; rw [map_add]; exact add_mem hy hy')

lemma map_mem_vxGe (σ' : A ≃ B) {p : ℕ} {y : FreeGrL R E A} (hy : y ∈ vxGe R E p A) :
    GrOperad.map (R := R) σ' y ∈ vxGe R E p B :=
  Submodule.iSup_induction _ (motive := fun y => GrOperad.map (R := R) σ' y ∈ vxGe R E p B) hy
    (fun k y hy => Submodule.mem_iSup_of_mem k (map_mem_eig σ' hy))
    (by beta_reduce; rw [map_zero]; exact zero_mem _)
    (fun y y' hy hy' => by beta_reduce at hy hy' ⊢; rw [map_add]; exact add_mem hy hy')

/-- **The numbers of vertices add under composition.** -/
lemma comp_mem_vxGe (i : A) {a b : ℕ} {x : FreeGrL R E A} {y : FreeGrL R E B}
    (hx : x ∈ vxGe R E a A) (hy : y ∈ vxGe R E b B) :
    GrOperad.comp (R := R) i x y ∈ vxGe R E (a + b) _ :=
  comp_mem_of_iSup i (fun k l x hx y hy => mem_vxGe (by have := k.2; have := l.2; omega)
    (comp_mem_eig i hx hy)) hx hy

/-- **Every element is a combination of units plus trees with vertices.** -/
lemma mem_unitSpan_sup (y : FreeGrL R E A) :
    y ∈ GrCooperad.unitSpan R (FreeGrL R E) A ⊔ vxGe R E 1 A := by
  have hy : y ∈ ⨆ n, wtEqL R E n A := (iSup_wtEqL (R := R) (V := E) A).symm ▸ Submodule.mem_top
  refine (iSup_le fun n => ?_ : ⨆ n, wtEqL R E n A
    ≤ GrCooperad.unitSpan R (FreeGrL R E) A ⊔ vxGe R E 1 A) hy
  rcases n with _ | n
  · exact wtEqL_zero_le_unitSpan.trans le_sup_left
  · exact fun z hz => Submodule.mem_sup_right (mem_vxGe (by omega) (wtEqL_le_vx _ hz))

variable (R E r) in
/-- The relations plus the trees with at least three vertices: for quadratic relators, an ideal
containing the relators. -/
noncomputable def quadIdeal [CharZero R] (hq : IsQuadratic R E r) :
    GrOperadIdeal R (FreeGrL R E) where
  sub A _ _ := relSp R E r A ⊔ vxGe R E 3 A
  par_mem := by
    intro A _ _ b x hx
    obtain ⟨ρ, hρ, z, hz, rfl⟩ := Submodule.mem_sup.1 hx
    rw [map_add]
    exact add_mem (Submodule.mem_sup_left (par_mem_relSp b hρ))
      (Submodule.mem_sup_right (par_mem_vxGe b hz))
  map_mem := by
    intro A B _ _ _ _ e x hx
    obtain ⟨ρ, hρ, z, hz, rfl⟩ := Submodule.mem_sup.1 hx
    rw [map_add]
    exact add_mem (Submodule.mem_sup_left (map_mem_relSp e hρ))
      (Submodule.mem_sup_right (map_mem_vxGe e hz))
  comp_mem_left := by
    intro A B _ _ _ _ i x y hx
    obtain ⟨ρ, hρ, z, hz, rfl⟩ := Submodule.mem_sup.1 hx
    rw [LinearMap.map_add₂]
    refine add_mem ?_ (Submodule.mem_sup_right (comp_mem_vxGe (a := 3) (b := 0) i hz
      ((vxGe_zero (R := R) (X := E) (A := B)).symm ▸ Submodule.mem_top)))
    obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.1 (mem_unitSpan_sup y)
    rw [map_add]
    refine add_mem (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right
      (comp_mem_vxGe (a := 2) (b := 1) i (mem_vxGe le_rfl (relSp_le_vx hq hρ)) hw))
    refine Submodule.span_induction
      (p := fun u _ => GrOperad.comp (R := R) i ρ u ∈ relSp R E r _) ?_
      (by beta_reduce; rw [map_zero]; exact zero_mem _)
      (fun a b _ _ ha hb => by beta_reduce at ha hb ⊢; rw [map_add]; exact add_mem ha hb)
      (fun c a _ ha => by beta_reduce at ha ⊢; rw [map_smul]; exact Submodule.smul_mem _ c ha)
      hu
    rintro _ ⟨e, rfl⟩
    obtain ⟨E', hE⟩ := GrOperad.comp_map_one (R := R) (P := FreeGrL R E) i ρ e
    show GrOperad.comp (R := R) i ρ (GrOperad.map (R := R) e (GrOperad.one (R := R))) ∈ _
    rw [hE]
    exact map_mem_relSp E' hρ
  comp_mem_right := by
    intro A B _ _ _ _ i x y hy
    obtain ⟨ρ, hρ, z, hz, rfl⟩ := Submodule.mem_sup.1 hy
    rw [map_add]
    refine add_mem ?_ (Submodule.mem_sup_right (comp_mem_vxGe (a := 0) (b := 3) i
      ((vxGe_zero (R := R) (X := E) (A := A)).symm ▸ Submodule.mem_top) hz))
    obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.1 (mem_unitSpan_sup x)
    rw [LinearMap.map_add₂]
    refine add_mem (Submodule.mem_sup_left ?_) (Submodule.mem_sup_right
      (comp_mem_vxGe (a := 1) (b := 2) i hw (mem_vxGe le_rfl (relSp_le_vx hq hρ))))
    refine Submodule.span_induction
      (p := fun u _ => GrOperad.comp (R := R) i u ρ ∈ relSp R E r _) ?_
      (by beta_reduce; rw [LinearMap.map_zero₂]; exact zero_mem _)
      (fun a b _ _ ha hb => by
        beta_reduce at ha hb ⊢; rw [LinearMap.map_add₂]; exact add_mem ha hb)
      (fun c a _ ha => by
        beta_reduce at ha ⊢; rw [LinearMap.map_smul₂]; exact Submodule.smul_mem _ c ha)
      hu
    rintro _ ⟨e, rfl⟩
    obtain ⟨E', hE⟩ := GrOperad.map_one_comp (R := R) (P := FreeGrL R E) e i ρ
    show GrOperad.comp (R := R) i (GrOperad.map (R := R) e (GrOperad.one (R := R))) ρ ∈ _
    rw [hE]
    exact map_mem_relSp E' hρ

/-- **The weight two part of the ideal generated by quadratic relators is the space of relations**
`R`, over a field of characteristic zero: `(r) ∩ T(E)^{(2)} = R`. -/
theorem ideal_inf_vx_two [CharZero R] (hq : IsQuadratic R E r) :
    (GrOperadIdeal.span R r).sub A ⊓ vx R E 2 A = relSp R E r A := by
  refine le_antisymm (fun x hx => ?_) (le_inf relSp_le_ideal (relSp_le_vx hq))
  have hJ : GrOperadIdeal.span R r ≤ quadIdeal R E r hq :=
    GrOperadIdeal.span_le.2 fun n x hx => Submodule.mem_sup_left (mem_relSp hx)
  obtain ⟨ρ, hρ, z, hz, rfl⟩ := Submodule.mem_sup.1 (hJ A hx.1)
  have hz2 : z ∈ vx R E 2 A := by
    simpa using sub_mem hx.2 (relSp_le_vx hq hρ)
  rw [Submodule.disjoint_def.1 (vx_disjoint (R := R) (X := E) (A := A) 2) z hz2 hz, add_zero]
  exact hρ

/-! ### The convolution square of the desuspension map -/

/-- **The desuspension map only sees the trees with one vertex**, over a field of characteristic
zero. -/
lemma kapL_vx [CharZero R] {j : ℕ} (hj : j ≠ 1) {x : Cut R E A}
    (hx : x ∈ vx R (GrSpecies.Shift E R) j A) : kapL R E A x = 0 :=
  snd_eq_zero_of_vx (epsHom R E) (fun A _ _ w => by
    rw [epsHom, FreeGrL.homEquiv_symm_ι]
    rfl) hj hx

/-- **The desuspension map lands in the trees with one vertex**, over a field of characteristic
zero. -/
lemma kapL_mem_vx [CharZero R] (x : Cut R E A) : kapL R E A x ∈ vx R E 1 A := by
  have hx : x ∈ ⨆ n, wtEqL R (GrSpecies.Shift E R) n A :=
    (iSup_wtEqL (R := R) (V := GrSpecies.Shift E R) A).symm ▸ Submodule.mem_top
  refine (iSup_le fun n => ?_ : ⨆ n, wtEqL R (GrSpecies.Shift E R) n A
    ≤ (vx R E 1 A).comap (kapL R E A)) hx
  intro y hy
  rw [Submodule.mem_comap]
  by_cases hn : n = 1
  · subst hn
    rw [eq_ι_genCoef (wtEqL_le_vx 1 hy)]
    show kapL R E A ((FreeGrL.ι R (GrSpecies.Shift E R)).app A
      (GrSpecies.Shift.of A (genCoef R (GrSpecies.Shift E R) A y))) ∈ _
    rw [kapL_ι]
    exact ι_mem_vx _
  · rw [kapL_vx hn (wtEqL_le_vx n hy)]
    exact zero_mem _

/-- **`κ_T ⋆ κ_T` lands in the trees with two vertices**, over a field of characteristic zero. -/
lemma star_mem_vx [CharZero R] (x : Cut R E A) :
    ConvOp.toLin ((GrOperad.Inv.star R _ (kapT R E) (kapT R E)).1 A) x ∈ vx R E 2 A := by
  have hG : ∀ (A : Type) [Fintype A] [DecidableEq A] (b : Bool) (y : FreeGrL R E A),
      y ∈ vx R E 1 A → GrOperad.par (R := R) b y ∈ vx R E 1 A :=
    fun _ _ _ b _ hy => par_mem_vx b hy
  have hH : ∀ (A B : Type) [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B] (e : A ≃ B)
      (y : FreeGrL R E A), y ∈ vx R E 2 A → GrOperad.map (R := R) e y ∈ vx R E 2 B :=
    fun _ _ _ _ _ _ e _ hy => map_mem_eig e hy
  have hFG : ∀ (A B : Type) [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B] (i : A)
      (y : FreeGrL R E A) (z : FreeGrL R E B), y ∈ vx R E 1 A → z ∈ vx R E 1 B →
      GrOperad.comp (R := R) i y z ∈ vx R E 2 (Without A i ⊕ B) :=
    fun _ _ _ _ _ _ i _ _ hy hz => comp_mem_eig (a := GrSpEnd.id R E) (i := 1) (j := 1) i hy hz
  have hf : ∀ (A : Type) [Fintype A] [DecidableEq A] (x : Cut R E A),
      ConvOp.toLin ((kapT R E).1 A) x ∈ vx R E 1 A := fun A _ _ x => by
    rw [kapT_apply, ConvOp.toLin_of]
    exact kapL_mem_vx x
  exact ConvOp.toLin_star_mem (F := fun A _ _ => vx R E 1 A) (G := fun A _ _ => vx R E 1 A)
    (H := fun A _ _ => vx R E 2 A) hG hH hFG hf hf A x

/-- **`κ_T ⋆ κ_T` only sees the trees with two vertices**, over a field of characteristic zero. -/
lemma star_wtEqL [CharZero R] {n : ℕ} (hn : n ≠ 2) {x : Cut R E A}
    (hx : x ∈ wtEqL R (GrSpecies.Shift E R) n A) :
    ConvOp.toLin ((GrOperad.Inv.star R _ (kapT R E) (kapT R E)).1 A) x = 0 := by
  rw [GrOperad.Inv.star_apply, ConvOp.toLin_sum, LinearMap.coe_sum, Finset.sum_apply]
  refine Finset.sum_eq_zero fun S _ => ?_
  show ConvOp.toLin (ConvOp.mapC (splitEquiv S)
    (ConvOp.compC none ((kapT R E).1 (SOut S)) ((kapT R E).1 (SIn S)))) x = 0
  rw [ConvOp.mapC_apply, ConvOp.toLin_compC, LinearMap.comp_apply, LinearMap.comp_apply]
  have hx' : SymSpecies.map (R := R) (splitEquiv S).symm x
      ∈ wtEqL R (GrSpecies.Shift E R) n _ := by
    rw [symMap_eq]
    exact map_mem_wtEqL _ hx
  have hk := decomp_mem_wtEqL (none : SOut S) hx'
  have hle : (⨆ (a : ℕ) (b : ℕ) (_ : a + b = n), LinearMap.range (TensorProduct.map
      (wtEqL R (GrSpecies.Shift E R) a (SOut S)).subtype
      (wtEqL R (GrSpecies.Shift E R) b (SIn S)).subtype))
      ≤ LinearMap.ker (ConvOp.kap ((kapT R E).1 (SOut S)) ((kapT R E).1 (SIn S))) := by
    refine iSup_le fun a => iSup_le fun b => iSup_le fun hab => ?_
    rintro _ ⟨t, rfl⟩
    induction t using TensorProduct.induction_on with
    | zero => simp
    | tmul p q =>
      rw [LinearMap.mem_ker, TensorProduct.map_tmul,
        ConvOp.kap_tmul _ (ConvOp.parC_eq_self_iff.1 (isPar_kapT (SIn S))), kapT_apply,
        kapT_apply, ConvOp.toLin_of, ConvOp.toLin_of, Submodule.subtype_apply,
        Submodule.subtype_apply]
      by_cases hb : b = 1
      · have ha : a ≠ 1 := by omega
        have hp : GrSpecies.tw (R := R) true p.1 ∈ wtEqL R (GrSpecies.Shift E R) a (SOut S) := by
          rw [GrSpecies.tw_apply]
          exact add_mem (par_mem_wtEqL false p.2)
            (Submodule.smul_mem _ _ (par_mem_wtEqL true p.2))
        rw [kapL_vx ha (wtEqL_le_vx a hp), TensorProduct.zero_tmul]
      · rw [kapL_vx hb (wtEqL_le_vx b q.2), TensorProduct.tmul_zero]
    | add t t' ht ht' =>
      rw [LinearMap.mem_ker, map_add, map_add]
      rw [LinearMap.mem_ker] at ht ht'
      rw [ht, ht', add_zero]
  rw [LinearMap.mem_ker.1 (hle hk), map_zero, map_zero]

/-! ### The cooperad cogenerated by `sE` with corelations `s²R` -/

variable (R E r) in
/-- **The corelations** `s²R ⊆ T^c(sE)^{(2)}`: the trees with two vertices whose image under
`κ_T ⋆ κ_T`, the composite of the desuspensions of their two vertices, is a relation. -/
noncomputable def coRel (A : Type) [Fintype A] [DecidableEq A] : Submodule R (Cut R E A) :=
  wtEqL R (GrSpecies.Shift E R) 2 A ⊓
    (relSp R E r A).comap (ConvOp.toLin ((GrOperad.Inv.star R _ (kapT R E) (kapT R E)).1 A))

variable (R E r) in
/-- The kernel of the projection `T^c(sE) → T^c(sE)^{(2)}/s²R`: the corelations plus the trees
with a number of vertices other than two. -/
noncomputable def coRelKer (A : Type) [Fintype A] [DecidableEq A] : Submodule R (Cut R E A) :=
  coRel R E r A ⊔ ⨆ (n : ℕ) (_ : n ≠ 2), wtEqL R (GrSpecies.Shift E R) n A

variable (R E r) in
/-- **The cooperad `C(sE, s²R)` cogenerated by `sE` with corelations `s²R`**: the largest
subcooperad of `T^c(sE)` on which the projection `T^c(sE) → T^c(sE)^{(2)}/s²R` vanishes. -/
noncomputable def coquadSub : GrSubCooperad R (Cut R E) :=
  GrSubCooperad.cogen (coRelKer R E r)

/-- **The admissible elements are the kernel of `T^c(sE) → T^c(sE)^{(2)}/s²R`**, for quadratic
relators over a field of characteristic zero: `κ_T ⋆ κ_T` only sees the part with two vertices,
which it sends into the trees with two vertices, where the ideal of the relators is `R`. -/
theorem admissible_eq [CharZero R] (hq : IsQuadratic R E r) (A : Type) [Fintype A]
    [DecidableEq A] : admissible R E r A = coRelKer R E r A := by
  refine le_antisymm (fun x hx => ?_) (sup_le (fun x hx => relSp_le_ideal hx.2)
    (iSup₂_le fun n hn x hx => ?_))
  · have hx' : x ∈ wtEqL R (GrSpecies.Shift E R) 2 A
        ⊔ ⨆ (n : ℕ) (_ : n ≠ 2), wtEqL R (GrSpecies.Shift E R) n A := by
      rw [← iSup_split_single (fun n => wtEqL R (GrSpecies.Shift E R) n A) 2, iSup_wtEqL]
      exact Submodule.mem_top
    obtain ⟨y, hy, z, hz, rfl⟩ := Submodule.mem_sup.1 hx'
    have hz0 : z ∈ LinearMap.ker
        (ConvOp.toLin ((GrOperad.Inv.star R _ (kapT R E) (kapT R E)).1 A)) :=
      (iSup₂_le fun n hn w hw => LinearMap.mem_ker.2 (star_wtEqL hn hw) :
        (⨆ (n : ℕ) (_ : n ≠ 2), wtEqL R (GrSpecies.Shift E R) n A) ≤ _) hz
    have hy' : ConvOp.toLin ((GrOperad.Inv.star R _ (kapT R E) (kapT R E)).1 A) y
        ∈ (GrOperadIdeal.span R r).sub A := by
      have := Submodule.mem_comap.1 hx
      rwa [map_add, LinearMap.mem_ker.1 hz0, add_zero] at this
    refine add_mem (Submodule.mem_sup_left ⟨hy, ?_⟩) (Submodule.mem_sup_right hz)
    rw [SetLike.mem_coe, Submodule.mem_comap, ← ideal_inf_vx_two hq]
    exact ⟨hy', star_mem_vx y⟩
  · show ConvOp.toLin ((GrOperad.Inv.star R _ (kapT R E) (kapT R E)).1 A) x
      ∈ (GrOperadIdeal.span R r).sub A
    rw [star_wtEqL hn hx]
    exact zero_mem _

/-- **The Koszul dual cooperad of quadratic data is the cooperad cogenerated by `sE` with
corelations `s²R`**: `P^¡ = C(sE, s²R)`, over a field of characteristic zero. -/
theorem dualSub_eq_coquadSub [CharZero R] (hq : IsQuadratic R E r) :
    dualSub R E r = coquadSub R E r := by
  unfold dualSub coquadSub
  congr 1
  funext A _ _
  exact admissible_eq hq A

/-- **The trees with two vertices of the Koszul dual cooperad are corelations**: `P^¡ ∩
T^c(sE)^{(2)} ⊆ s²R`, for quadratic relators over a field of characteristic zero. -/
theorem dual_inf_wtEqL_le [CharZero R] (hq : IsQuadratic R E r) :
    (dualSub R E r).sub A ⊓ wtEqL R (GrSpecies.Shift E R) 2 A ≤ coRel R E r A := by
  rintro x ⟨hx, h2⟩
  refine ⟨h2, ?_⟩
  rw [SetLike.mem_coe, Submodule.mem_comap, ← ideal_inf_vx_two hq]
  exact ⟨GrSubCooperad.cogen_le (admissible R E r) A hx, star_mem_vx x⟩

end Koszul

end Quadratic

end Operad
