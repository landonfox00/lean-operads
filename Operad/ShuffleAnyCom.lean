/-
# The commutative operad: a quadratic Gröbner basis, its PBW basis, and Koszulness

The shuffle operad of the commutative operad is generated by one binary operation `μ`, the
generator `Operad.ComGen` of the presentation of `Operad.ComSet`. In arity three it has three
monomials: the left comb `μ(μ(0, 1), 2)` (`ComGen.lcomb`), the twisted left comb `μ(μ(0, 2), 1)`
(`ComGen.tcomb`) and the right comb `μ(0, μ(1, 2))` (`ComGen.rcomb`). For the
path-lexicographic order whose letters are the inputs taken (`ComGen.order`) the right comb is the
least of the three — the word of the leaf `0` is shortest in it — and the **rules**
(`ComGen.rules`) rewrite the two left combs to it.

A rule is a monomial on the leaves `{0, 1, 2}`; it applies on any set of leaves through the
contexts, which substitute inputs increasing with their least leaves. So the two rules together
rewrite every vertex whose first input is a vertex, `μ(μ(x, y), z)`: by the left comb when the
least leaf of `y` is smaller than that of `z`, by the twisted left comb otherwise
(`ComGen.not_normal_of_get?`).

* **The normal monomials are the right combs** (`ComGen.normal_iff`), the trees in which the
  first input of every vertex is a leaf (`ComGen.IsComb`); on each nonempty set of leaves there is
  exactly one (`ComGen.existsUnique_normal`).
* **The rules are a Gröbner basis** (`ComGen.disjoint_normal`): the augmentation, sending every
  monomial to `1`, vanishes on the ideal generated by the rules, and is injective on the
  combinations of the single normal monomial. So every ambiguity is resolvable
  (`ComGen.res_amb`), the critical ones of arity four in particular, and the Buchberger criterion
  gives the PBW basis (`ComGen.basis`): the commutative operad is one-dimensional in every arity
  (`ComGen.finrank_eq_one`).
* **The commutative operad is Koszul** (`ComGen.isKoszul`), by
  `Operad.Rules.isKoszul_of_critical`. `Operad.ShuffleBinCom` proves it Koszul as a binary shuffle
  operad too (`Operad.ComBin.isKoszul_and`), separately.

The critical ambiguities are not resolved one at a time: their resolvability follows from the
independence of the normal monomials (`Operad.Rules.Amb.res_of_isCompl`), which the count of the
normal monomials gives directly.
-/
import Operad.ShuffleAnyKoszul
import Operad.ShuffleAnyOrder
import Operad.ComSet
import Mathlib.LinearAlgebra.Dimension.StrongRankCondition
import Mathlib.LinearAlgebra.FreeModule.StrongRankCondition

namespace Operad

open STree

namespace ComGen

/-! ## Binary trees -/

/-- **The product of two trees.** -/
def bin (x y : STree ComGen) : STree ComGen := node mu ![x, y]

/-- Every vertex is a product. -/
lemma node_eq_bin (c : Fin 2 → STree ComGen) : node mu c = bin (c 0) (c 1) := by
  rw [bin]
  congr 1
  funext i
  fin_cases i <;> rfl

/-- The least leaf of a product. -/
@[simp] lemma first_bin (x y : STree ComGen) : (bin x y).first = x.first := by
  rw [bin]
  exact first_node (k := 2) mu ![x, y] (by norm_num)

/-- The leaves of a product. -/
@[simp] lemma labels_bin (x y : STree ComGen) : (bin x y).labels = x.labels + y.labels := by
  simp [bin, Fin.sum_univ_two]

/-- Substitution in a product. -/
@[simp] lemma subst_bin (x y : STree ComGen) (xs : ℕ → STree ComGen) :
    (bin x y).subst xs = bin (x.subst xs) (y.subst xs) := by
  rw [bin, bin, subst_node]
  congr 1
  funext i
  fin_cases i <;> rfl

/-- **A product is a shuffle tree** when its factors are, in the order of their least leaves. -/
lemma isShuffle_bin {x y : STree ComGen} :
    (bin x y).IsShuffle ↔ x.IsShuffle ∧ y.IsShuffle ∧ x.first < y.first := by
  rw [bin, isShuffle_node, Fin.forall_fin_two]
  refine ⟨fun ⟨_, ⟨hx, hy⟩, hm⟩ => ⟨hx, hy, hm (show (0 : Fin 2) < 1 by decide)⟩,
    fun ⟨hx, hy, hxy⟩ => ⟨by norm_num, ⟨hx, hy⟩, Fin.strictMono_iff_lt_succ.2 fun i => ?_⟩⟩
  fin_cases i
  exact hxy

/-! ## Right combs -/

/-- **A right comb**: the first input of every vertex is a leaf. -/
def IsComb : STree ComGen → Prop
  | leaf _ => True
  | node mu c => (∃ a, c 0 = leaf a) ∧ IsComb (c 1)

/-- **A tree is a right comb, or has a vertex whose first input is a vertex.** -/
theorem isComb_or_occ : ∀ t : STree ComGen,
    IsComb t ∨ ∃ p x y z, t.get? p = some (bin (bin x y) z)
  | leaf _ => Or.inl trivial
  | node mu c => by
    cases h0 : c 0 with
    | leaf a =>
      rcases isComb_or_occ (c 1) with h | ⟨p, x, y, z, hp⟩
      · exact Or.inl ⟨⟨a, h0⟩, h⟩
      · exact Or.inr ⟨1 :: p, x, y, z, by rw [get?_node_cons, dif_pos (by norm_num)]; exact hp⟩
    | node e d =>
      cases e
      exact Or.inr ⟨[], d 0, d 1, c 1, by rw [get?_nil, node_eq_bin c, h0, node_eq_bin d]⟩

/-- **In a right comb, the first input of every vertex is a leaf.** -/
theorem IsComb.leaf_of_get? : ∀ {t : STree ComGen} {p : List ℕ} {c : Fin 2 → STree ComGen},
    IsComb t → t.get? p = some (node mu c) → ∃ a, c 0 = leaf a
  | leaf _, [], _, _, h => by simp at h
  | leaf _, _ :: _, _, _, h => by simp at h
  | node mu d, [], c, hd, h => by
    rw [get?_nil, Option.some_inj] at h
    cases h
    exact hd.1
  | node mu d, 0 :: p, c, hd, h => by
    obtain ⟨a, ha⟩ := hd.1
    rw [get?_node_cons, dif_pos (by norm_num)] at h
    change (d 0).get? p = _ at h
    rw [ha] at h
    cases p <;> simp at h
  | node mu d, 1 :: p, c, hd, h => by
    rw [get?_node_cons, dif_pos (by norm_num)] at h
    exact IsComb.leaf_of_get? hd.2 h
  | node mu d, (i + 2) :: p, c, hd, h => by
    rw [get?_node_cons, dif_neg (by omega)] at h
    simp at h

/-- **Two right combs on the same leaves are equal.** -/
theorem eq_of_isComb : ∀ {s t : STree ComGen}, s.IsShuffle → t.IsShuffle → IsComb s →
    IsComb t → s.labels = t.labels → s = t
  | leaf a, leaf b, _, _, _, _, h => by
    rw [labels_leaf, labels_leaf, Multiset.singleton_inj] at h
    rw [h]
  | leaf a, node mu d, _, ht, _, hct, h => by
    obtain ⟨⟨b, hb⟩, -⟩ := hct
    have := congrArg Multiset.card h
    simp only [node_eq_bin d, labels_bin, hb, labels_leaf, Multiset.card_add,
      Multiset.card_singleton] at this
    have hne := Multiset.card_pos_iff_exists_mem.2 ⟨_, first_mem (ht.child 1)⟩
    omega
  | node mu c, leaf b, hs, _, hcs, _, h => by
    obtain ⟨⟨a, ha⟩, -⟩ := hcs
    have := congrArg Multiset.card h
    simp only [node_eq_bin c, labels_bin, ha, labels_leaf, Multiset.card_add,
      Multiset.card_singleton] at this
    have hne := Multiset.card_pos_iff_exists_mem.2 ⟨_, first_mem (hs.child 1)⟩
    omega
  | node mu c, node mu d, hs, ht, hcs, hct, h => by
    obtain ⟨⟨a, ha⟩, hs1⟩ := hcs
    obtain ⟨⟨b, hb⟩, ht1⟩ := hct
    have hab : a = b := by
      have := first_eq_of_labels_eq hs ht h
      rwa [node_eq_bin c, node_eq_bin d, first_bin, first_bin, ha, hb, first_leaf,
        first_leaf] at this
    subst hab
    have hl : (c 1).labels = (d 1).labels := by
      rw [node_eq_bin c, node_eq_bin d, labels_bin, labels_bin, ha, hb] at h
      exact add_left_cancel h
    rw [node_eq_bin c, node_eq_bin d, ha, hb, eq_of_isComb (hs.child 1) (ht.child 1) hs1 ht1 hl]

/-- **The right comb on a list of leaves.** -/
def combL : List ℕ → STree ComGen
  | [] => leaf 0
  | [a] => leaf a
  | a :: b :: l => bin (leaf a) (combL (b :: l))

/-- **The right comb on an increasing list** is a shuffle tree and a right comb, with the list as
its leaves. -/
theorem combL_spec : ∀ (a : ℕ) (l : List ℕ), (a :: l).Pairwise (· < ·) →
    (combL (a :: l)).IsShuffle ∧ (combL (a :: l)).first = a ∧
      (combL (a :: l)).labels = ↑(a :: l) ∧ IsComb (combL (a :: l))
  | a, [], _ => ⟨trivial, rfl, rfl, trivial⟩
  | a, b :: l, h => by
    obtain ⟨h1, h2, h3, h4⟩ := combL_spec b l (List.pairwise_cons.1 h).2
    refine ⟨isShuffle_bin.2 ⟨trivial, h1, ?_⟩, first_bin _ _, ?_, ⟨a, rfl⟩, h4⟩
    · rw [first_leaf, h2]
      exact (List.pairwise_cons.1 h).1 b List.mem_cons_self
    · show (bin (leaf a) (combL (b :: l))).labels = _
      rw [labels_bin, h3, labels_leaf, Multiset.singleton_add, Multiset.cons_coe]

/-- **A right comb on every nonempty set of leaves.** -/
theorem exists_isComb {A : Finset ℕ} (hA : A.Nonempty) : ∃ t : SMono ComGen A, IsComb t.1 := by
  obtain ⟨a, l, hl⟩ : ∃ a l, A.sort (· ≤ ·) = a :: l := by
    cases h : A.sort (· ≤ ·) with
    | nil =>
      have := Finset.length_sort (s := A) (r := (· ≤ ·))
      rw [h, List.length_nil] at this
      exact absurd this.symm (Finset.card_pos.2 hA).ne'
    | cons a l => exact ⟨a, l, rfl⟩
  have hp : (a :: l).Pairwise (· < ·) := hl ▸ (Finset.sortedLT_sort A).pairwise
  obtain ⟨h1, -, h3, h4⟩ := combL_spec a l hp
  exact ⟨⟨combL (a :: l), h1, by rw [h3, ← hl, Finset.sort_eq]⟩, h4⟩

/-! ## The rules -/

/-- **The leaves in arity three.** -/
abbrev three : Finset ℕ := {0, 1, 2}

/-- **The left comb** `μ(μ(0, 1), 2)`. -/
def lcomb : SMono ComGen three :=
  ⟨bin (bin (leaf 0) (leaf 1)) (leaf 2), by simp [isShuffle_bin], by decide⟩

/-- **The twisted left comb** `μ(μ(0, 2), 1)`. -/
def tcomb : SMono ComGen three :=
  ⟨bin (bin (leaf 0) (leaf 2)) (leaf 1), by simp [isShuffle_bin], by decide⟩

/-- **The right comb** `μ(0, μ(1, 2))`. -/
def rcomb : SMono ComGen three :=
  ⟨bin (leaf 0) (bin (leaf 1) (leaf 2)), by simp [isShuffle_bin], by decide⟩

/-- **The letters of the path words**: the input taken. -/
@[nolint unusedArguments]
def letter : ∀ k, ComGen k → ℕ → ℕ := fun _ _ i => i

/-- **The path-lexicographic order** on the shuffle monomials of `ComGen`. -/
def order : AdmOrder ComGen := pathLexOrder letter

/-- The right comb is smaller than the left comb: the word of the leaf `0` is shorter. -/
lemma rcomb_lt_lcomb : pathLex letter rcomb lcomb := by
  refine ⟨⟨0, by simp⟩, fun j hj => (Nat.not_lt_zero _ hj).elim, ?_⟩
  show DegLex (word letter rcomb.1 0) (word letter lcomb.1 0)
  rw [word, word, pos_eq rcomb.nodup (q := [0]) rfl, pos_eq lcomb.nodup (q := [0, 0]) rfl]
  exact Or.inl (by decide)

/-- The right comb is smaller than the twisted left comb: the word of the leaf `0` is shorter. -/
lemma rcomb_lt_tcomb : pathLex letter rcomb tcomb := by
  refine ⟨⟨0, by simp⟩, fun j hj => (Nat.not_lt_zero _ hj).elim, ?_⟩
  show DegLex (word letter rcomb.1 0) (word letter tcomb.1 0)
  rw [word, word, pos_eq rcomb.nodup (q := [0]) rfl, pos_eq tcomb.nodup (q := [0, 0]) rfl]
  exact Or.inl (by decide)

variable (K : Type*) [CommRing K]

/-- **The rules of the commutative operad**: the left comb and the twisted left comb rewrite to
the right comb. -/
noncomputable def rules : Rules K Bool order.toCtxOrder where
  src _ := three
  lead r := if r then lcomb else tcomb
  tail _ := Finsupp.single rcomb 1
  tail_lt r m hm := by
    rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hm)]
    cases r
    · exact rcomb_lt_tcomb
    · exact rcomb_lt_lcomb

variable {K}

/-! ## The normal monomials are the right combs -/

/-- **Three inputs**, for the leaves `0`, `1` and `2`. -/
def ins (x y z : STree ComGen) : ℕ → STree ComGen
  | 0 => x
  | 1 => y
  | _ => z

/-- Three inputs increasing with their least leaves. -/
lemma strictMonoOn_ins {x y z : STree ComGen} (hxy : x.first < y.first)
    (hyz : y.first < z.first) :
    StrictMonoOn (fun a => (ins x y z a).first) ((three : Finset ℕ) : Set ℕ) := by
  intro a ha b hb hab
  simp only [Finset.coe_insert, Finset.coe_singleton, Set.mem_insert_iff,
    Set.mem_singleton_iff] at ha hb
  rcases ha with rfl | rfl | rfl <;> rcases hb with rfl | rfl | rfl <;>
    first | omega | (simp only [ins]; omega)

/-- **A monomial with a vertex whose first input is a vertex is not normal**: the leading
monomial `μ(μ(0, 1), 2)` or `μ(μ(0, 2), 1)` occurs there, as the least leaf of the second input
of the inner vertex is smaller or larger than that of the second input of the outer one. -/
theorem not_normal_of_get? {A : Finset ℕ} (t : SMono ComGen A) {p : List ℕ}
    {x y z : STree ComGen} (hp : t.1.get? p = some (bin (bin x y) z)) :
    ¬ (rules K).Normal t := by
  have hu := isShuffle_get? t.isShuffle hp
  have hn : (bin (bin x y) z).labels.Nodup := Multiset.nodup_of_le (labels_get?_le hp) t.nodup
  rw [isShuffle_bin, isShuffle_bin, first_bin] at hu
  obtain ⟨⟨hx, hy, hxy⟩, hz, hxz⟩ := hu
  rw [labels_bin, labels_bin, Multiset.nodup_add] at hn
  have hyz : y.first ≠ z.first := fun h => Multiset.disjoint_left.1 hn.2.2
    (Multiset.mem_add.2 (Or.inr (first_mem hy))) (h ▸ first_mem hz)
  intro hN
  rcases lt_or_gt_of_ne hyz with h | h
  · have hU : t.1.get? p = some (((rules K).lead true).1.subst (ins x y z)) := by
      rw [hp]
      show _ = some ((bin (bin (leaf 0) (leaf 1)) (leaf 2)).subst _)
      rw [subst_bin, subst_bin]
      rfl
    exact hN true _ (isSCtx_ctxOf t p _ _ hU (strictMonoOn_ins hxy h))
      (ctxOf_self t p _ _ hU (strictMonoOn_ins hxy h))
  · have hU : t.1.get? p = some (((rules K).lead false).1.subst (ins x z y)) := by
      rw [hp]
      show _ = some ((bin (bin (leaf 0) (leaf 2)) (leaf 1)).subst _)
      rw [subst_bin, subst_bin]
      rfl
    exact hN false _ (isSCtx_ctxOf t p _ _ hU (strictMonoOn_ins hxz h))
      (ctxOf_self t p _ _ hU (strictMonoOn_ins hxz h))

/-- **A normal monomial is a right comb.** -/
theorem isComb_of_normal {A : Finset ℕ} {t : SMono ComGen A} (h : (rules K).Normal t) :
    IsComb t.1 :=
  (isComb_or_occ t.1).resolve_right fun ⟨_, _, _, _, hp⟩ => not_normal_of_get? t hp h

/-- **A right comb is normal.** -/
theorem normal_of_isComb {A : Finset ℕ} {t : SMono ComGen A} (h : IsComb t.1) :
    (rules K).Normal t := by
  intro r f hf hft
  obtain ⟨p, xs, hp, -, -⟩ := IsSCtx.normal hf ((rules K).lead r)
  rw [hft] at hp
  cases r <;> obtain ⟨a, ha⟩ := h.leaf_of_get? hp <;> cases ha

/-- **The normal monomials are the right combs.** -/
theorem normal_iff {A : Finset ℕ} {t : SMono ComGen A} : (rules K).Normal t ↔ IsComb t.1 :=
  ⟨isComb_of_normal, normal_of_isComb⟩

/-- **There is at most one normal monomial on each set of leaves.** -/
theorem normal_unique {A : Finset ℕ} {s t : SMono ComGen A} (hs : (rules K).Normal s)
    (ht : (rules K).Normal t) : s = t :=
  Subtype.ext (eq_of_isComb s.isShuffle t.isShuffle (isComb_of_normal hs) (isComb_of_normal ht)
    (s.labels_eq.trans t.labels_eq.symm))

/-- **On every nonempty set of leaves there is exactly one normal monomial**, the right comb. -/
theorem existsUnique_normal {A : Finset ℕ} (hA : A.Nonempty) :
    ∃! t : SMono ComGen A, (rules K).Normal t := by
  obtain ⟨t, ht⟩ := exists_isComb hA
  exact ⟨t, normal_of_isComb ht, fun s hs => normal_unique hs (normal_of_isComb ht)⟩

/-! ## The Gröbner basis -/

variable (K) in
/-- **The augmentation**: every monomial to `1`. -/
noncomputable def aug (A : Finset ℕ) : (SMono ComGen A →₀ K) →ₗ[K] K :=
  Finsupp.linearCombination K fun _ => 1

/-- **The augmentation vanishes on the ideal generated by the rules**: a relation is the
difference of two monomials. -/
theorem ideal_le_ker_aug (A : Finset ℕ) :
    ((rules K).rw A).ideal ≤ LinearMap.ker (aug K A) := by
  rw [Rules.ideal_eq_span]
  refine Submodule.span_le.2 ?_
  rintro _ ⟨r, f, -, rfl⟩
  rw [SetLike.mem_coe, LinearMap.mem_ker, aug, Finsupp.linearCombination_mapDomain, map_sub,
    Finsupp.linearCombination_single]
  show _ - Finsupp.linearCombination K _ (Finsupp.single rcomb 1) = 0
  rw [Finsupp.linearCombination_single]
  exact sub_self _

/-- **The normal monomials are independent modulo the ideal generated by the rules**: there is
at most one, and the augmentation detects it. -/
theorem disjoint_normal (A : Finset ℕ) :
    Disjoint (Finsupp.supported K K {t : SMono ComGen A | (rules K).Normal t})
      ((rules K).rw A).ideal := by
  rw [Submodule.disjoint_def]
  intro v hv hI
  have hv' := (Finsupp.mem_supported K v).1 hv
  have h0 : aug K A v = 0 := ideal_le_ker_aug A hI
  ext m
  by_cases hm : m ∈ v.support
  · have hs : v.support ⊆ {m} := fun n hn =>
      Finset.mem_singleton.2 (normal_unique (hv' hn) (hv' hm))
    rw [Finsupp.support_subset_singleton.1 hs] at h0
    simpa [aug] using h0
  · rw [Finsupp.notMem_support_iff.1 hm, Finsupp.zero_apply]

/-- **Every ambiguity of the rules is resolvable**, the critical ones in particular. -/
theorem res_amb {C : Finset ℕ} {r₁ r₂ : Bool} (B : (rules K).Amb C r₁ r₂) : B.Res :=
  B.res_of_isCompl (disjoint_normal C)

/-! ## PBW and Koszul -/

/-- **The leading monomials are quadratic.** -/
lemma weight_lead (r : Bool) : ((rules K).lead r).1.weight = 2 := by
  cases r <;> rfl

/-- **The tails are quadratic.** -/
lemma weight_tail (r : Bool) : ∀ m ∈ ((rules K).tail r).support, m.1.weight = 2 :=
  fun m hm => by
    rw [Finset.mem_singleton.1 (Finsupp.support_single_subset hm)]
    rfl

/-- **The commutative operad is Koszul**: its rules are a quadratic Gröbner basis for the
path-lexicographic order. -/
theorem isKoszul : (rules K).IsKoszul :=
  (rules K).isKoszul_of_critical weight_lead weight_tail fun B _ => res_amb B

/-- **The PBW basis of the commutative operad**: on every set of leaves, the normal monomials
are a basis of the quotient by the ideal generated by the rules. -/
noncomputable def basis (A : Finset ℕ) :
    Module.Basis ((rules K).rw A).Irr K ((SMono ComGen A →₀ K) ⧸ ((rules K).rw A).ideal) :=
  STree.basisOfCritical (rules K) ((rules K).hlead_of_quad weight_lead) (fun B _ => res_amb B) A

/-- **The commutative operad is one-dimensional** on every nonempty set of leaves. -/
theorem finrank_eq_one [Nontrivial K] {A : Finset ℕ} (hA : A.Nonempty) :
    Module.finrank K ((SMono ComGen A →₀ K) ⧸ ((rules K).rw A).ideal) = 1 := by
  rw [Module.finrank_eq_nat_card_basis (basis A), Nat.card_eq_one_iff_exists]
  obtain ⟨t, ht, hu⟩ := existsUnique_normal (K := K) hA
  exact ⟨⟨t, (rules K).mem_irr_iff.2 ht⟩,
    fun y => Subtype.ext (hu y.1 ((rules K).mem_irr_iff.1 y.2))⟩

end ComGen

end Operad
