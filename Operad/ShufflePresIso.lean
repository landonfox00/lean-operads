/-
# Isomorphisms out of presented shuffle operads

Tools to prove that the morphism `Operad.Rules.presLift` out of a shuffle operad presented by
rules is an isomorphism onto the underlying shuffle operad of a symmetric operad.

* **Isomorphisms of shuffle operads** (`Operad.ShuffleOperadIso`), and a morphism with bijective
  components as one (`Operad.ShuffleOperadIso.ofBijective`).
* **The monomials of arity three on generators of arity two are composites of the generators**
  (`Operad.FreeSh.single_eq_comp_zero`, `Operad.FreeSh.single_eq_comp_one`): `g (h (a, b), c)` is
  the shuffle composite of `g` and `h` at the first input, `g (a, h (b, c))` the one at the
  second. So a morphism out of the free shuffle operad sends them to the composites of the values
  of the generators (`Operad.FreeSh.app_left`, `Operad.FreeSh.app_twist`,
  `Operad.FreeSh.app_right`).
* **Relations on the leaves `0, …, n - 1`** hold as soon as the lift of the free shuffle operad
  kills them (`Operad.Rules.holds_of_lift`); in the presented operad a leading monomial is its
  tail (`Operad.Rules.proj_lead_eq`).
* **Surjectivity** (`Operad.Rules.presLift_surjective`): if a symmetric operad `X` is a quotient
  of the free symmetric operad on generators `T` without operations of arity zero, and the images
  of the relabelled generators are values of the lift, then the lift is onto in every arity. The
  underlying shuffle operad of the free symmetric operad is generated by the relabelled generators
  (`Operad.FreeSet.fromSh`).
* **Bijectivity** (`Operad.Rules.presLift_bijective`): over a field, if moreover the two operads
  have the same finite dimension on every nonempty finite linear order. In arity zero a presented
  shuffle operad vanishes (`Operad.Rules.subsingleton_presented`).
* **Linearized set operads**: the free set operad maps onto a presented one
  (`Operad.Pres.ofFree_surjective`), and a shuffle composite of basis elements is a basis element
  (`Operad.Lin.shuffle_comp_single`).
* **Quotients of free binary operads**: the three monomials of arity three are the relabelled
  composites of the generators (`Operad.FreeBin.map_e0_comp`, `Operad.FreeBin.map_e0t_comp`,
  `Operad.FreeBin.map_e1_comp`), so a morphism sending the generators to classes of generators
  sends the shuffle monomials to the classes of `binL` and `binR`
  (`Operad.FreeSh.app_left_bin`, `Operad.FreeSh.app_twist_bin`, `Operad.FreeSh.app_right_bin`);
  the Jacobi rule from the antisymmetry and Jacobi relators (`Operad.FreeBin.jacobi_rule_mem`).

`Operad.ShuffleIsoComAss` and `Operad.ShuffleIsoPoisLie` apply this to `Com`, `Ass`, `Pois` and
`Lie`.
-/
import Operad.PoisPBW

universe u v w x

namespace Operad

/-! ## Isomorphisms of shuffle operads -/

section Iso

variable {R : Type u} [CommRing R]
  {P : (A : Type) → [Fintype A] → [LinearOrder A] → Type v}
  [∀ (A : Type) [Fintype A] [LinearOrder A], AddCommGroup (P A)]
  [∀ (A : Type) [Fintype A] [LinearOrder A], Module R (P A)] [ShuffleOperad R P]
  {Q : (A : Type) → [Fintype A] → [LinearOrder A] → Type w}
  [∀ (A : Type) [Fintype A] [LinearOrder A], AddCommGroup (Q A)]
  [∀ (A : Type) [Fintype A] [LinearOrder A], Module R (Q A)] [ShuffleOperad R Q]

namespace ShuffleOperadHom

/-- **The inverse of a morphism with bijective components.** -/
noncomputable def invOfBijective (φ : ShuffleOperadHom R P Q)
    (h : ∀ (A : Type) [Fintype A] [LinearOrder A], Function.Bijective (φ.app A)) :
    ShuffleOperadHom R Q P where
  app A _ _ := (LinearEquiv.ofBijective (φ.app A) (h A)).symm.toLinearMap
  app_map e y := by
    apply (h _).1
    simp only [LinearEquiv.coe_coe, LinearEquiv.apply_ofBijective_symm_apply, φ.app_map]
  app_one := by
    apply (h _).1
    simp only [LinearEquiv.coe_coe, LinearEquiv.apply_ofBijective_symm_apply, φ.app_one]
  app_comp i e he x y := by
    apply (h _).1
    simp only [LinearEquiv.coe_coe, LinearEquiv.apply_ofBijective_symm_apply, φ.app_comp]

lemma app_invOfBijective (φ : ShuffleOperadHom R P Q)
    (h : ∀ (A : Type) [Fintype A] [LinearOrder A], Function.Bijective (φ.app A))
    (A : Type) [Fintype A] [LinearOrder A] (y : Q A) :
    φ.app A ((φ.invOfBijective h).app A y) = y :=
  LinearEquiv.apply_ofBijective_symm_apply (φ.app A) (h := h A) y

lemma invOfBijective_app (φ : ShuffleOperadHom R P Q)
    (h : ∀ (A : Type) [Fintype A] [LinearOrder A], Function.Bijective (φ.app A))
    (A : Type) [Fintype A] [LinearOrder A] (x : P A) :
    (φ.invOfBijective h).app A (φ.app A x) = x :=
  (h A).1 (app_invOfBijective φ h A (φ.app A x))

end ShuffleOperadHom

variable (R P Q) in
/-- **An isomorphism of shuffle operads**: two morphisms inverse to each other. -/
structure ShuffleOperadIso where
  /-- The forward morphism. -/
  hom : ShuffleOperadHom R P Q
  /-- The inverse morphism. -/
  inv : ShuffleOperadHom R Q P
  hom_inv_id : inv.comp hom = ShuffleOperadHom.id
  inv_hom_id : hom.comp inv = ShuffleOperadHom.id

namespace ShuffleOperadIso

@[simp] lemma inv_hom_apply (e : ShuffleOperadIso R P Q) (A : Type) [Fintype A] [LinearOrder A]
    (x : P A) : e.inv.app A (e.hom.app A x) = x :=
  congrArg (fun φ : ShuffleOperadHom R P P => φ.app A x) e.hom_inv_id

@[simp] lemma hom_inv_apply (e : ShuffleOperadIso R P Q) (A : Type) [Fintype A] [LinearOrder A]
    (y : Q A) : e.hom.app A (e.inv.app A y) = y :=
  congrArg (fun φ : ShuffleOperadHom R Q Q => φ.app A y) e.inv_hom_id

/-- **The components of an isomorphism are linear equivalences.** -/
def linearEquiv (e : ShuffleOperadIso R P Q) (A : Type) [Fintype A] [LinearOrder A] :
    P A ≃ₗ[R] Q A :=
  LinearEquiv.ofLinear (e.hom.app A) (e.inv.app A)
    (LinearMap.ext fun y => e.hom_inv_apply A y) (LinearMap.ext fun x => e.inv_hom_apply A x)

lemma bijective (e : ShuffleOperadIso R P Q) (A : Type) [Fintype A] [LinearOrder A] :
    Function.Bijective (e.hom.app A) :=
  (e.linearEquiv A).bijective

/-- **A morphism with bijective components is an isomorphism.** -/
noncomputable def ofBijective (φ : ShuffleOperadHom R P Q)
    (h : ∀ (A : Type) [Fintype A] [LinearOrder A], Function.Bijective (φ.app A)) :
    ShuffleOperadIso R P Q where
  hom := φ
  inv := φ.invOfBijective h
  hom_inv_id := ShuffleOperadHom.ext fun A _ _ x => ShuffleOperadHom.invOfBijective_app φ h A x
  inv_hom_id := ShuffleOperadHom.ext fun A _ _ y => ShuffleOperadHom.app_invOfBijective φ h A y

@[simp] lemma ofBijective_hom (φ : ShuffleOperadHom R P Q)
    (h : ∀ (A : Type) [Fintype A] [LinearOrder A], Function.Bijective (φ.app A)) :
    (ofBijective φ h).hom = φ := rfl

end ShuffleOperadIso

end Iso

/-! ## Monomials of arity three as composites of generators -/

namespace STree

variable {E : ℕ → Type v}

/-- **A vertex of arity two** with its two inputs. -/
def bnode (g : E 2) (x y : STree E) : STree E := node g ![x, y]

end STree

namespace FreeSh

open STree PoisDim FreeBin

variable (R : Type u) [CommRing R] {E : ℕ → Type v}

/-- **A generator of arity two**, as an operation of the free shuffle operad. -/
noncomputable def gen₂ (g : E 2) : FreeSh R E (Fin 2) :=
  Finsupp.single (genM (by norm_num) g) 1

variable {R}

/-- **Grafting two corollas at the first input.** -/
lemma graft_gen_zero {C : Type} [Fintype C] [LinearOrder C]
    {e : Without (Fin 2) 0 ⊕ Fin 2 ≃ C} (he : Operad.IsShuffle (0 : Fin 2) e) (g h : E 2) :
    (STree.graft he (genM (E := E) (by norm_num) g) (genM (E := E) (by norm_num) h)).1 =
      bnode g (bnode h (leaf (opos (e (.inr 0)))) (leaf (opos (e (.inr 1)))))
        (leaf (opos (e (.inl ⟨1, by decide⟩)))) := by
  show (STree.node g fun j : Fin 2 => leaf j.1).subst
      (graftFam (0 : Fin 2) e (STree.node (E := E) h fun j : Fin 2 => leaf j.1)) = _
  rw [subst_node, bnode]
  congr 1
  funext j
  fin_cases j
  · simp only [Fin.zero_eta, Fin.isValue, subst, Matrix.cons_val_zero]
    have h0 := graftFam_opos (i := (0 : Fin 2)) (e := e)
      (node (E := E) h fun j : Fin 2 => leaf j.1)
    rw [opos_fin, show ((0 : Fin 2) : ℕ) = 0 from rfl] at h0
    rw [h0, relabel, subst_node, bnode]
    congr 1
    funext j
    fin_cases j
    · show leaf (posR (0 : Fin 2) e ((0 : Fin 2) : ℕ)) = _
      rw [← opos_fin (0 : Fin 2), posR_opos]
      rfl
    · show leaf (posR (0 : Fin 2) e ((1 : Fin 2) : ℕ)) = _
      rw [← opos_fin (1 : Fin 2), posR_opos]
      rfl
  · simp only [Fin.mk_one, Fin.isValue, subst, Matrix.cons_val_one]
    have h0 := graftFam_ne (i := (0 : Fin 2)) (e := e)
      (node (E := E) h fun j : Fin 2 => leaf j.1) (1 : Fin 2) (by decide)
    rw [opos_fin, show ((1 : Fin 2) : ℕ) = 1 from rfl] at h0
    rw [h0]
    rfl

/-- **Grafting two corollas at the second input.** -/
lemma graft_gen_one {C : Type} [Fintype C] [LinearOrder C]
    {e : Without (Fin 2) 1 ⊕ Fin 2 ≃ C} (he : Operad.IsShuffle (1 : Fin 2) e) (g h : E 2) :
    (STree.graft he (genM (E := E) (by norm_num) g) (genM (E := E) (by norm_num) h)).1 =
      bnode g (leaf (opos (e (.inl ⟨0, by decide⟩))))
        (bnode h (leaf (opos (e (.inr 0)))) (leaf (opos (e (.inr 1))))) := by
  show (STree.node g fun j : Fin 2 => leaf j.1).subst
      (graftFam (1 : Fin 2) e (STree.node (E := E) h fun j : Fin 2 => leaf j.1)) = _
  rw [subst_node, bnode]
  congr 1
  funext j
  fin_cases j
  · simp only [Fin.zero_eta, Fin.isValue, subst, Matrix.cons_val_zero]
    have h0 := graftFam_ne (i := (1 : Fin 2)) (e := e)
      (node (E := E) h fun j : Fin 2 => leaf j.1) (0 : Fin 2) (by decide)
    rw [opos_fin, show ((0 : Fin 2) : ℕ) = 0 from rfl] at h0
    rw [h0]
  · simp only [Fin.mk_one, Fin.isValue, subst, Matrix.cons_val_one]
    have h0 := graftFam_opos (i := (1 : Fin 2)) (e := e)
      (node (E := E) h fun j : Fin 2 => leaf j.1)
    rw [opos_fin, show ((1 : Fin 2) : ℕ) = 1 from rfl] at h0
    rw [h0, relabel, subst_node, bnode]
    congr 1
    funext j
    fin_cases j
    · show leaf (posR (1 : Fin 2) e ((0 : Fin 2) : ℕ)) = _
      rw [← opos_fin (0 : Fin 2), posR_opos]
      rfl
    · show leaf (posR (1 : Fin 2) e ((1 : Fin 2) : ℕ)) = _
      rw [← opos_fin (1 : Fin 2), posR_opos]
      rfl

/-- **A monomial `g (h (a, b), c)` is a composite at the first input** of the generators, along
the shuffle placing the inputs of `h` at `a`, `b` and the second input of `g` at `c`. -/
theorem single_eq_comp_zero {C : Type} [Fintype C] [LinearOrder C]
    {e : Without (Fin 2) 0 ⊕ Fin 2 ≃ C} (he : Operad.IsShuffle (0 : Fin 2) e) {g h : E 2}
    {m : SMono E (Finset.range (Fintype.card C))}
    (hm : m.1 = bnode g (bnode h (leaf (opos (e (.inr 0)))) (leaf (opos (e (.inr 1)))))
      (leaf (opos (e (.inl ⟨1, by decide⟩))))) :
    (Finsupp.single m 1 : FreeSh R E C) =
      ShuffleOperad.comp (R := R) (P := FreeSh R E) (0 : Fin 2) e he (gen₂ R g) (gen₂ R h) := by
  show _ = FreeSh.bil (STree.graft he) _ _
  rw [gen₂, gen₂, FreeSh.bil_single, mul_one]
  congr 1
  exact Subtype.ext (hm.trans (graft_gen_zero he g h).symm)

/-- **A monomial `g (a, h (b, c))` is a composite at the second input** of the generators. -/
theorem single_eq_comp_one {C : Type} [Fintype C] [LinearOrder C]
    {e : Without (Fin 2) 1 ⊕ Fin 2 ≃ C} (he : Operad.IsShuffle (1 : Fin 2) e) {g h : E 2}
    {m : SMono E (Finset.range (Fintype.card C))}
    (hm : m.1 = bnode g (leaf (opos (e (.inl ⟨0, by decide⟩))))
      (bnode h (leaf (opos (e (.inr 0)))) (leaf (opos (e (.inr 1)))))) :
    (Finsupp.single m 1 : FreeSh R E C) =
      ShuffleOperad.comp (R := R) (P := FreeSh R E) (1 : Fin 2) e he (gen₂ R g) (gen₂ R h) := by
  show _ = FreeSh.bil (STree.graft he) _ _
  rw [gen₂, gen₂, FreeSh.bil_single, mul_one]
  congr 1
  exact Subtype.ext (hm.trans (graft_gen_one he g h).symm)

variable {P : (A : Type) → [Fintype A] → [LinearOrder A] → Type w}
  [∀ (A : Type) [Fintype A] [LinearOrder A], AddCommGroup (P A)]
  [∀ (A : Type) [Fintype A] [LinearOrder A], Module R (P A)] [ShuffleOperad R P]
  (ψ : ShuffleOperadHom R (FreeSh R E) P)

/-- **The value of `g (h (0, 1), 2)`** under a morphism out of the free shuffle operad. -/
theorem app_left {g h : E 2} {m : SMono E (Finset.range (Fintype.card (Fin 3)))}
    (hm : m.1 = bnode g (bnode h (leaf 0) (leaf 1)) (leaf 2)) :
    ψ.app (Fin 3) (Finsupp.single m 1) =
      ShuffleOperad.comp (R := R) (0 : Fin 2) e0 isShuffle_e0
        (ψ.app (Fin 2) (gen₂ R g)) (ψ.app (Fin 2) (gen₂ R h)) := by
  rw [← ψ.app_comp, ← single_eq_comp_zero isShuffle_e0 (m := m)]
  rw [hm]
  simp only [opos_fin]
  rfl

/-- **The value of `g (h (0, 2), 1)`** under a morphism out of the free shuffle operad. -/
theorem app_twist {g h : E 2} {m : SMono E (Finset.range (Fintype.card (Fin 3)))}
    (hm : m.1 = bnode g (bnode h (leaf 0) (leaf 2)) (leaf 1)) :
    ψ.app (Fin 3) (Finsupp.single m 1) =
      ShuffleOperad.comp (R := R) (0 : Fin 2) (e0.trans τ₁₂) isShuffle_e0'
        (ψ.app (Fin 2) (gen₂ R g)) (ψ.app (Fin 2) (gen₂ R h)) := by
  rw [← ψ.app_comp, ← single_eq_comp_zero isShuffle_e0' (m := m)]
  rw [hm]
  simp only [opos_fin]
  rfl

/-- **The value of `g (0, h (1, 2))`** under a morphism out of the free shuffle operad. -/
theorem app_right {g h : E 2} {m : SMono E (Finset.range (Fintype.card (Fin 3)))}
    (hm : m.1 = bnode g (leaf 0) (bnode h (leaf 1) (leaf 2))) :
    ψ.app (Fin 3) (Finsupp.single m 1) =
      ShuffleOperad.comp (R := R) (1 : Fin 2) e1 isShuffle_e1
        (ψ.app (Fin 2) (gen₂ R g)) (ψ.app (Fin 2) (gen₂ R h)) := by
  rw [← ψ.app_comp, ← single_eq_comp_one isShuffle_e1 (m := m)]
  rw [hm]
  simp only [opos_fin]
  rfl

end FreeSh

/-! ## Relations, surjectivity and bijectivity of the lift -/

section Lift

open STree

variable {R : Type u} [CommRing R]
  {P : (A : Type) → [Fintype A] → [LinearOrder A] → Type w}
  [∀ (A : Type) [Fintype A] [LinearOrder A], AddCommGroup (P A)]
  [∀ (A : Type) [Fintype A] [LinearOrder A], Module R (P A)] [ShuffleOperad R P]
  {E : ℕ → Type v} {ρ : Type*} {O : AdmOrder E} {G : Rules R ρ O.toCtxOrder}
  {φ : ∀ k, E k → P (Fin k)}

/-- **Relations on the leaves `0, …, n - 1` hold when the lift kills them**: the values of the
generators satisfy the relations of rules whose leaves are the positions of some `Fin n` as soon
as the lift of the free shuffle operad vanishes on `lead - tail`. -/
theorem Rules.holds_of_lift
    (h : ∀ r, ∃ (n : ℕ) (hn : G.src r = Finset.range (Fintype.card (Fin n))),
      (FreeSh.lift R P φ).app (Fin n)
        (Finsupp.mapDomain (SMono.cast hn) (Finsupp.single (G.lead r) 1 - G.tail r)) = 0) :
    G.Holds φ := by
  intro r
  obtain ⟨n, hn, h0⟩ := h r
  have h1 : FreeSh.liftApp R P φ (Fin n)
      (Finsupp.mapDomain (SMono.cast hn) (Finsupp.single (G.lead r) 1 - G.tail r)) = 0 := h0
  rw [FreeSh.liftApp_eq_evL, map_eq_zero_iff, evL_cast, castN_eq_zero_iff] at h1
  exact h1

/-- **A leading monomial is its tail in the presented shuffle operad**, for a rule on the leaves
`0, …, n - 1`. -/
theorem Rules.proj_lead_eq (G : Rules R ρ O.toCtxOrder) (r : ρ) {n : ℕ}
    (hn : G.src r = Finset.range (Fintype.card (Fin n))) :
    G.shuffleIdeal.projHom.app (Fin n) (Finsupp.single (SMono.cast hn (G.lead r)) 1) =
      G.shuffleIdeal.projHom.app (Fin n) (Finsupp.mapDomain (SMono.cast hn) (G.tail r)) := by
  have h : Finsupp.mapDomain (SMono.cast hn) (Finsupp.single (G.lead r) 1 - G.tail r) ∈
      G.shuffleIdeal.sub (Fin n) := G.ideal_cast hn (G.rel_mem_ideal r)
  have h' := (Submodule.Quotient.mk_eq_zero _).2 h
  rw [Finsupp.mapDomain_sub, Finsupp.mapDomain_single, Submodule.Quotient.mk_sub,
    sub_eq_zero] at h'
  exact h'

/-- **There is no shuffle monomial without leaves.** -/
lemma STree.isEmpty_smono_empty : IsEmpty (SMono E ∅) :=
  ⟨fun t => absurd (t.2.2 ▸ STree.first_mem t.2.1) (Multiset.notMem_zero _)⟩

/-- **A presented shuffle operad has no operation without inputs.** -/
lemma Rules.subsingleton_presented (A : Type) [Fintype A] [LinearOrder A] [IsEmpty A] :
    Subsingleton (G.Presented A) := by
  have hc : Finset.range (Fintype.card A) = ∅ := by rw [Fintype.card_eq_zero, Finset.range_zero]
  haveI : IsEmpty (SMono E (Finset.range (Fintype.card A))) := by
    rw [hc]
    exact STree.isEmpty_smono_empty
  haveI : Subsingleton (FreeSh R E A) := inferInstanceAs (Subsingleton (_ →₀ R))
  exact (G.shuffleIdeal.proj_surjective A).subsingleton

end Lift

section Sym

open STree

variable {R : Type u} [CommRing R]
  {X : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (X A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (X A)] [SymOperad R X]
  {E : ℕ → Type v} {ρ : Type*} {O : AdmOrder E} {G : Rules R ρ O.toCtxOrder}
  {φ : ∀ k, E k → Shuf X (Fin k)} {T : ℕ → Type x} [IsEmpty (T 0)]

/-- **The lift is onto a quotient of a free symmetric operad** when the images of the relabelled
generators are among its values: the underlying shuffle operad of the free symmetric operad is
generated by the relabelled generators. -/
theorem Rules.presLift_surjective (hφ : G.Holds φ)
    (π : SymOperadHom R (Lin R (FreeSet T)) X)
    (hπ : ∀ (A : Type) [Fintype A] [DecidableEq A], Function.Surjective (π.app A))
    (hgen : ∀ k (s : SGen T k),
      π.app (Fin k) (Finsupp.single (SetOperad.map s.2.symm (Pres.gen s.1)) 1) ∈
        LinearMap.range ((G.presLift hφ).app (Fin k)))
    (A : Type) [Fintype A] [LinearOrder A] : Function.Surjective ((G.presLift hφ).app A) := by
  choose γ hγ using hgen
  intro y
  obtain ⟨x, rfl⟩ := hπ A y
  refine ⟨(FreeSh.lift R G.Presented γ).app A ((FreeSet.toSh R T).app A x), ?_⟩
  have key := FreeSh.hom_ext (ψ₁ := (G.presLift hφ).comp (FreeSh.lift R G.Presented γ))
    (ψ₂ := π.toShuffle.comp (FreeSet.fromSh R T)) (fun k hk g => by
      show (G.presLift hφ).app (Fin k) ((FreeSh.lift R G.Presented γ).app (Fin k)
          (Finsupp.single (FreeSh.genM hk g) 1)) =
        π.app (Fin k) ((FreeSet.fromSh R T).app (Fin k) (Finsupp.single (FreeSh.genM hk g) 1))
      rw [FreeSh.lift_gen, FreeSet.fromSh_gen]
      exact hγ k g) A ((FreeSet.toSh R T).app A x)
  have key' : (G.presLift hφ).app A ((FreeSh.lift R G.Presented γ).app A
      ((FreeSet.toSh R T).app A x)) =
      π.app A ((FreeSet.fromSh R T).app A ((FreeSet.toSh R T).app A x)) := key
  rw [key', FreeSet.fromSh_toSh]

end Sym

section Field

open STree

variable {K : Type u} [Field K]
  {X : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (X A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (X A)] [SymOperad K X]
  {E : ℕ → Type v} {ρ : Type*} {O : AdmOrder E} {G : Rules K ρ O.toCtxOrder}
  {φ : ∀ k, E k → Shuf X (Fin k)}

/-- A surjective linear map between spaces of the same positive finite dimension is bijective. -/
lemma bijective_of_surjective_of_finrank_eq {V : Type*} {W : Type*} [AddCommGroup V] [Module K V]
    [AddCommGroup W] [Module K W] (f : V →ₗ[K] W) (hf : Function.Surjective f)
    (h : Module.finrank K V = Module.finrank K W) (hpos : 0 < Module.finrank K V) :
    Function.Bijective f := by
  haveI : Module.Finite K V := Module.finite_of_finrank_pos hpos
  haveI : Module.Finite K W := Module.finite_of_finrank_pos (h ▸ hpos)
  exact ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank h).2 hf, hf⟩

/-- **The lift is bijective** when it is surjective and the two operads have the same positive
finite dimension on every nonempty finite linear order. In arity zero the presented operad
vanishes. -/
theorem Rules.presLift_bijective (hφ : G.Holds φ)
    (hsurj : ∀ (A : Type) [Fintype A] [LinearOrder A],
      Function.Surjective ((G.presLift hφ).app A))
    (hdim : ∀ (A : Type) [Fintype A] [LinearOrder A] [Nonempty A],
      Module.finrank K (G.Presented A) = Module.finrank K (X A) ∧
        0 < Module.finrank K (G.Presented A))
    (A : Type) [Fintype A] [LinearOrder A] : Function.Bijective ((G.presLift hφ).app A) := by
  rcases isEmpty_or_nonempty A with hA | hA
  · haveI := Rules.subsingleton_presented (G := G) A
    exact ⟨fun _ _ _ => Subsingleton.elim _ _, hsurj A⟩
  · exact bijective_of_surjective_of_finrank_eq _ (hsurj A) (hdim A).1 (hdim A).2

end Field

/-! ## Linearized set operads -/

/-- **The leaves `0, 1, 2` are the positions of `Fin 3`.** -/
lemma three_eq_range : ({0, 1, 2} : Finset ℕ) = Finset.range (Fintype.card (Fin 3)) := by
  rw [Fintype.card_fin]
  rfl

namespace Pres

variable {T : ℕ → Type x}
  {ρ : ∀ {A : Type} [Fintype A] [DecidableEq A], Syn T A → Syn T A → Prop}

/-- **The quotient map from the free set operad** to the set operad presented by relations. -/
def ofFree : SetOperadHom (FreeSet T) (Pres T ρ) := FreeSet.homEquiv.symm fun _ g => Pres.gen g

lemma ofFree_mk {A : Type} [Fintype A] [DecidableEq A] (x : Syn T A) :
    (ofFree (ρ := ρ)).app A (Pres.mk x) = Pres.mk x := by
  rw [Pres.app_mk, Pres.mk_eq_eval]
  rfl

lemma ofFree_surjective (A : Type) [Fintype A] [DecidableEq A] :
    Function.Surjective ((ofFree (T := T) (ρ := ρ)).app A) := fun y => by
  obtain ⟨x, rfl⟩ := Pres.mk_surjective y
  exact ⟨Pres.mk x, ofFree_mk x⟩

end Pres

section LinSet

variable (R : Type u) [CommRing R]
  {S : (A : Type) → [Fintype A] → [DecidableEq A] → Type v} [SetOperad S]
  {S' : (A : Type) → [Fintype A] → [DecidableEq A] → Type w} [SetOperad S']

/-- **The linearization of a surjective morphism of set operads is surjective.** -/
lemma SetOperadHom.lin_surjective (f : SetOperadHom S S') {A : Type} [Fintype A] [DecidableEq A]
    (hf : Function.Surjective (f.app A)) : Function.Surjective ((f.lin R).app A) :=
  Finsupp.mapDomain_surjective hf

/-- **A shuffle composite of basis elements** of a linearized set operad is the basis element of
the relabelled composite. -/
lemma Lin.shuffle_comp_single {A B C : Type} [Fintype A] [LinearOrder A] [Fintype B]
    [LinearOrder B] [Fintype C] [LinearOrder C] (i : A) (e : Without A i ⊕ B ≃ C)
    (he : IsShuffle i e) (s : S A) (t : S B) :
    ShuffleOperad.comp (R := R) (P := Shuf (Lin R S)) i e he (Finsupp.single s 1)
      (Finsupp.single t 1) = Finsupp.single (SetOperad.map e (SetOperad.comp i s t)) 1 := by
  rw [SymOperad.toShuffle_comp]
  show Lin.mapL R e (Lin.compL R i _ _) = _
  rw [Lin.compL_single, Lin.mapL_single, mul_one]

end LinSet

/-! ## Quotients of free binary operads -/

section BinQuot

open FreeBin PoisDim STree

variable {K : Type u} [Field K] {G : Type} [Fintype G] [DecidableEq G]

namespace FreeBin

/-- `g (h (x₀, x₁), x₂)` is the composite of the generators at the first input. -/
lemma map_e0_comp (g h : G) :
    SymOperad.map (R := K) e0 (SymOperad.comp (R := K) 0 (bin2 g 1) (bin2 h 1)) =
      binL (R := K) g h 1 := by
  have h1 := comp_e0_bin2 (R := K) g h 1 1
  simp only [if_true] at h1
  exact h1

/-- `g (h (x₀, x₂), x₁)` is the composite of the generators at the first input, the last two
inputs exchanged. -/
lemma map_e0t_comp (g h : G) :
    SymOperad.map (R := K) (e0.trans τ₁₂) (SymOperad.comp (R := K) 0 (bin2 g 1) (bin2 h 1)) =
      binL (R := K) g h τ₁₂ := by
  refine Eq.symm ?_
  rw [← SymOperad.map_map, map_e0_comp, ← mono3_false, map_binL, mul_one]

/-- `g (x₀, h (x₁, x₂))` is the composite of the generators at the second input. -/
lemma map_e1_comp (g h : G) :
    SymOperad.map (R := K) e1 (SymOperad.comp (R := K) 1 (bin2 g 1) (bin2 h 1)) =
      binR (R := K) g h 1 := by
  have h1 := comp_e1_bin2 (R := K) g h 1 1
  simp only [if_true] at h1
  exact h1

variable {r₂ : Set (FreeBin K G (Fin 2))} {r₃ : Set (FreeBin K G (Fin 3))}

/-- **Antisymmetry at the root**: `b (h (x₀, x₁), x₂) + b (x₂, h (x₀, x₁))`, relabelled, is a
relation. -/
lemma outer_anti_mem {b : G} (hb : BinRel.antisymm K b ∈ r₂) (h : G) (π : Equiv.Perm (Fin 3)) :
    binL (R := K) b h π + binR b h (π * perm3 2 0 1) ∈
      (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 3) := by
  have h0 : BinRel.antisymm K b ∈ (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 2) :=
    SymOperadIdeal.subset_span (r := rel23 r₂ r₃) 2 hb
  have h1 := (SymOperadIdeal.span K (rel23 r₂ r₃)).map_mem π
    ((SymOperadIdeal.span K (rel23 r₂ r₃)).map_mem e0
      ((SymOperadIdeal.span K (rel23 r₂ r₃)).comp_mem_left 0 (bin2 h 1) h0))
  rw [BinRel.antisymm, map_add, LinearMap.add_apply, map_add, map_add, comp_e0_bin2,
    comp_e0_bin2, if_pos rfl, if_neg swap_ne_one, if_pos rfl, if_pos rfl, map_binL, map_binR,
    mul_one] at h1
  exact h1

/-- **Antisymmetry at the first input**: `g (b (x₀, x₁), x₂) + g (b (x₁, x₀), x₂)`, relabelled,
is a relation. -/
lemma inner_anti_mem {b : G} (hb : BinRel.antisymm K b ∈ r₂) (g : G) (π : Equiv.Perm (Fin 3)) :
    binL (R := K) g b π + binL g b (π * perm3 1 0 2) ∈
      (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 3) := by
  have h0 : BinRel.antisymm K b ∈ (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 2) :=
    SymOperadIdeal.subset_span (r := rel23 r₂ r₃) 2 hb
  have h1 := (SymOperadIdeal.span K (rel23 r₂ r₃)).map_mem π
    ((SymOperadIdeal.span K (rel23 r₂ r₃)).map_mem e0
      ((SymOperadIdeal.span K (rel23 r₂ r₃)).comp_mem_right 0 (bin2 g 1) h0))
  rw [BinRel.antisymm, map_add, map_add, map_add, comp_e0_bin2, comp_e0_bin2, if_pos rfl,
    if_pos rfl, if_pos rfl, if_neg swap_ne_one, map_binL, map_binL, mul_one] at h1
  exact h1

/-- **The Jacobi rule** `[[x₀, x₁], x₂] = [[x₀, x₂], x₁] + [x₀, [x₁, x₂]]` is a relation of an
operad presented with the antisymmetry and the Jacobi relators of `b` among its relators. -/
theorem jacobi_rule_mem {b : G} (hb₂ : BinRel.antisymm K b ∈ r₂) (hb₃ : BinRel.jacobi K b ∈ r₃) :
    binL (R := K) b b 1 - binL b b τ₁₂ - binR b b 1 ∈
      (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 3) := by
  have hJ : BinRel.jacobi K b ∈ (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 3) :=
    SymOperadIdeal.subset_span (r := rel23 r₂ r₃) 3 hb₃
  have h1 := outer_anti_mem (r₃ := r₃) hb₂ b (perm3 1 2 0)
  have h2 := inner_anti_mem (r₃ := r₃) hb₂ b (perm3 2 0 1)
  rw [perm_a] at h1
  rw [perm_b] at h2
  rw [BinRel.jacobi] at hJ
  convert sub_mem (sub_mem hJ h1) h2 using 1
  abel

omit [Fintype G] [DecidableEq G] in
/-- **A transposed generator is the generator up to sign** modulo the antisymmetry relator. -/
lemma proj_bin2_swap_anti {b : G} (hb : BinRel.antisymm K b ∈ r₂) :
    (SymOperadIdeal.span K (rel23 r₂ r₃)).proj (Fin 2) (bin2 b (Equiv.swap 0 1)) =
      -(SymOperadIdeal.span K (rel23 r₂ r₃)).proj (Fin 2) (bin2 b 1) := by
  have h0 : BinRel.antisymm K b ∈ (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 2) :=
    SymOperadIdeal.subset_span (r := rel23 r₂ r₃) 2 hb
  rw [← (SymOperadIdeal.span K (rel23 r₂ r₃)).proj_eq_zero_iff, BinRel.antisymm, map_add] at h0
  exact eq_neg_of_add_eq_zero_right h0

omit [Fintype G] [DecidableEq G] in
/-- **A transposed generator is the generator** modulo the commutativity relator. -/
lemma proj_bin2_swap_comm {b : G} (hb : BinRel.comm K b ∈ r₂) :
    (SymOperadIdeal.span K (rel23 r₂ r₃)).proj (Fin 2) (bin2 b (Equiv.swap 0 1)) =
      (SymOperadIdeal.span K (rel23 r₂ r₃)).proj (Fin 2) (bin2 b 1) := by
  have h0 : BinRel.comm K b ∈ (SymOperadIdeal.span K (rel23 r₂ r₃)).sub (Fin 2) :=
    SymOperadIdeal.subset_span (r := rel23 r₂ r₃) 2 hb
  rw [← (SymOperadIdeal.span K (rel23 r₂ r₃)).proj_eq_zero_iff, BinRel.comm, map_sub] at h0
  exact (sub_eq_zero.1 h0).symm

end FreeBin

namespace FreeSh

variable {X : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (X A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (X A)] [SymOperad K X]
  (π : SymOperadHom K (FreeBin K G) X) {E : ℕ → Type v}
  (ψ : ShuffleOperadHom K (FreeSh K E) (Shuf X)) {g h : E 2} {a b : G}

/-- **The value of `g (h (0, 1), 2)`** when the generators go to images of generators of a free
binary operad. -/
theorem app_left_bin (hg : ψ.app (Fin 2) (gen₂ K g) = π.app (Fin 2) (bin2 a 1))
    (hh : ψ.app (Fin 2) (gen₂ K h) = π.app (Fin 2) (bin2 b 1))
    {m : SMono E (Finset.range (Fintype.card (Fin 3)))}
    (hm : m.1 = bnode g (bnode h (leaf 0) (leaf 1)) (leaf 2)) :
    ψ.app (Fin 3) (Finsupp.single m 1) = π.app (Fin 3) (binL a b 1) := by
  rw [app_left ψ hm, hg, hh, SymOperad.toShuffle_comp, ← π.app_comp, ← π.app_map,
    FreeBin.map_e0_comp]

/-- **The value of `g (h (0, 2), 1)`**. -/
theorem app_twist_bin (hg : ψ.app (Fin 2) (gen₂ K g) = π.app (Fin 2) (bin2 a 1))
    (hh : ψ.app (Fin 2) (gen₂ K h) = π.app (Fin 2) (bin2 b 1))
    {m : SMono E (Finset.range (Fintype.card (Fin 3)))}
    (hm : m.1 = bnode g (bnode h (leaf 0) (leaf 2)) (leaf 1)) :
    ψ.app (Fin 3) (Finsupp.single m 1) = π.app (Fin 3) (binL a b τ₁₂) := by
  rw [app_twist ψ hm, hg, hh, SymOperad.toShuffle_comp, ← π.app_comp, ← π.app_map,
    FreeBin.map_e0t_comp]

/-- **The value of `g (0, h (1, 2))`**. -/
theorem app_right_bin (hg : ψ.app (Fin 2) (gen₂ K g) = π.app (Fin 2) (bin2 a 1))
    (hh : ψ.app (Fin 2) (gen₂ K h) = π.app (Fin 2) (bin2 b 1))
    {m : SMono E (Finset.range (Fintype.card (Fin 3)))}
    (hm : m.1 = bnode g (leaf 0) (bnode h (leaf 1) (leaf 2))) :
    ψ.app (Fin 3) (Finsupp.single m 1) = π.app (Fin 3) (binR a b 1) := by
  rw [app_right ψ hm, hg, hh, SymOperad.toShuffle_comp, ← π.app_comp, ← π.app_map,
    FreeBin.map_e1_comp]

end FreeSh

end BinQuot

end Operad
