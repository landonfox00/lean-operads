/-
# Graded composites are generated by corollas under the right action

For a graded operad `C`, the graded composite `V ∘ C` is spanned by the corollas `w ⊗ (1, …, 1)`
(`GrComposite.corolla`) under relabelling and the right action of `C`
(`GrComposite.induction_act`): an inner operation is the result of composing it into a unit
(`GrComposite.map_act_ext`), the other inner operations moving across it with the Koszul sign.
-/
import Operad.FreeGrRoot

universe u v w

namespace Operad

open Function Sym GerBV

namespace GrComposite

/-! ## Replacing a fibre by a single input -/

section Ext

variable {S A : Type} [DecidableEq S] [DecidableEq A] (f : S → A) (a₀ : A)

/-- **The inputs not owned by `a₀`, and one input owned by `a₀`.** -/
abbrev Ext : Type := {s : S // f s ≠ a₀} ⊕ Unit

/-- The owners of the inputs of `Ext f a₀`. -/
def extOwner : Ext f a₀ → A := Sum.elim (fun s => f s.1) fun _ => a₀

/-- The single input owned by `a₀`. -/
def extUnit {a : A} (h : a₀ = a) : Unit ≃ Fib (extOwner f a₀) a where
  toFun _ := ⟨Sum.inr (), h⟩
  invFun _ := ()
  left_inv _ := rfl
  right_inv := by
    rintro ⟨⟨s, hs⟩ | ⟨⟩, h'⟩
    · exact absurd (h'.trans h.symm) hs
    · rfl

/-- The inputs owned by another input of the outer operation are unchanged. -/
def extIncl {a : A} (h : a₀ ≠ a) : Fib f a ≃ Fib (extOwner f a₀) a where
  toFun s := ⟨Sum.inl ⟨s.1, fun e => h (e.symm.trans s.2)⟩, s.2⟩
  invFun s := match s with
    | ⟨Sum.inl t, ht⟩ => ⟨t.1, ht⟩
    | ⟨Sum.inr _, ht⟩ => absurd ht (Ne.symm h).symm
  left_inv _ := rfl
  right_inv := by
    rintro ⟨t | ⟨⟩, ht⟩
    · rfl
    · exact absurd ht h

/-- **After composing at the new input, the inputs are those of `S`.** -/
def extEquiv : Without (Ext f a₀) (Sum.inr ()) ⊕ Fib f a₀ ≃ S where
  toFun x := match x with
    | Sum.inl ⟨Sum.inl s, _⟩ => s.1
    | Sum.inl ⟨Sum.inr (), h⟩ => absurd rfl h
    | Sum.inr t => t.1
  invFun s := if h : f s = a₀ then Sum.inr ⟨s, h⟩ else Sum.inl ⟨Sum.inl ⟨s, h⟩, Sum.inl_ne_inr⟩
  left_inv := by
    rintro (⟨⟨s, hs⟩ | ⟨⟩, h⟩ | ⟨t, ht⟩)
    · simp [hs]
    · exact absurd rfl h
    · simp [ht]
  right_inv s := by
    by_cases h : f s = a₀ <;> simp [h]

lemma extOwner_extEquiv :
    actOwner (Y := Fib f a₀) (extOwner f a₀) (Sum.inr ()) ∘ (extEquiv f a₀).symm = f := by
  funext s
  by_cases h : f s = a₀
  · simp [extEquiv, h, actOwner, extOwner]
  · simp [extEquiv, h, actOwner, extOwner]

end Ext

variable {R : Type u} [CommRing R]
  {V : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (V A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (V A)] [GrSpecies R V]
  {C : (A : Type) → [Fintype A] → [DecidableEq A] → Type w}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (C A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module R (C A)] [GrOperad R C]

/-! ## Composing into a unit -/

section ActExt

variable {S A : Type} [Fintype S] [DecidableEq S] [Fintype A] [DecidableEq A]

/-- The inner operations with the unit at `a₀`. -/
noncomputable def extY (f : S → A) (yy : ∀ a, C (Fib f a)) (a₀ : A) (a : A) :
    C (Fib (extOwner f a₀) a) :=
  if h : a₀ = a then GrOperad.map (R := R) (extUnit f a₀ h) (GrOperad.one (R := R))
  else GrOperad.map (R := R) (extIncl f a₀ h) (yy a)

/-- **Composing an inner operation into a unit** gives it back, the inner operations read after
it moving across it. -/
lemma map_act_ext (L : LinOrd A) (w : V A) (f : S → A) (yy : ∀ a, C (Fib f a)) (c : A → Bool)
    (hyy : ∀ a, GrOperad.par (R := R) (c a) (yy a) = yy a) (a₀ : A) :
    map (extEquiv f a₀) (act R V (Sum.inr ()) (yy a₀)
        (mk R (ownGen L w (extOwner f a₀) (extY (R := R) f yy a₀))))
      = (∏ a, σ R ((c a₀ && ltB L a₀ a) && c a)) • mk R (ownGen L w f yy) := by
  rw [act_mk_ownGen, actOwn_hom L w _ _ _ (yy a₀) (hyy a₀), map_mk_ownGen,
    mk_ownGen_congr _ w (extOwner_extEquiv f a₀)]
  have hS := (mkY (R := R) (ownGen L w f yy)).map_smul_univ
    (fun a => σ R ((c a₀ && ltB L a₀ a) && c a)) yy
  refine Eq.trans ?_ hS
  show mk R (ownGen L w f _) = mk R (ownGen L w f fun a => _ • yy a)
  congr 2
  funext a
  show GrOperad.map (R := R) _ (GrOperad.map (R := R) _ (actLin (R := R) L (extOwner f a₀)
      (Sum.inr ()) (yy a₀) (c a₀) a (extY (R := R) f yy a₀ a))) = _
  by_cases h : a₀ = a
  · subst h
    have h1 := GrOperad.one_comp (R := R) (yy a₀)
    rw [actLin_eq L (extOwner f a₀) (Sum.inr ()) (yy a₀) (c a₀) a₀ rfl, extY, dif_pos rfl,
      GrOperad.comp_map_left (extUnit f a₀ rfl) () ⟨Sum.inr (), rfl⟩ rfl,
      show GrOperad.comp (R := R) () (GrOperad.one (R := R)) (yy a₀)
        = GrOperad.map (R := R) (leftUnitEquiv (Fib f a₀)).symm (yy a₀) by
          conv_rhs => rw [← h1]
          rw [← GrOperad.map_trans, Equiv.self_trans_symm, GrOperad.map_refl],
      ltB_self, Bool.and_false, Bool.false_and, σ_false, one_smul]
    simp only [← GrOperad.map_trans]
    refine (gmap_congr (e' := Equiv.refl _) ?_ _).trans (GrOperad.map_refl _)
    intro t
    exact Subtype.ext rfl
  · have hv : GrOperad.par (R := R) (c a) (GrOperad.map (R := R) (actNe (Y := Fib f a₀)
        (extOwner f a₀) (Sum.inr ()) a h) (GrOperad.map (R := R) (extIncl f a₀ h) (yy a)))
        = GrOperad.map (R := R) (actNe (Y := Fib f a₀) (extOwner f a₀) (Sum.inr ()) a h)
          (GrOperad.map (R := R) (extIncl f a₀ h) (yy a)) := by
      rw [← GrOperad.map_par, ← GrOperad.map_par, hyy]
    rw [actLin_ne L (extOwner f a₀) (Sum.inr ()) (yy a₀) (c a₀) a h, extY, dif_neg h,
      GrOperad.tw_hom _ hv, map_smul, map_smul]
    congr 1
    simp only [← GrOperad.map_trans]
    refine (gmap_congr (e' := Equiv.refl _) ?_ _).trans (GrOperad.map_refl _)
    intro t
    exact Subtype.ext rfl

end ActExt

/-! ## Generation by corollas -/

section Induction

variable (Pr : ∀ (S : Type) [Fintype S] [DecidableEq S], GrComposite R V C S → Prop)
  (h0 : ∀ (S : Type) [Fintype S] [DecidableEq S], Pr S 0)
  (hadd : ∀ (S : Type) [Fintype S] [DecidableEq S] (x y : GrComposite R V C S), Pr S x → Pr S y →
    Pr S (x + y))
  (hsmul : ∀ (S : Type) [Fintype S] [DecidableEq S] (r : R) (x : GrComposite R V C S), Pr S x →
    Pr S (r • x))
  (hmap : ∀ (S S' : Type) [Fintype S] [DecidableEq S] [Fintype S'] [DecidableEq S'] (σ : S ≃ S')
    (x : GrComposite R V C S), Pr S x → Pr S' (map σ x))
  (hact : ∀ (S Y : Type) [Fintype S] [DecidableEq S] [Fintype Y] [DecidableEq Y] (i : S)
    (z : C Y) (x : GrComposite R V C S), Pr S x → Pr (Without S i ⊕ Y) (act R V i z x))
  (hcor : ∀ (A : Type) [Fintype A] [DecidableEq A] (w : V A), Pr A (corolla R C A w))

include hmap hcor in
/-- A generator with units at every input is a relabelled corolla. -/
lemma induction_units {S A : Type} [Fintype S] [DecidableEq S] [Fintype A] [DecidableEq A]
    (L : LinOrd A) (w : V A) (f : S → A) (yy : ∀ a, C (Fib f a)) (e : ∀ a, Unit ≃ Fib f a)
    (he : ∀ a, yy a = GrOperad.map (R := R) (e a) (GrOperad.one (R := R))) :
    Pr S (mk R (ownGen L w f yy)) := by
  let τ : A ≃ S := ⟨fun a => (e a ()).1, f, fun a => (e a ()).2, fun s => by
    show ((e (f s)) ()).1 = s
    rw [show (e (f s)) () = ⟨s, rfl⟩ from by rw [← (e (f s)).apply_symm_apply ⟨s, rfl⟩]]⟩
  have h1 := hmap A S τ _ (hcor A w)
  rw [corolla_apply, map_mk, show (corGen (C := C) (R := R) (ordOf A) w (Equiv.refl A)).relabel τ
      = corGen (C := C) (R := R) (ordOf A) w τ from rfl,
    mk_corGen_reorder (C := C) (R := R) (ordOf A) L w τ,
    ← mk_inner (corGen (C := C) (R := R) L w τ) e] at h1
  convert h1 using 3
  · exact funext he
  · refine Equiv.ext fun x => ?_
    obtain ⟨a, t, ht⟩ := x
    show t = (e a ((e a).symm ⟨t, ht⟩)).1
    rw [Equiv.apply_symm_apply]

include hsmul hmap hact hcor in
/-- **Induction on the positions holding operations other than units.** -/
lemma induction_finset {A : Type} [Fintype A] [DecidableEq A] (L : LinOrd A) (w : V A)
    (F : Finset A) : ∀ (S : Type) [Fintype S] [DecidableEq S] (f : S → A)
    (yy : ∀ a, C (Fib f a)) (c : A → Bool), (∀ a, GrOperad.par (R := R) (c a) (yy a) = yy a) →
    (∀ a ∉ F, ∃ e : Unit ≃ Fib f a, yy a = GrOperad.map (R := R) e (GrOperad.one (R := R))) →
    Pr S (mk R (ownGen L w f yy)) := by
  induction F using Finset.induction_on with
  | empty =>
    intro S _ _ f yy c _ hu
    choose e he using fun a => hu a (Finset.notMem_empty a)
    exact induction_units Pr hmap hcor L w f yy e he
  | insert a₀ F ha₀ ih =>
    intro S _ _ f yy c hyy hu
    have h1 := ih (Ext f a₀) (extOwner f a₀) (extY (R := R) f yy a₀) (update c a₀ false)
      (fun a => by
        by_cases h : a₀ = a
        · subst h
          rw [update_self, extY, dif_pos rfl, ← GrOperad.map_par, GrOperad.par_one]
        · rw [update_of_ne (Ne.symm h), extY, dif_neg h, ← GrOperad.map_par, hyy])
      (fun a ha => by
        by_cases h : a₀ = a
        · exact ⟨extUnit f a₀ h, by rw [extY, dif_pos h]⟩
        · obtain ⟨e, he⟩ := hu a (by simp [Finset.mem_insert, Ne.symm h, ha])
          exact ⟨e.trans (extIncl f a₀ h), by rw [extY, dif_neg h, he, GrOperad.map_trans]⟩)
    have h2 := hmap _ S (extEquiv f a₀) _ (hact _ _ (Sum.inr ()) (yy a₀) _ h1)
    rw [map_act_ext L w f yy c hyy a₀] at h2
    have h3 := hsmul S (∏ a, σ R ((c a₀ && ltB L a₀ a) && c a)) _ h2
    rwa [smul_smul, ← Finset.prod_mul_distrib, Finset.prod_congr rfl fun a _ => σ_mul_self R _,
      Finset.prod_const_one, one_smul] at h3

include h0 hadd hsmul hmap hact hcor in
/-- **`V ∘ C` is generated by the corollas** under relabelling and the right action of `C`: a
property closed under linear combinations, relabelling and the action, and true on the corollas,
holds everywhere. -/
theorem induction_act {S : Type} [Fintype S] [DecidableEq S] (x : GrComposite R V C S) :
    Pr S x := by
  induction x using induction_on with
  | h0 => exact h0 S
  | hadd x y hx hy => exact hadd S x y hx hy
  | hsmul r x hx => exact hsmul S r x hx
  | hmk g =>
    rw [mk_eq_sum (R := R) g]
    refine Finset.sum_induction _ (Pr S) (hadd S) (h0 S) fun p _ => ?_
    refine Finset.sum_induction _ (Pr S) (hadd S) (h0 S) fun c _ => ?_
    rw [mk_eq_ownGen (R := R) (parGen (R := R) g p c)]
    refine induction_finset Pr hsmul hmap hact hcor _ _ Finset.univ S _ _ c (fun a => ?_)
      (fun a ha => absurd (Finset.mem_univ a) ha)
    show GrOperad.par (R := R) (c a) (GrOperad.map (R := R) _ (GrSpecies.par (R := R) (c a)
      (g.y a))) = _
    rw [← GrOperad.map_par]
    exact congrArg _ (GrOperad.par_par_self (R := R) (c a) (g.y a))

end Induction

end GrComposite

end Operad
