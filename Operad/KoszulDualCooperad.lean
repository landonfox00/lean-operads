/-
# The Koszul dual cooperad (planar)

`E` is a finite set of binary generators, and `Rel` a space of chains on the two-vertex trees:
planar binary quadratic data. `Operad.KoszulDual` defines the spaces `koszulDual Rel n` of
chains, slice-closed. This file makes them a cooperad, and identifies its dual.

* **The cooperad of chains** `TConv.TreeCoop R E`, over any commutative ring: the linear dual of
  the operad of scalar cochains on planar binary trees (`Operad.DualCooperad`). Its elements of
  arity `n` are the chains (`TConv.chainEquiv`), its counit is the value at the leaf
  (`TConv.counit_chainEquiv`), and **its decomposition ungrafts**
  (`TConv.decomp_chainEquiv`): `Δx = ∑ x(t₁ ∘ t₂) · t₁ ⊗ t₂`.
* **The subcooperad of a slice-closed collection** `C`, over a field: `TConv.SubCoop hC`, the
  dual of the convolution operad `HomOp C`. The transpose of the quotient map is an injective
  morphism of cooperads into the cooperad of chains (`TConv.SubCoop.incl`), **its image is `C`**
  (`TConv.SubCoop.equiv`, `TConv.SubCoop.range_chain`), and its decomposition is the
  restriction of ungrafting (`TConv.SubCoop.map_incl_decomp`, `TConv.SubCoop.decomp_pair`).
  **Duality**: `C(n)* ≅ HomOp C (n)` (`TConv.SubCoop.dualEquiv`).
* **The Koszul dual cooperad** `P^¡ = TConv.KoszulCoop Rel` and **the Koszul dual operad**
  `P^! = TConv.KoszulOp Rel`, the case `C = koszulDual Rel`. In arity `n`, `P^¡` is
  `koszulDual Rel n` (`TConv.KoszulCoop.equiv`): the functions on the generators in arity two
  (`TConv.KoszulCoop.equivGen`), the relations in arity three (`TConv.KoszulCoop.equivThree`),
  and in arity four the chains whose five slices at every corolla are relations
  (`TConv.KoszulCoop.mem_range_chain_four_iff`). **Duality**: `P^¡(n)* ≅ P^!(n)`
  (`TConv.KoszulCoop.dualEquiv`).
* **The Koszul dual operad is quadratic**: the cochains vanishing on the Koszul dual are the
  ideal generated by the orthogonal relations `TConv.perp Rel`, the cochains of arity three
  vanishing on `Rel` (`TConv.ann_koszulDual_eq_generated`). So `P^!` is the operad of cochains
  modulo the orthogonal relations, and **a chain is in the Koszul dual exactly when that ideal
  vanishes on it** (`TConv.mem_koszulDual_iff_forall_generated`): the Koszul dual in arity `n`
  is the intersection, over the windows, of the conditions that the chain restricts to a
  relation.

The universal property of the cooperad of chains among planar cooperads is not proved here.
The subcooperad and the dualities are over a field, with finitely many generators.
-/
import Operad.CooperadTranspose
import Operad.LowWeight

universe u v

namespace Operad

open NSOperad BTree TensorProduct Module

/-- The components of a quotient of an operad with finite components are finite. -/
instance OperadIdeal.finite_quot {R : Type u} [CommRing R] {P : ℕ → Type v}
    [∀ n, AddCommGroup (P n)] [∀ n, Module R (P n)] [NSOperad R P] (I : OperadIdeal R P) (n : ℕ)
    [Module.Finite R (P n)] : Module.Finite R (I.Quot n) :=
  inferInstanceAs (Module.Finite R (P n ⧸ I.carrier n))

namespace TConv

/-! ## The cooperad of chains on planar binary trees -/

section Chains

variable {R : Type u} [CommRing R] {E : Type v} [Fintype E] [DecidableEq E]

/-- Evaluation with scalar coefficients is symmetric in the cochain and the chain. -/
lemma eval_ass_comm {n : ℕ} (f : TConv R E (Ass R) n) (x : Chain R E n) :
    eval (Q := Ass R) f x = eval (Q := Ass R) x f := by
  rw [eval_apply, eval_apply]
  exact Finset.sum_congr rfl fun t _ => mul_comm _ _

/-- Every functional on chains is the evaluation of a cochain. -/
lemma exists_eval_eq {n : ℕ} (φ : Dual R (Chain R E n)) :
    ∃ f : TConv R E (Ass R) n, ∀ x, eval (Q := Ass R) f x = φ x := by
  refine ⟨fun t => φ (Pi.single t 1), fun x => ?_⟩
  rw [eval_apply]
  conv_rhs => rw [pi_eq_sum_univ' x, map_sum]
  refine Finset.sum_congr rfl fun t _ => ?_
  rw [map_smul]

variable (R E) in
/-- **The cooperad of chains on planar binary trees**: the linear dual of the operad of scalar
cochains. Its elements of arity `n` are the chains (`TConv.chainEquiv`), and its decomposition
ungrafts (`TConv.decomp_chainEquiv`). -/
abbrev TreeCoop : ℕ → Type (max u v) := DualFam R (TConv R E (Ass R))

variable (R E) in
/-- **The pairing of chains with scalar cochains**, `(x, f) ↦ ∑ₜ x(t) f(t)`. -/
noncomputable def evalB (n : ℕ) : Chain R E n →ₗ[R] TConv R E (Ass R) n →ₗ[R] R :=
  LinearMap.mk₂ R (fun x f => eval (Q := Ass R) f x)
    (fun x y f => map_add (eval (Q := Ass R) f) x y)
    (fun c x f => map_smul (eval (Q := Ass R) f) c x)
    (fun x f g => eval_add f g x)
    (fun c x f => eval_smul c f x)

lemma evalB_apply {n : ℕ} (x : Chain R E n) (f : TConv R E (Ass R) n) :
    evalB R E n x f = eval (Q := Ass R) f x := rfl

lemma evalB_bijective (n : ℕ) : Function.Bijective (evalB R E n) := by
  refine ⟨(injective_iff_map_eq_zero _).2 fun x hx => funext fun t => ?_, fun φ => ?_⟩
  · have h : eval (Q := Ass R) (Pi.single t (1 : R)) x = 0 :=
      LinearMap.congr_fun hx (Pi.single t (1 : R))
    rw [eval_ass_comm, eval_single, one_smul] at h
    exact h
  · obtain ⟨x, hx⟩ := exists_eval_eq (R := R) (E := E) (n := n) φ
    exact ⟨x, LinearMap.ext fun f => (eval_ass_comm f x).trans (hx f)⟩

variable (R E) in
/-- **Chains are the functionals on scalar cochains**, a chain `x` acting by `f ↦ ∑ₜ x(t) f(t)`. -/
noncomputable def chainEquiv (n : ℕ) : Chain R E n ≃ₗ[R] TreeCoop R E n :=
  LinearEquiv.ofBijective (evalB R E n) (evalB_bijective n)

@[simp] lemma chainEquiv_apply {n : ℕ} (x : Chain R E n) (f : TConv R E (Ass R) n) :
    chainEquiv R E n x f = eval (Q := Ass R) f x := rfl

/-- **The decomposition of the cooperad of chains is ungrafting**: the coefficient of the pair
of trees `(t₁, t₂)` in the decomposition of a chain is its value at the grafted tree. -/
theorem decomp_chainEquiv (a b n : ℕ) (x : Chain R E (a + n + b)) :
    NSCooperad.decomp (R := R) (C := TreeCoop R E) a b n (chainEquiv R E _ x) =
      ∑ p : OfArity E (a + 1 + b) × OfArity E n, x (OfArity.graft a b p.1 p.2) •
        (chainEquiv R E _ (Pi.single p.1 1) ⊗ₜ[R] chainEquiv R E _ (Pi.single p.2 1)) := by
  refine dualDistrib_injective (TensorProduct.ext' fun f g => ?_)
  show dualDistrib R _ _ (decompD a b n (chainEquiv R E _ x)) (f ⊗ₜ g) = _
  rw [dualDistrib_decompD, compT_tmul, map_sum, LinearMap.sum_apply]
  show eval (Q := Ass R) (compL a b f g) x = _
  rw [eval_comp_pairs]
  refine Finset.sum_congr rfl fun p _ => ?_
  rw [map_smul, LinearMap.smul_apply, dualDistrib_apply]
  show _ = x _ • (eval (Q := Ass R) f (Pi.single p.1 1) * eval (Q := Ass R) g (Pi.single p.2 1))
  rw [eval_single, eval_single, one_smul, one_smul]
  rfl

/-- The counit of the cooperad of chains is the value at the leaf. -/
lemma counit_chainEquiv (x : Chain R E 1) :
    NSCooperad.counit (R := R) (C := TreeCoop R E) (chainEquiv R E 1 x) = x OfArity.one := by
  show eval (Q := Ass R) (fun _ => (1 : R)) x = _
  rw [eval_apply, Fintype.sum_eq_single OfArity.one fun t ht => absurd (eq_one t) ht]
  exact mul_one _

/-- Composing with the indicator of a tree on the right evaluates on the outer slice. -/
lemma eval_comp_single_right (a b : ℕ) {n : ℕ} (f : TConv R E (Ass R) (a + 1 + b))
    (t₂ : OfArity E n) (x : Chain R E (a + n + b)) :
    eval (Q := Ass R) (compL a b f (Pi.single t₂ (1 : R))) x =
      eval (Q := Ass R) f (outerSlice a b t₂ x) := by
  rw [eval_comp_outer, Finset.sum_eq_single t₂]
  · rw [Pi.single_eq_same]
    exact mul_one _
  · intro s _ hs
    rw [Pi.single_eq_of_ne hs]
    exact mul_zero _
  · intro h
    exact absurd (Finset.mem_univ t₂) h

/-- Composing with the indicator of a tree on the left evaluates on the inner slice. -/
lemma eval_comp_single_left (a b : ℕ) {n : ℕ} (t₁ : OfArity E (a + 1 + b))
    (g : TConv R E (Ass R) n) (x : Chain R E (a + n + b)) :
    eval (Q := Ass R) (compL a b (Pi.single t₁ (1 : R)) g) x =
      eval (Q := Ass R) g (innerSlice a b t₁ x) := by
  rw [eval_comp_inner, Finset.sum_eq_single t₁]
  · rw [Pi.single_eq_same]
    exact one_mul _
  · intro s _ hs
    rw [Pi.single_eq_of_ne hs]
    exact zero_mul _
  · intro h
    exact absurd (Finset.mem_univ t₁) h

end Chains

/-! ## The subcooperad of a slice-closed collection -/

section Sub

variable {K : Type u} [Field K] {E : Type v} [Fintype E] [DecidableEq E]
  {C : ∀ n, Submodule K (Chain K E n)} (hC : SliceClosed K E C)

/-- **The cooperad of a slice-closed collection of chains**: the linear dual of its convolution
operad with scalar coefficients. Its elements of arity `n` are the chains of the collection
(`TConv.SubCoop.equiv`). -/
abbrev SubCoop : ℕ → Type (max u v) := DualFam K (HomOp (Ass K) hC)

namespace SubCoop

/-- **The inclusion into the cooperad of chains**: the transpose of the quotient map of the
convolution operad. -/
noncomputable def incl : NSCooperadHom K (SubCoop hC) (TreeCoop K E) :=
  (ann (Ass K) hC).projHom.dual

lemma incl_apply {n : ℕ} (φ : SubCoop hC n) (f : TConv K E (Ass K) n) :
    (incl hC).app n φ f = φ ((ann (Ass K) hC).proj n f) := rfl

/-- The inclusion is injective. -/
lemma incl_injective (n : ℕ) : Function.Injective ((incl hC).app n) :=
  NSOperadHom.dual_injective _ ((ann (Ass K) hC).proj_surjective n)

/-- Over a field, a chain killed by the annihilator of a collection is in the collection. -/
lemma mem_of_forall_ann {n : ℕ} {x : Chain K E n}
    (hx : ∀ f ∈ (ann (Ass K) hC).carrier n, eval (Q := Ass K) f x = 0) : x ∈ C n := by
  by_contra hxC
  obtain ⟨φ, hφx, hφ⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hxC inferInstance
  obtain ⟨f, hf⟩ := exists_eval_eq φ
  refine hφx ((hf x).symm.trans (hx f fun y hy => ?_))
  rw [hf]
  have h : φ y ∈ (C n).map φ := Submodule.mem_map_of_mem hy
  rw [hφ] at h
  exact (Submodule.mem_bot K).1 h

/-- **The chain of an element of the subcooperad.** -/
noncomputable def chain (n : ℕ) : SubCoop hC n →ₗ[K] Chain K E n :=
  (chainEquiv K E n).symm.toLinearMap ∘ₗ (incl hC).app n

lemma chainEquiv_chain {n : ℕ} (φ : SubCoop hC n) :
    chainEquiv K E n (chain hC n φ) = (incl hC).app n φ :=
  (chainEquiv K E n).apply_symm_apply _

/-- **An element of the subcooperad acts on the class of a cochain by evaluating the cochain on
its chain.** -/
lemma eval_chain {n : ℕ} (φ : SubCoop hC n) (f : TConv K E (Ass K) n) :
    eval (Q := Ass K) f (chain hC n φ) = φ ((ann (Ass K) hC).proj n f) :=
  LinearMap.congr_fun (chainEquiv_chain hC φ) f

lemma chain_mem {n : ℕ} (φ : SubCoop hC n) : chain hC n φ ∈ C n :=
  mem_of_forall_ann hC fun f hf => by
    rw [eval_chain, show (ann (Ass K) hC).proj n f = 0 from
      (Submodule.Quotient.mk_eq_zero _).2 hf, map_zero]

lemma chain_injective (n : ℕ) : Function.Injective (chain hC n) :=
  (chainEquiv K E n).symm.injective.comp (incl_injective hC n)

/-- Every chain of the collection is the chain of an element of the subcooperad. -/
lemma exists_chain_eq {n : ℕ} {x : Chain K E n} (hx : x ∈ C n) :
    ∃ φ : SubCoop hC n, chain hC n φ = x := by
  refine ⟨((ann (Ass K) hC).carrier n).liftQ (chainEquiv K E n x) fun f hf => hf x hx,
    (chainEquiv K E n).symm_apply_eq.2 (LinearMap.ext fun f => ?_)⟩
  rfl

/-- **The components of the subcooperad are those of the collection.** -/
noncomputable def equiv (n : ℕ) : SubCoop hC n ≃ₗ[K] C n :=
  LinearEquiv.ofBijective (LinearMap.codRestrict (C n) (chain hC n) (chain_mem hC))
    ⟨fun _ _ h => chain_injective hC n (congrArg Subtype.val h), fun x => by
      obtain ⟨φ, hφ⟩ := exists_chain_eq hC x.2
      exact ⟨φ, Subtype.ext hφ⟩⟩

@[simp] lemma equiv_apply {n : ℕ} (φ : SubCoop hC n) :
    ((equiv hC n φ : C n) : Chain K E n) = chain hC n φ := rfl

/-- **The chains of the subcooperad are the collection.** -/
theorem range_chain (n : ℕ) : LinearMap.range (chain hC n) = C n := by
  refine le_antisymm ?_ fun x hx => exists_chain_eq hC hx
  rintro _ ⟨φ, rfl⟩
  exact chain_mem hC φ

/-- **The decomposition of the subcooperad is ungrafting**: inside the cooperad of chains, the
coefficient of the pair of trees `(t₁, t₂)` in a decomposition is the value of the chain at the
grafted tree. -/
theorem map_incl_decomp (a b n : ℕ) (φ : SubCoop hC (a + n + b)) :
    TensorProduct.map ((incl hC).app (a + 1 + b)) ((incl hC).app n)
        (NSCooperad.decomp a b n φ) =
      ∑ p : OfArity E (a + 1 + b) × OfArity E n,
        chain hC _ φ (OfArity.graft a b p.1 p.2) •
          (chainEquiv K E _ (Pi.single p.1 1) ⊗ₜ[K] chainEquiv K E _ (Pi.single p.2 1)) := by
  have h := LinearMap.congr_fun ((incl hC).decomp_app a b n) φ
  rw [LinearMap.comp_apply, LinearMap.comp_apply] at h
  rw [← h, ← decomp_chainEquiv, chainEquiv_chain]

/-- **The decomposition pairs with the classes of two cochains as their composite evaluated on
the chain.** -/
theorem decomp_pair (a b n : ℕ) (φ : SubCoop hC (a + n + b))
    (f : TConv K E (Ass K) (a + 1 + b)) (g : TConv K E (Ass K) n) :
    dualDistrib K _ _ (NSCooperad.decomp a b n φ)
        ((ann (Ass K) hC).proj _ f ⊗ₜ[K] (ann (Ass K) hC).proj _ g) =
      eval (Q := Ass K) (compL a b f g) (chain hC _ φ) := by
  show dualDistrib K _ _ (decompD a b n φ) _ = _
  rw [dualDistrib_decompD, compT_tmul, eval_chain]
  rfl

/-- The counit of the subcooperad is the value of the chain at the leaf. -/
lemma counit_eq (φ : SubCoop hC 1) :
    NSCooperad.counit (R := K) (C := SubCoop hC) φ = chain hC 1 φ OfArity.one := by
  have h := LinearMap.congr_fun (incl hC).counit_app φ
  rw [← h, LinearMap.comp_apply, ← chainEquiv_chain, counit_chainEquiv]

/-- **Duality**: the dual of the collection in arity `n` is the convolution operad in arity
`n`. -/
noncomputable def dualEquiv (n : ℕ) : Dual K (C n) ≃ₗ[K] HomOp (Ass K) hC n :=
  (equiv hC n).dualMap.trans (Module.evalEquiv K (HomOp (Ass K) hC n)).symm

/-- Under the duality, the class of a cochain is the functional evaluating it. -/
lemma dualEquiv_symm_proj {n : ℕ} (f : TConv K E (Ass K) n) (x : C n) :
    (dualEquiv hC n).symm ((ann (Ass K) hC).proj n f) x =
      eval (Q := Ass K) f (x : Chain K E n) := by
  show (equiv hC n).symm x ((ann (Ass K) hC).proj n f) = _
  rw [← eval_chain, ← equiv_apply, LinearEquiv.apply_symm_apply]

end SubCoop

end Sub

/-! ## The Koszul dual cooperad and the Koszul dual operad -/

section Koszul

variable {K : Type u} [Field K] {E : Type v} [Fintype E] [DecidableEq E]
  (Rel : Submodule K (Chain K E 3))

/-- **The Koszul dual operad** `P^!` of the presentation with relations `Rel`: the convolution
operad of the Koszul dual with scalar coefficients. -/
abbrev KoszulOp : ℕ → Type (max v u) := HomOp (Ass K) (koszulDual_sliceClosed Rel)

/-- **The Koszul dual cooperad** `P^¡` of the presentation with relations `Rel`. -/
abbrev KoszulCoop : ℕ → Type (max u v) := SubCoop (koszulDual_sliceClosed Rel)

namespace KoszulCoop

/-- **The Koszul dual cooperad in arity `n`** is the space of chains `koszulDual Rel n`. -/
noncomputable def equiv (n : ℕ) : KoszulCoop Rel n ≃ₗ[K] koszulDual Rel n :=
  SubCoop.equiv (koszulDual_sliceClosed Rel) n

/-- **In arity two the Koszul dual cooperad is all the chains**: the functions on the
generators. -/
noncomputable def equivTwo : KoszulCoop Rel 2 ≃ₗ[K] Chain K E 2 :=
  (equiv Rel 2).trans ((LinearEquiv.ofEq _ _ (koszulDual_two Rel)).trans Submodule.topEquiv)

/-- **In arity three the Koszul dual cooperad is the space of relations.** -/
noncomputable def equivThree : KoszulCoop Rel 3 ≃ₗ[K] Rel :=
  (equiv Rel 3).trans (LinearEquiv.ofEq _ _ (koszulDual_three Rel))

/-- The generators are the trees of arity two. -/
noncomputable def corEquiv : E ≃ OfArity E 2 :=
  Equiv.ofBijective OfArity.cor ⟨fun e e' h => by
    have h' := congrArg Subtype.val h
    exact (BTree.node.inj h').1, fun t => by
    obtain ⟨e, rfl⟩ := OfArity.eq_cor t
    exact ⟨e, rfl⟩⟩

/-- **In arity two the Koszul dual cooperad is the space of functions on the generators.** -/
noncomputable def equivGen : KoszulCoop Rel 2 ≃ₗ[K] (E → K) :=
  (equivTwo Rel).trans (LinearEquiv.funCongrLeft K K corEquiv)

/-- **In arity four the Koszul dual cooperad is the space of chains whose three outer slices and
two inner slices at every corolla are relations.** -/
theorem mem_range_chain_four_iff (x : Chain K E 4) :
    x ∈ LinearMap.range (SubCoop.chain (koszulDual_sliceClosed Rel) 4) ↔
      (∀ (a : Fin 3) (e : E), sliceOut (n := 2) a (OfArity.cor e) x ∈ Rel) ∧
        (∀ (a : Fin 2) (e : E), sliceIn (n := 3) a (OfArity.cor e) x ∈ Rel) := by
  rw [SubCoop.range_chain]
  exact mem_koszulDual_four_iff Rel x

/-- **Duality** `P^¡(n)* ≅ P^!(n)`. -/
noncomputable def dualEquiv (n : ℕ) : Dual K (KoszulCoop Rel n) ≃ₗ[K] KoszulOp Rel n :=
  (Module.evalEquiv K (KoszulOp Rel n)).symm

lemma dualEquiv_symm_apply {n : ℕ} (y : KoszulOp Rel n) (φ : KoszulCoop Rel n) :
    (dualEquiv Rel n).symm y φ = φ y := rfl

end KoszulCoop

/-- **The orthogonal relations**: the cochains of arity three vanishing on `Rel`. -/
def perp : ∀ n, Set (TConv K E (Ass K) n) := fun n =>
  {f | ∃ h : n = 3, ∀ x ∈ Rel,
    eval (R := K) (E := E) (Q := Ass K) (n := 3) (fun t => f (OfArity.cast h.symm t)) x = 0}

lemma mem_perp_three (f : TConv K E (Ass K) 3) :
    f ∈ perp Rel 3 ↔ ∀ x ∈ Rel, eval (Q := Ass K) f x = 0 :=
  ⟨fun ⟨_, h⟩ => h, fun h => ⟨rfl, h⟩⟩

/-- The orthogonal relations vanish on the Koszul dual. -/
lemma perp_subset_ann {n : ℕ} {f : TConv K E (Ass K) n} (hf : f ∈ perp Rel n) :
    f ∈ (ann (Ass K) (koszulDual_sliceClosed Rel)).carrier n := by
  obtain ⟨rfl, hf⟩ := hf
  intro x hx
  rw [koszulDual_three] at hx
  exact hf x hx

private lemma forall_generated_cast {m n : ℕ} (h : m = n) {x : Chain K E n}
    (hx : ∀ f ∈ (generated (R := K) (perp Rel)).carrier n, eval (Q := Ass K) f x = 0) :
    ∀ f ∈ (generated (R := K) (perp Rel)).carrier m,
      eval (Q := Ass K) f (fun t => x (OfArity.cast h t)) = 0 := by
  subst h
  exact hx

/-- **A chain killed by the ideal of the orthogonal relations is in the Koszul dual.** By
induction on the arity: the slices of such a chain are killed by the ideal, since composing with
the indicator of a tree evaluates on a slice. -/
theorem mem_koszulDual_of_forall_generated : ∀ (n : ℕ) (x : Chain K E n),
    (∀ f ∈ (generated (R := K) (perp Rel)).carrier n, eval (Q := Ass K) f x = 0) →
      x ∈ koszulDual Rel n := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro x hx
    rcases Nat.lt_or_ge n 3 with hn | hn
    · exact mem_koszulDual_of_le_two Rel (by omega) x
    rcases Nat.eq_or_lt_of_le hn with rfl | hn4
    · rw [koszulDual_three]
      by_contra hxR
      obtain ⟨φ, hφx, hφ⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hxR inferInstance
      obtain ⟨f, hf⟩ := exists_eval_eq φ
      refine hφx ((hf x).symm.trans (hx f (subset_generated _ ((mem_perp_three Rel f).2
        fun y hy => ?_))))
      rw [hf]
      have h : φ y ∈ Rel.map φ := Submodule.mem_map_of_mem hy
      rw [hφ] at h
      exact (Submodule.mem_bot K).1 h
    · obtain ⟨m, rfl⟩ : ∃ m, n = m + 4 := ⟨n - 4, by omega⟩
      rw [mem_koszulDual_add_four]
      intro a b k h hk hab
      have hy := forall_generated_cast Rel h hx
      refine ⟨fun t₂ => ih (a + 1 + b) (by omega) _ fun f hf => ?_,
        fun t₁ => ih k (by omega) _ fun g hg => ?_⟩
      · rw [← eval_comp_single_right]
        exact hy _ ((generated (R := K) (perp Rel)).comp_mem_left a b hf _)
      · rw [← eval_comp_single_left]
        exact hy _ ((generated (R := K) (perp Rel)).comp_mem_right a b _ hg)

/-- **The Koszul dual operad is quadratic**: the cochains vanishing on the Koszul dual form the
ideal generated by the orthogonal relations, so `P^!` is the operad of cochains modulo that
ideal. -/
theorem ann_koszulDual_eq_generated (n : ℕ) :
    (ann (Ass K) (koszulDual_sliceClosed Rel)).carrier n =
      (generated (R := K) (perp Rel)).carrier n := by
  refine le_antisymm (fun f hf => ?_) fun f hf => ?_
  · by_contra hfg
    obtain ⟨φ, hφf, hφ⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hfg inferInstance
    obtain ⟨x, hx⟩ := exists_eval_eq (R := K) (E := E) (n := n) φ
    have hxD : x ∈ koszulDual Rel n :=
      mem_koszulDual_of_forall_generated Rel n x fun g hg => by
        rw [eval_ass_comm, hx]
        have h : φ g ∈ ((generated (R := K) (perp Rel)).carrier n).map φ :=
          Submodule.mem_map_of_mem hg
        rw [hφ] at h
        exact (Submodule.mem_bot K).1 h
    exact hφf ((hx f).symm.trans ((eval_ass_comm x f).trans (hf x hxD)))
  · exact (Submodule.Quotient.mk_eq_zero _).1
      (apply_eq_zero_of_isGenerated (ann (Ass K) (koszulDual_sliceClosed Rel)).projHom (perp Rel)
        (fun n x hx => (Submodule.Quotient.mk_eq_zero _).2 (perp_subset_ann Rel hx)) hf)

/-- **The Koszul dual is the orthogonal of the ideal of the orthogonal relations**: a chain lies
in the Koszul dual exactly when every cochain of that ideal vanishes on it. -/
theorem mem_koszulDual_iff_forall_generated {n : ℕ} (x : Chain K E n) :
    x ∈ koszulDual Rel n ↔
      ∀ f ∈ (generated (R := K) (perp Rel)).carrier n, eval (Q := Ass K) f x = 0 := by
  refine ⟨fun hx f hf => ?_, mem_koszulDual_of_forall_generated Rel n x⟩
  rw [← ann_koszulDual_eq_generated] at hf
  exact hf x hx

