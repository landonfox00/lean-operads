/-
# The pre-Lie operad and rooted trees

The pre-Lie operad `PreLie R` (`Operad.BinaryQuadratic`) acts on the grafting algebra of rooted
trees (`RootedTree.graftAlg`). **An operation with inputs `A` is the combination of labelled
rooted trees with vertex set `A`** that it gives on the trees with one vertex `a ∈ A`
(Chapoton and Livernet):

* **The isomorphism** `PreLie.treeEquiv : PreLie R A ≃ₗ[R] (RTree A →₀ R)`, `RTree A` the rooted
  trees with vertex set `A`; the pre-Lie product is the tree with two vertices
  (`PreLie.treeAct_mu`).
* **`dim PreLie(n) = nⁿ⁻¹`** over a field (`PreLie.finrank_eq`), by Cayley's formula
  (`card_RTree`, from `Operad.Cayley`).

The proof:

* **Generation** (`BinPres.induction_on`): an operad presented by binary generators is generated
  by them, so a property closed under the linear operations, the relabellings and the
  compositions, true for the unit and the generators, holds for every operation.
* **Injectivity** (`PreLie.treeAct_injective`). The action of an operation on combinations of
  trees with disjoint vertex sets has the union of the vertex sets, and the value of the result
  in any pre-Lie algebra is the action on the values (`PreLie.act_supp_tv`), the values of trees
  being multiplicative (`RootedTree.tv_graftMul`, `PreLieBrace.treeVal_graft`). In the free
  algebra on `n` generators an operation is read off its action on the generators
  (`Schur.read_act`).
* **Surjectivity** (`PreLie.single_mem_Im`). Actions on disjoint sets of labels are closed under
  products (`PreLie.graftMul_mem_Im`, through the composite of the pre-Lie product with two
  operations) and under braces (`PreLie.brace_mem_Im`); in the grafting algebra every tree is the
  braces of its root with its subtrees (`RootedTree.brace_single_joinF`).

The composition of operations, in the basis of trees, is not described here: the operad of
rooted trees with composition by insertion at the vertices is not constructed.
-/
import Operad.GraftAlgebra
import Operad.PreLieTreeVal
import Operad.FaithfulAlgebra
import Operad.Cayley

universe u

namespace Operad

open Sym

/-! ## Binary operations as bilinear maps -/

/-- **The bilinear map of a binary operation.** -/
noncomputable def EndOp.toBilin {R : Type*} [CommRing R] {V : Type*} [AddCommGroup V]
    [Module R V] (μ : EndOp R V (Fin 2)) : V →ₗ[R] V →ₗ[R] V :=
  LinearMap.mk₂ R (fun x y => μ ![x, y])
    (fun x x' y => by
      have e : ∀ z, (![z, y] : Fin 2 → V) = Function.update ![x, y] 0 z := fun z => by
        funext i; fin_cases i <;> rfl
      beta_reduce
      have h := μ.map_update_add ![x, y] 0 x x'
      rw [← e, ← e, ← e] at h
      exact h)
    (fun c x y => by
      have e : ∀ z, (![z, y] : Fin 2 → V) = Function.update ![x, y] 0 z := fun z => by
        funext i; fin_cases i <;> rfl
      beta_reduce
      have h := μ.map_update_smul ![x, y] 0 c x
      rw [← e, ← e] at h
      exact h)
    (fun x y y' => by
      have e : ∀ z, (![x, z] : Fin 2 → V) = Function.update ![x, y] 1 z := fun z => by
        funext i; fin_cases i <;> rfl
      beta_reduce
      have h := μ.map_update_add ![x, y] 1 y y'
      rw [← e, ← e, ← e] at h
      exact h)
    (fun c x y => by
      have e : ∀ z, (![x, z] : Fin 2 → V) = Function.update ![x, y] 1 z := fun z => by
        funext i; fin_cases i <;> rfl
      beta_reduce
      have h := μ.map_update_smul ![x, y] 1 c y
      rw [← e, ← e] at h
      exact h)

@[simp] lemma EndOp.toBilin_apply {R : Type*} [CommRing R] {V : Type*} [AddCommGroup V]
    [Module R V] (μ : EndOp R V (Fin 2)) (x y : V) : EndOp.toBilin μ x y = μ ![x, y] := rfl

lemma EndOp.apply_fin_two {R : Type*} [CommRing R] {V : Type*} [AddCommGroup V] [Module R V]
    (μ : EndOp R V (Fin 2)) (v : Fin 2 → V) : μ v = EndOp.toBilin μ (v 0) (v 1) := by
  rw [EndOp.toBilin_apply]
  congr 1
  funext i
  fin_cases i <;> rfl

/-- The pre-Lie identity of a pre-Lie algebra, for its bilinear product. -/
lemma PreLieAlg.preLie_bilin {R : Type*} [CommRing R] {V : Type*} [AddCommGroup V] [Module R V]
    (a : PreLieAlg R V) (x y z : V) :
    EndOp.toBilin a.mul (EndOp.toBilin a.mul x y) z
        - EndOp.toBilin a.mul x (EndOp.toBilin a.mul y z)
      = EndOp.toBilin a.mul (EndOp.toBilin a.mul x z) y
        - EndOp.toBilin a.mul x (EndOp.toBilin a.mul z y) :=
  a.preLie x y z

/-! ## Operads presented by binary generators are generated by them -/

namespace BinPres

variable {R : Type u} [CommRing R] {G : Type} {r₂ : Set (FreeBin R G (Fin 2))}
  {r₃ : Set (FreeBin R G (Fin 3))}

variable (R r₂ r₃) in
/-- **The generator `g`**, in the presented operad. -/
noncomputable def genOp (g : G) : BinPres R r₂ r₃ (Fin 2) :=
  (SymOperadIdeal.span R (rel23 r₂ r₃)).proj _ (Finsupp.single (Pres.mk (FreeBin.gen g)) 1)

/-- **An operad presented by binary generators is generated by them**: a property of its
operations closed under the linear operations, the relabellings and the compositions, holding
for the unit and the generators, holds for every operation. -/
theorem induction_on
    {motive : ∀ {A : Type} [Fintype A] [DecidableEq A], BinPres R r₂ r₃ A → Prop}
    (zero : ∀ {A : Type} [Fintype A] [DecidableEq A], motive (0 : BinPres R r₂ r₃ A))
    (add : ∀ {A : Type} [Fintype A] [DecidableEq A] (x y : BinPres R r₂ r₃ A),
      motive x → motive y → motive (x + y))
    (smul : ∀ {A : Type} [Fintype A] [DecidableEq A] (c : R) (x : BinPres R r₂ r₃ A),
      motive x → motive (c • x))
    (map : ∀ {A B : Type} [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B] (e : A ≃ B)
      (x : BinPres R r₂ r₃ A), motive x → motive (SymOperad.map (R := R) e x))
    (one : motive (SymOperad.one R : BinPres R r₂ r₃ Unit))
    (comp : ∀ {A B : Type} [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B] (i : A)
      (x : BinPres R r₂ r₃ A) (y : BinPres R r₂ r₃ B), motive x → motive y →
        motive (SymOperad.comp (R := R) i x y))
    (gen : ∀ g, motive (genOp R r₂ r₃ g))
    {A : Type} [Fintype A] [DecidableEq A] (x : BinPres R r₂ r₃ A) : motive x := by
  set I := SymOperadIdeal.span R (rel23 r₂ r₃)
  have hsyn : ∀ {A : Type} [Fintype A] [DecidableEq A] (s : Syn (BinGen G) A),
      motive (I.proj A (Finsupp.single (Pres.mk s) 1)) := by
    intro A _ _ s
    induction s with
    | one => exact one
    | gen g =>
      cases g with
      | op g => exact gen g
    | map e s ih =>
      have h : SymOperad.map (R := R) e (I.proj _ (Finsupp.single (Pres.mk s) (1 : R)))
          = I.proj _ (Finsupp.single (Pres.mk (Syn.map e s)) 1) := by
        show I.proj _ (Lin.mapL R e (Finsupp.single (Pres.mk s) 1)) = _
        rw [Lin.mapL_single]
        rfl
      exact h ▸ map e _ ih
    | comp i s t ihs iht =>
      have h : SymOperad.comp (R := R) i (I.proj _ (Finsupp.single (Pres.mk s) (1 : R)))
          (I.proj _ (Finsupp.single (Pres.mk t) (1 : R)))
          = I.proj _ (Finsupp.single (Pres.mk (Syn.comp i s t)) 1) := by
        show I.proj _ (Lin.compL R i (Finsupp.single (Pres.mk s) 1)
          (Finsupp.single (Pres.mk t) 1)) = _
        rw [Lin.compL_single, mul_one]
        rfl
      exact h ▸ comp i _ _ ihs iht
  obtain ⟨z, rfl⟩ := I.proj_surjective A x
  induction z using Finsupp.induction_linear with
  | zero => exact (map_zero (I.proj A)).symm ▸ zero
  | add z z' hz hz' => exact (map_add (I.proj A) z z').symm ▸ add _ _ hz hz'
  | single s c =>
    obtain ⟨t, rfl⟩ := Pres.mk_surjective s
    have h : I.proj A (Finsupp.single (Pres.mk t) c)
        = c • I.proj A (Finsupp.single (Pres.mk t) 1) := by
      rw [← map_smul, Finsupp.smul_single_one]
    exact h ▸ smul c _ (hsyn t)

end BinPres

/-! ## The action of the generator of `PreLie` -/

namespace PreLie

variable {R : Type u} [CommRing R]

variable (R) in
/-- **The pre-Lie product**, the generator of the pre-Lie operad. -/
noncomputable abbrev mu : PreLie R (Fin 2) :=
  BinPres.genOp R (∅ : Set (FreeBin R Unit (Fin 2))) {BinRel.preLie R ()} ()

/-- **The pre-Lie product acts by the product of the algebra.** -/
lemma act_mu {V : Type*} [AddCommGroup V] [Module R V] (α : SymAlgebra R (PreLie R) V)
    (v : Fin 2 → V) :
    α.act (mu R) v = EndOp.toBilin (PreLie.algebraEquiv α).mul (v 0) (v 1) := by
  rw [← EndOp.apply_fin_two]
  rfl

/-- The product of the algebra of a pre-Lie algebra structure. -/
lemma algebraEquiv_symm_mul {V : Type*} [AddCommGroup V] [Module R V] (a : PreLieAlg R V) :
    (PreLie.algebraEquiv (PreLie.algebraEquiv.symm a)).mul = a.mul := by
  rw [Equiv.apply_symm_apply]

end PreLie

/-! ## Supports -/

namespace RootedTree

variable {R : Type u} [CommRing R] {Λ : Type} [DecidableEq Λ]

variable (R) in
/-- **The combinations of trees with the vertex set `S`.** -/
noncomputable def supp (S : Finset Λ) : Submodule R (RootedTree Λ →₀ R) :=
  Finsupp.supported R R {T : RootedTree Λ | T.S = S}

omit [DecidableEq Λ] in
lemma single_mem_supp {T : RootedTree Λ} {S : Finset Λ} (h : T.S = S) :
    Finsupp.single T (1 : R) ∈ supp R S :=
  Finsupp.single_mem_supported R 1 h

omit [DecidableEq Λ] in
lemma supp_induction {S : Finset Λ} {p : (RootedTree Λ →₀ R) → Prop} (h0 : p 0)
    (hadd : ∀ x y, p x → p y → p (x + y)) (hsmul : ∀ (c : R) x, p x → p (c • x))
    (hT : ∀ T : RootedTree Λ, T.S = S → p (Finsupp.single T 1)) {x : RootedTree Λ →₀ R}
    (hx : x ∈ supp R S) : p x := by
  rw [supp, Finsupp.supported_eq_span_single] at hx
  induction hx using Submodule.span_induction with
  | mem y hy =>
    obtain ⟨T, hT', rfl⟩ := hy
    exact hT T hT'
  | zero => exact h0
  | add x y _ _ hx hy => exact hadd x y hx hy
  | smul c x _ hx => exact hsmul c x hx

/-- **The product of combinations of trees with disjoint vertex sets** has the union of the
vertex sets. -/
lemma graftMul_mem_supp {S S' : Finset Λ} (hd : Disjoint S S') {x y : RootedTree Λ →₀ R}
    (hx : x ∈ supp R S) (hy : y ∈ supp R S') : graftMul R x y ∈ supp R (S ∪ S') := by
  refine supp_induction (p := fun x => graftMul R x y ∈ supp R (S ∪ S')) ?_ ?_ ?_ ?_ hx
  · show graftMul R 0 y ∈ supp R (S ∪ S')
    rw [map_zero, LinearMap.zero_apply]
    exact zero_mem _
  · intro x x' hx hx'
    rw [map_add, LinearMap.add_apply]
    exact add_mem hx hx'
  · intro c x hx
    rw [map_smul, LinearMap.smul_apply]
    exact Submodule.smul_mem _ c hx
  · intro T hT
    refine supp_induction (p := fun y => graftMul R (Finsupp.single T 1) y ∈ supp R (S ∪ S'))
      ?_ ?_ ?_ ?_ hy
    · show graftMul R (Finsupp.single T 1) 0 ∈ supp R (S ∪ S')
      rw [map_zero]
      exact zero_mem _
    · intro y y' hy hy'
      rw [map_add]
      exact add_mem hy hy'
    · intro c y hy
      rw [map_smul]
      exact Submodule.smul_mem _ c hy
    · intro U hU
      have hTU : Disjoint T.S U.S := hT ▸ hU ▸ hd
      rw [graftMul_single]
      unfold graftProd
      rw [if_pos hTU]
      refine Submodule.sum_mem _ fun v hv => single_mem_supp ?_
      rw [graft_S hTU hv, hT, hU]

/-! ## The values of combinations of trees -/

variable {L : Type*} [AddCommGroup L] [Module R L] (mL : L →ₗ[R] L →ₗ[R] L) (xL : Λ → L)

/-- **The value of a combination of trees.** -/
noncomputable def tv : (RootedTree Λ →₀ R) →ₗ[R] L :=
  Finsupp.linearCombination R (PreLieBrace.treeVal mL xL)

lemma tv_single (T : RootedTree Λ) :
    tv mL xL (Finsupp.single T (1 : R)) = PreLieBrace.treeVal mL xL T := by
  rw [tv, Finsupp.linearCombination_single, one_smul]

variable (hpl : ∀ x y z : L, mL (mL x y) z - mL x (mL y z) = mL (mL x z) y - mL x (mL z y))
include hpl

/-- **The values of combinations of trees with disjoint vertex sets are multiplicative.** -/
lemma tv_graftMul {S S' : Finset Λ} (hd : Disjoint S S') {x y : RootedTree Λ →₀ R}
    (hx : x ∈ supp R S) (hy : y ∈ supp R S') :
    tv mL xL (graftMul R x y) = mL (tv mL xL x) (tv mL xL y) := by
  refine supp_induction (p := fun x => tv mL xL (graftMul R x y) = mL (tv mL xL x) (tv mL xL y))
    ?_ ?_ ?_ ?_ hx
  · simp
  · intro x x' hx hx'
    simp only [map_add, LinearMap.add_apply, hx, hx']
  · intro c x hx
    simp only [map_smul, LinearMap.smul_apply, hx]
  · intro T hT
    refine supp_induction (p := fun y => tv mL xL (graftMul R (Finsupp.single T 1) y)
      = mL (tv mL xL (Finsupp.single T 1)) (tv mL xL y)) ?_ ?_ ?_ ?_ hy
    · simp
    · intro y y' hy hy'
      simp only [map_add, hy, hy']
    · intro c y hy
      simp only [map_smul, hy]
    · intro U hU
      have hTU : Disjoint T.S U.S := hT ▸ hU ▸ hd
      rw [graftMul_single, tv_single, tv_single]
      unfold graftProd
      rw [if_pos hTU, map_sum]
      simp only [tv_single]
      exact PreLieBrace.treeVal_graft mL hpl xL T U hTU

end RootedTree

/-! ## The action of the pre-Lie operad on trees -/

namespace PreLie

open RootedTree

variable {R : Type u} [CommRing R] {Λ : Type} [DecidableEq Λ]

/-- The pre-Lie product acts on the grafting algebra by the grafting product. -/
lemma graftAlg_act_mu (v : Fin 2 → RootedTree Λ →₀ R) :
    (graftAlg R Λ).act (mu R) v = graftMul R (v 0) (v 1) := by
  rw [act_mu, graftAlg, algebraEquiv_symm_mul]
  rfl

lemma act_zero' {V : Type*} [AddCommGroup V] [Module R V] (α : SymAlgebra R (PreLie R) V)
    {A : Type} [Fintype A] [DecidableEq A] (v : A → V) : α.act (0 : PreLie R A) v = 0 := by
  unfold SymAlgebra.act
  rw [map_zero]
  rfl

lemma act_add' {V : Type*} [AddCommGroup V] [Module R V] (α : SymAlgebra R (PreLie R) V)
    {A : Type} [Fintype A] [DecidableEq A] (x y : PreLie R A) (v : A → V) :
    α.act (x + y) v = α.act x v + α.act y v := by
  unfold SymAlgebra.act
  rw [map_add]
  rfl

lemma act_smul' {V : Type*} [AddCommGroup V] [Module R V] (α : SymAlgebra R (PreLie R) V)
    {A : Type} [Fintype A] [DecidableEq A] (c : R) (x : PreLie R A) (v : A → V) :
    α.act (c • x) v = c • α.act x v := by
  unfold SymAlgebra.act
  rw [map_smul]
  rfl

lemma biUnion_comp_equiv {A B : Type} [Fintype A] [Fintype B] (e : A ≃ B) (S : B → Finset Λ) :
    (Finset.univ.biUnion fun a => S (e a)) = Finset.univ.biUnion S := by
  ext x
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and]
  exact ⟨fun ⟨a, ha⟩ => ⟨e a, ha⟩, fun ⟨b, hb⟩ => ⟨e.symm b, by rw [e.apply_symm_apply]; exact hb⟩⟩

lemma biUnion_feed {A B : Type} [Fintype A] [DecidableEq A] [Fintype B] [DecidableEq B] (i : A)
    (S : Without A i ⊕ B → Finset Λ) :
    (Finset.univ.biUnion (feed i S (Finset.univ.biUnion fun b => S (Sum.inr b))))
      = Finset.univ.biUnion S := by
  ext x
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and]
  constructor
  · rintro ⟨a, ha⟩
    by_cases hai : a = i
    · subst hai
      rw [feed_self, Finset.mem_biUnion] at ha
      obtain ⟨b, _, hb⟩ := ha
      exact ⟨Sum.inr b, hb⟩
    · rw [feed_of_ne hai] at ha
      exact ⟨_, ha⟩
  · rintro ⟨c, hc⟩
    rcases c with ⟨a, hai⟩ | b
    · exact ⟨a, by rw [feed_of_ne hai]; exact hc⟩
    · exact ⟨i, by rw [feed_self]; exact Finset.mem_biUnion.2 ⟨b, Finset.mem_univ _, hc⟩⟩

variable {L : Type*} [AddCommGroup L] [Module R L] (β : SymAlgebra R (PreLie R) L) (xL : Λ → L)

/-- **The action on combinations of trees with disjoint vertex sets**: it has the union of the
vertex sets, and the value of the result is the action on the values. -/
theorem act_supp_tv {A : Type} [Fintype A] [DecidableEq A] (p : PreLie R A) :
    ∀ (S : A → Finset Λ) (m : A → RootedTree Λ →₀ R), (∀ a, m a ∈ supp R (S a)) →
      (∀ a a', a ≠ a' → Disjoint (S a) (S a')) →
      (graftAlg R Λ).act p m ∈ supp R (Finset.univ.biUnion S) ∧
        tv (EndOp.toBilin (PreLie.algebraEquiv β).mul) xL ((graftAlg R Λ).act p m)
          = β.act p fun a => tv (EndOp.toBilin (PreLie.algebraEquiv β).mul) xL (m a) := by
  set μL := EndOp.toBilin (PreLie.algebraEquiv β).mul
  have hpl := (PreLie.algebraEquiv β).preLie_bilin
  induction p using BinPres.induction_on with
  | zero =>
    intro S m _ _
    rw [act_zero', act_zero', map_zero]
    exact ⟨zero_mem _, rfl⟩
  | add x y hx hy =>
    intro S m hm hd
    obtain ⟨hx1, hx2⟩ := hx S m hm hd
    obtain ⟨hy1, hy2⟩ := hy S m hm hd
    rw [act_add', act_add', map_add, hx2, hy2]
    exact ⟨add_mem hx1 hy1, rfl⟩
  | smul c x hx =>
    intro S m hm hd
    obtain ⟨hx1, hx2⟩ := hx S m hm hd
    rw [act_smul', act_smul', map_smul, hx2]
    exact ⟨Submodule.smul_mem _ c hx1, rfl⟩
  | map e x hx =>
    intro S m hm hd
    obtain ⟨hx1, hx2⟩ := hx (fun a => S (e a)) (fun a => m (e a)) (fun a => hm _)
      fun a a' h => hd _ _ fun h' => h (e.injective h')
    rw [SymAlgebra.act_map, SymAlgebra.act_map, hx2]
    exact ⟨biUnion_comp_equiv e S ▸ hx1, rfl⟩
  | one =>
    intro S m hm _
    rw [SymAlgebra.act_one, SymAlgebra.act_one]
    have hU : (Finset.univ.biUnion S) = S () := by
      rw [Finset.univ_unique, Finset.singleton_biUnion]
    exact ⟨hU ▸ hm (), rfl⟩
  | comp i x y hx hy =>
    intro S m hm hd
    obtain ⟨hy1, hy2⟩ := hy (fun b => S (Sum.inr b)) (fun b => m (Sum.inr b)) (fun b => hm _)
      fun b b' h => hd _ _ fun h' => h (Sum.inr_injective h')
    have hm' : ∀ a, feed i m ((graftAlg R Λ).act y fun b => m (Sum.inr b)) a
        ∈ supp R (feed i S (Finset.univ.biUnion fun b => S (Sum.inr b)) a) := by
      intro a
      by_cases hai : a = i
      · subst hai
        rw [feed_self, feed_self]
        exact hy1
      · rw [feed_of_ne hai, feed_of_ne hai]
        exact hm _
    have hd' : ∀ a a', a ≠ a' → Disjoint (feed i S (Finset.univ.biUnion fun b => S (Sum.inr b)) a)
        (feed i S (Finset.univ.biUnion fun b => S (Sum.inr b)) a') := by
      intro a a' haa
      by_cases hai : a = i
      · subst hai
        rw [feed_self, feed_of_ne (Ne.symm haa), Finset.disjoint_biUnion_left]
        exact fun b _ => hd _ _ (by simp)
      · rw [feed_of_ne hai]
        by_cases ha'i : a' = i
        · subst ha'i
          rw [feed_self, Finset.disjoint_biUnion_right]
          exact fun b _ => hd _ _ (by simp)
        · rw [feed_of_ne ha'i]
          exact hd _ _ fun h => haa (congrArg Subtype.val (Sum.inl_injective h))
    obtain ⟨hx1, hx2⟩ := hx _ _ hm' hd'
    rw [SymAlgebra.act_comp, SymAlgebra.act_comp, hx2, ← biUnion_feed i S]
    refine ⟨hx1, ?_⟩
    congr 1
    funext a
    by_cases hai : a = i
    · subst hai
      rw [feed_self, feed_self, hy2]
    · rw [feed_of_ne hai, feed_of_ne hai]
  | gen g =>
    cases g
    intro S m hm hd
    have h01 : Disjoint (S 0) (S 1) := hd 0 1 (by decide)
    have hU : (Finset.univ.biUnion S) = S 0 ∪ S 1 := by
      ext x
      simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, Finset.mem_union,
        Fin.exists_fin_two]
    rw [graftAlg_act_mu, act_mu, hU]
    exact ⟨graftMul_mem_supp h01 (hm 0) (hm 1), tv_graftMul μL xL hpl h01 (hm 0) (hm 1)⟩

/-- **The pre-Lie operad acts faithfully on rooted trees**: an operation `p` with inputs `A` is
determined by its action on the trees with one vertex `a`, for `a ∈ A`. -/
theorem treeAct_injective (A : Type) [Fintype A] [DecidableEq A] :
    Function.Injective fun p : PreLie R A =>
      (graftAlg R A).act p fun a => Finsupp.single (vtx a) (1 : R) := by
  intro p q hpq
  set n := Fintype.card A
  let e : A ≃ Fin n := Fintype.equivFin A
  let β := Schur.algebra R (PreLie R) (Fin n → R)
  let xL : A → Schur R (PreLie R) (Fin n → R) := fun a =>
    Schur.ι R (PreLie R) (Fin n → R) (Pi.single (e a) 1)
  have key : ∀ r : PreLie R A,
      Schur.read R (PreLie R) n (tv (EndOp.toBilin (PreLie.algebraEquiv β).mul) xL
        ((graftAlg R A).act r fun a => Finsupp.single (vtx a) (1 : R)))
          = SymOperad.map (R := R) e r := by
    intro r
    obtain ⟨_, h2⟩ := act_supp_tv β xL r (fun a => {a}) (fun a => Finsupp.single (vtx a) 1)
      (fun a => single_mem_supp rfl) fun a a' h => Finset.disjoint_singleton.2 h
    rw [h2]
    have h3 : (fun a => tv (EndOp.toBilin (PreLie.algebraEquiv β).mul) xL
        (Finsupp.single (vtx a) (1 : R))) = fun a => (fun k => Schur.ι R (PreLie R) (Fin n → R)
          (Pi.single k 1)) (e a) := by
      funext a
      rw [tv_single, PreLieBrace.treeVal_vtx]
    rw [h3, ← SymAlgebra.act_map β e r
      (fun k => Schur.ι R (PreLie R) (Fin n → R) (Pi.single k 1))]
    exact Schur.read_act n _
  have h := congrArg (fun z => Schur.read R (PreLie R) n
    (tv (EndOp.toBilin (PreLie.algebraEquiv β).mul) xL z)) hpq
  simp only at h
  rw [key, key] at h
  exact SymOperad.map_injective (R := R) e h

end PreLie

/-! ## Trees are braces of trees with one vertex -/

namespace RootedTree

variable {R : Type u} [CommRing R] {Λ : Type} [DecidableEq Λ]

/-- **The braces of the root with the joined trees are the joined tree**, in the grafting
algebra. -/
theorem brace_single_joinF (r : Λ) :
    ∀ (k : ℕ) (U : Fin k → RootedTree Λ), JoinOK r U →
      PreLieBrace.brace (graftMul R) k (Finsupp.single (vtx r) 1)
        (fun i => Finsupp.single (U i) 1) = Finsupp.single (joinF r k U) 1
  | 0, _, _ => rfl
  | k + 1, U, h => by
    have hJ := brace_single_joinF r k (Fin.init U) h.init
    have hd := disjoint_joinF_last h
    have hrJ := root_mem_joinF_S h.init
    set J := joinF r k (Fin.init U)
    have hS : J.S = insert r (Finset.univ.biUnion fun i => (Fin.init U i).S) := joinF_S h.init
    have hrn : r ∉ Finset.univ.biUnion fun i => (Fin.init U i).S := by
      rw [Finset.mem_biUnion]
      rintro ⟨i, _, hi⟩
      exact h.init.not_mem i hi
    have hpd : (↑(Finset.univ : Finset (Fin k)) : Set (Fin k)).PairwiseDisjoint
        fun i => (Fin.init U i).S := fun i _ j _ hij => h.init.disj i j hij
    have hterm : ∀ i : Fin k,
        PreLieBrace.brace (graftMul R) k (Finsupp.single (vtx r) 1)
          (Function.update (fun j => Finsupp.single (Fin.init U j) (1 : R)) i
            (graftMul R (Finsupp.single (Fin.init U i) 1) (Finsupp.single (U (Fin.last k)) 1)))
        = ∑ v ∈ (Fin.init U i).S, Finsupp.single (graft J (U (Fin.last k)) v) 1 := by
      intro i
      have hiW : Disjoint (Fin.init U i).S (U (Fin.last k)).S :=
        Finset.disjoint_of_subset_left (fun a ha => mem_joinF_S h.init ha) hd
      rw [graftMul_single]
      unfold graftProd
      rw [if_pos hiW, PreLieBrace.brace_update_sum]
      refine Finset.sum_congr rfl fun v hv => ?_
      obtain ⟨hOK', heq⟩ := graft_joinF_of_mem h.init i hv hd
      rw [heq, ← brace_single_joinF r k _ hOK']
      congr 1
      funext j
      by_cases hij : j = i
      · subst hij
        rw [Function.update_self, Function.update_self]
      · rw [Function.update_of_ne hij, Function.update_of_ne hij]
    rw [PreLieBrace.brace_succ]
    have hinit : (Fin.init fun i => Finsupp.single (U i) (1 : R))
        = fun j => Finsupp.single (Fin.init U j) 1 := rfl
    rw [hinit, hJ, Finset.sum_congr rfl fun i _ => hterm i, graftMul_single]
    unfold graftProd
    rw [if_pos hd, hS, Finset.sum_insert hrn, Finset.sum_biUnion hpd]
    show Finsupp.single (graft J (U (Fin.last k)) r) 1 + _ - _ = Finsupp.single (graft J _ r) 1
    abel

/-- **In the grafting algebra, the value of a tree with the trees with one vertex is the tree
itself.** -/
theorem treeVal_single :
    ∀ (n : ℕ) (T : RootedTree Λ), T.S.card = n →
      PreLieBrace.treeVal (graftMul R) (fun a => Finsupp.single (vtx a) 1) T
        = Finsupp.single T 1 := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro T hn
    classical
    let k := Fintype.card ↥(children T)
    let e : Fin k ≃ ↥(children T) := (Fintype.equivFin _).symm
    have hOK := joinOK_subtrees T e
    have hT : T = joinF T.root k (fun i => subtree T (e i)) := eq_joinF T e
    rw [hT, PreLieBrace.treeVal_joinF (graftMul R) graft_preLie _ hOK]
    have hU : (fun i => PreLieBrace.treeVal (graftMul R) (fun a => Finsupp.single (vtx a) 1)
        (subtree T (e i))) = fun i => Finsupp.single (subtree T (e i)) (1 : R) := by
      funext i
      exact ih _ (hn ▸ card_subtree_lt (e i).2) _ rfl
    rw [hU]
    exact brace_single_joinF T.root k _ hOK

end RootedTree

/-! ## The actions on trees with one vertex span the trees -/

namespace PreLie

open RootedTree

variable {R : Type u} [CommRing R] {Λ : Type} [DecidableEq Λ]

variable (R) in
/-- **The action on the trees with one vertex labelled by `S`.** -/
noncomputable def actLin (S : Finset Λ) : PreLie R ↥S →ₗ[R] (RootedTree Λ →₀ R) where
  toFun p := (graftAlg R Λ).act p fun s => Finsupp.single (vtx s.1) 1
  map_add' x y := act_add' _ x y _
  map_smul' c x := act_smul' _ c x _

variable (R) in
/-- The combinations of trees obtained by acting on the trees with one vertex labelled by `S`. -/
noncomputable def Im (S : Finset Λ) : Submodule R (RootedTree Λ →₀ R) :=
  LinearMap.range (actLin R S)

lemma act_mem_Im {B : Type} [Fintype B] [DecidableEq B] (S : Finset Λ) (e : B ≃ ↥S)
    (p : PreLie R B) :
    (graftAlg R Λ).act p (fun b => Finsupp.single (vtx (e b).1) (1 : R)) ∈ Im R S :=
  ⟨SymOperad.map (R := R) e p, by
    show (graftAlg R Λ).act (SymOperad.map (R := R) e p) _ = _
    rw [SymAlgebra.act_map]⟩

lemma vtx_mem_Im (a : Λ) : Finsupp.single (vtx a) (1 : R) ∈ Im R {a} := by
  let e : Unit ≃ ↥({a} : Finset Λ) :=
    { toFun := fun _ => ⟨a, Finset.mem_singleton_self a⟩
      invFun := fun _ => ()
      left_inv := fun _ => rfl
      right_inv := fun x => Subtype.ext (Finset.mem_singleton.1 x.2).symm }
  have h := act_mem_Im (R := R) {a} e (SymOperad.one R)
  rw [SymAlgebra.act_one] at h
  exact h

/-- The input `1` of the pre-Lie product, the other than `0`. -/
abbrev one' : Without (Fin 2) 0 := ⟨1, by decide⟩

lemma eq_one' (z : Without (Fin 2) 0) : z = one' := by
  obtain ⟨v, hv⟩ := z
  fin_cases v
  · exact absurd rfl hv
  · rfl

/-- The inputs of the product of two operations. -/
@[nolint unusedArguments]
abbrev X2 (A₁ A₂ : Type) [Fintype A₁] [DecidableEq A₁] [Fintype A₂] [DecidableEq A₂] : Type :=
  Without (Without (Fin 2) 0 ⊕ A₁) (Sum.inl one') ⊕ A₂

variable (R) in
/-- **The product of two operations**, the pre-Lie product composed with them. -/
noncomputable def mul2 {A₁ A₂ : Type} [Fintype A₁] [DecidableEq A₁] [Fintype A₂]
    [DecidableEq A₂] (p : PreLie R A₁) (q : PreLie R A₂) : PreLie R (X2 A₁ A₂) :=
  SymOperad.comp (R := R) (Sum.inl one') (SymOperad.comp (R := R) (0 : Fin 2) (mu R) p) q

/-- The labels of the inputs of the product of two operations. -/
def fX {A₁ A₂ : Type} [Fintype A₁] [DecidableEq A₁] [Fintype A₂] [DecidableEq A₂]
    (f₁ : A₁ → Λ) (f₂ : A₂ → Λ) : X2 A₁ A₂ → Λ
  | Sum.inl ⟨Sum.inl z, hz⟩ => absurd (congrArg Sum.inl (eq_one' z)) hz
  | Sum.inl ⟨Sum.inr a, _⟩ => f₁ a
  | Sum.inr a => f₂ a

/-- **The product of two operations acts by the product of their actions.** -/
lemma act_mul2 {A₁ A₂ : Type} [Fintype A₁] [DecidableEq A₁] [Fintype A₂] [DecidableEq A₂]
    (p : PreLie R A₁) (q : PreLie R A₂) (f₁ : A₁ → Λ) (f₂ : A₂ → Λ) :
    (graftAlg R Λ).act (mul2 R p q) (fun x => Finsupp.single (vtx (fX f₁ f₂ x)) (1 : R))
      = graftMul R ((graftAlg R Λ).act p fun a => Finsupp.single (vtx (f₁ a)) 1)
          ((graftAlg R Λ).act q fun a => Finsupp.single (vtx (f₂ a)) 1) := by
  unfold mul2
  rw [SymAlgebra.act_comp, SymAlgebra.act_comp, graftAlg_act_mu]
  congr 1

/-- **The products of actions on disjoint labels are actions.** -/
theorem graftMul_mem_Im {S S' : Finset Λ} (hd : Disjoint S S') {x y : RootedTree Λ →₀ R}
    (hx : x ∈ Im R S) (hy : y ∈ Im R S') : graftMul R x y ∈ Im R (S ∪ S') := by
  obtain ⟨p, rfl⟩ := hx
  obtain ⟨q, rfl⟩ := hy
  have hmem : ∀ z : X2 ↥S ↥S', fX Subtype.val Subtype.val z ∈ S ∪ S' := by
    rintro (⟨(z | a), hz⟩ | a)
    · exact absurd (congrArg Sum.inl (eq_one' z)) hz
    · exact Finset.mem_union_left _ a.2
    · exact Finset.mem_union_right _ a.2
  let g : X2 ↥S ↥S' → ↥(S ∪ S') := fun z => ⟨fX Subtype.val Subtype.val z, hmem z⟩
  have hg : Function.Bijective g := by
    refine ⟨?_, fun c => ?_⟩
    · rintro (⟨(z | a), hz⟩ | a) (⟨(z' | b), hz'⟩ | b) h
      · exact absurd (congrArg Sum.inl (eq_one' z)) hz
      · exact absurd (congrArg Sum.inl (eq_one' z)) hz
      · exact absurd (congrArg Sum.inl (eq_one' z)) hz
      · exact absurd (congrArg Sum.inl (eq_one' z')) hz'
      · have h' : (g _).1 = (g _).1 := congrArg Subtype.val h
        obtain rfl : a = b := Subtype.ext h'
        rfl
      · have h' : a.1 = b.1 := Subtype.ext_iff.1 h
        exact absurd b.2 (Finset.disjoint_left.1 hd (h' ▸ a.2))
      · exact absurd (congrArg Sum.inl (eq_one' z')) hz'
      · have h' : a.1 = b.1 := Subtype.ext_iff.1 h
        exact absurd a.2 (Finset.disjoint_left.1 hd (h' ▸ b.2))
      · have h' : (g _).1 = (g _).1 := congrArg Subtype.val h
        obtain rfl : a = b := Subtype.ext h'
        rfl
    · by_cases hc : c.1 ∈ S
      · exact ⟨Sum.inl ⟨Sum.inr ⟨c.1, hc⟩, by simp⟩, Subtype.ext rfl⟩
      · exact ⟨Sum.inr ⟨c.1, (Finset.mem_union.1 c.2).resolve_left hc⟩, Subtype.ext rfl⟩
  have h := act_mem_Im (R := R) (S ∪ S') (Equiv.ofBijective g hg) (mul2 R p q)
  have e1 : (fun z => Finsupp.single (vtx ((Equiv.ofBijective g hg) z).1) (1 : R))
      = fun z => Finsupp.single (vtx (fX Subtype.val Subtype.val z)) 1 := rfl
  rw [e1, act_mul2] at h
  exact h

lemma Im_congr {S S' : Finset Λ} (h : S = S') {x : RootedTree Λ →₀ R} (hx : x ∈ Im R S) :
    x ∈ Im R S' := h ▸ hx

/-- **The braces of actions on disjoint labels are actions.** -/
theorem brace_mem_Im :
    ∀ (k : ℕ) (S₀ : Finset Λ) (S : Fin k → Finset Λ) (x : RootedTree Λ →₀ R)
      (Y : Fin k → RootedTree Λ →₀ R), x ∈ Im R S₀ → (∀ i, Y i ∈ Im R (S i)) →
      (∀ i, Disjoint S₀ (S i)) → (∀ i j, i ≠ j → Disjoint (S i) (S j)) →
      PreLieBrace.brace (graftMul R) k x Y ∈ Im R (S₀ ∪ Finset.univ.biUnion S)
  | 0, S₀, S, x, Y, hx, _, _, _ => by
    simpa using hx
  | k + 1, S₀, S, x, Y, hx, hY, h0, hS => by
    rw [PreLieBrace.brace_succ]
    have hU : S₀ ∪ Finset.univ.biUnion S
        = (S₀ ∪ Finset.univ.biUnion (Fin.init S)) ∪ S (Fin.last k) := by
      ext a
      simp only [Finset.mem_union, Finset.mem_biUnion, Finset.mem_univ, true_and,
        Fin.exists_fin_succ', Fin.init]
      tauto
    have hIH := brace_mem_Im k S₀ (Fin.init S) x (Fin.init Y) hx (fun i => hY _)
      (fun i => h0 _) fun i j hij => hS _ _ fun e => hij (Fin.castSucc_injective _ e)
    have hlast : Disjoint (S₀ ∪ Finset.univ.biUnion (Fin.init S)) (S (Fin.last k)) := by
      rw [Finset.disjoint_union_left, Finset.disjoint_biUnion_left]
      exact ⟨h0 _, fun i _ => hS _ _ (Fin.castSucc_lt_last i).ne⟩
    refine sub_mem ?_ (Submodule.sum_mem _ fun i _ => ?_)
    · exact Im_congr hU.symm (graftMul_mem_Im hlast hIH (hY _))
    · have hdi : Disjoint (S i.castSucc) (S (Fin.last k)) := hS _ _ (Fin.castSucc_lt_last i).ne
      let S' := Function.update (Fin.init S) i (S i.castSucc ∪ S (Fin.last k))
      have hS'i : ∀ j, S' j = if j = i then S i.castSucc ∪ S (Fin.last k) else S j.castSucc :=
        fun j => by
          show Function.update (Fin.init S) i (S i.castSucc ∪ S (Fin.last k)) j = _
          by_cases hj : j = i
          · subst hj
            rw [Function.update_self, if_pos rfl]
          · rw [Function.update_of_ne hj, if_neg hj]
            rfl
      have hm := brace_mem_Im k S₀ S' x
        (Function.update (Fin.init Y) i (graftMul R (Fin.init Y i) (Y (Fin.last k)))) hx
        (fun j => by
          by_cases hj : j = i
          · subst hj
            rw [Function.update_self, hS'i, if_pos rfl]
            exact graftMul_mem_Im hdi (hY _) (hY _)
          · rw [Function.update_of_ne hj, hS'i, if_neg hj]
            exact hY _)
        (fun j => by
          rw [hS'i]
          split_ifs
          · exact Finset.disjoint_union_right.2 ⟨h0 _, h0 _⟩
          · exact h0 _)
        (fun j j' hjj => by
          rw [hS'i, hS'i]
          split_ifs with h1 h2 h2
          · exact absurd (h1.trans h2.symm) hjj
          · subst h1
            exact Finset.disjoint_union_left.2
              ⟨hS _ _ fun e => hjj (Fin.castSucc_injective _ e),
                (hS _ _ (Fin.castSucc_lt_last j').ne).symm⟩
          · subst h2
            exact Finset.disjoint_union_right.2
              ⟨hS _ _ fun e => hjj (Fin.castSucc_injective _ e),
                hS _ _ (Fin.castSucc_lt_last j).ne⟩
          · exact hS _ _ fun e => hjj (Fin.castSucc_injective _ e))
      refine Im_congr ?_ hm
      ext a
      simp only [Finset.mem_union, Finset.mem_biUnion, Finset.mem_univ, true_and, hS'i,
        Fin.exists_fin_succ']
      constructor
      · rintro (h1 | ⟨j, hj⟩)
        · exact Or.inl h1
        · split_ifs at hj with hji
          · rcases Finset.mem_union.1 hj with h2 | h2
            · exact Or.inr (Or.inl ⟨i, h2⟩)
            · exact Or.inr (Or.inr h2)
          · exact Or.inr (Or.inl ⟨j, hj⟩)
      · rintro (h1 | ⟨j, hj⟩ | h1)
        · exact Or.inl h1
        · by_cases hji : j = i
          · subst hji
            exact Or.inr ⟨j, by rw [if_pos rfl]; exact Finset.mem_union_left _ hj⟩
          · exact Or.inr ⟨j, by rw [if_neg hji]; exact hj⟩
        · exact Or.inr ⟨i, by rw [if_pos rfl]; exact Finset.mem_union_right _ h1⟩

/-- **Every tree is the action of an operation on the trees with one vertex.** -/
theorem single_mem_Im :
    ∀ (n : ℕ) (T : RootedTree Λ), T.S.card = n → Finsupp.single T (1 : R) ∈ Im R T.S := by
  intro n
  induction n using Nat.strong_induction_on with
  | _ n ih =>
    intro T hn
    classical
    let k := Fintype.card ↥(children T)
    let e : Fin k ≃ ↥(children T) := (Fintype.equivFin _).symm
    have hOK := joinOK_subtrees T e
    have hT : T = joinF T.root k (fun i => subtree T (e i)) := eq_joinF T e
    have hb := brace_single_joinF (R := R) T.root k _ hOK
    rw [← hT] at hb
    rw [← hb]
    refine Im_congr ?_ (brace_mem_Im k {T.root} (fun i => (subtree T (e i)).S) _ _
      (vtx_mem_Im T.root) (fun i => ih _ (hn ▸ card_subtree_lt (e i).2) _ rfl)
      (fun i => Finset.disjoint_singleton_left.2 (hOK.not_mem i)) hOK.disj)
    rw [← Finset.insert_eq]
    conv_rhs => rw [hT]
    exact (joinF_S hOK).symm

end PreLie

/-! ## The pre-Lie operad is the operad of rooted trees -/

/-- **The labelled rooted trees with vertex set `A`.** -/
abbrev RTree (A : Type) [Fintype A] : Type :=
  {T : RootedTree A // T.S = Finset.univ}

lemma RootedTree.injective_data {A : Type} : Function.Injective
    fun T : RootedTree A => (T.S, T.par, T.root) := fun T U h => by
  simp only [Prod.mk.injEq] at h
  ext a
  · rw [h.1]
  · rw [h.2.1]
  · rw [h.2.2]

instance (A : Type) [Fintype A] [DecidableEq A] : Finite (RootedTree A) :=
  Finite.of_injective _ RootedTree.injective_data

noncomputable instance (A : Type) [Fintype A] [DecidableEq A] : Fintype (RTree A) :=
  Fintype.ofFinite _

namespace PreLie

open RootedTree

variable {R : Type u} [CommRing R] {A : Type} [Fintype A] [DecidableEq A]

variable (R A) in
/-- **The action of an operation on the trees with one vertex.** -/
noncomputable def treeAct : PreLie R A →ₗ[R] (RootedTree A →₀ R) where
  toFun p := (graftAlg R A).act p fun a => Finsupp.single (vtx a) 1
  map_add' x y := act_add' _ x y _
  map_smul' c x := act_smul' _ c x _

lemma treeAct_apply (p : PreLie R A) :
    treeAct R A p = (graftAlg R A).act p fun a => Finsupp.single (vtx a) 1 := rfl

/-- **The actions on the trees with one vertex are the combinations of the trees with vertex set
`A`.** -/
theorem range_treeAct : LinearMap.range (treeAct R A) = supp R (Finset.univ : Finset A) := by
  apply le_antisymm
  · rintro _ ⟨p, rfl⟩
    have h := (act_supp_tv (graftAlg R A) (fun _ => (0 : RootedTree A →₀ R)) p (fun a => {a})
      (fun a => Finsupp.single (vtx a) 1) (fun a => single_mem_supp rfl)
      fun a a' h => Finset.disjoint_singleton.2 h).1
    have hU : (Finset.univ.biUnion fun a : A => ({a} : Finset A)) = Finset.univ := by
      ext a
      simp
    rw [hU] at h
    exact h
  · rw [supp, Finsupp.supported_eq_span_single, Submodule.span_le]
    rintro _ ⟨T, hT, rfl⟩
    obtain ⟨p, hp⟩ := single_mem_Im (R := R) _ T rfl
    let E : ↥T.S ≃ A := (Equiv.subtypeEquivRight fun a => by
      rw [show T.S = Finset.univ from hT]; simp).trans (Equiv.subtypeUnivEquiv fun _ => trivial)
    refine ⟨SymOperad.map (R := R) E p, ?_⟩
    rw [treeAct_apply, SymAlgebra.act_map]
    exact hp

/-- **The pre-Lie operad acts freely on the trees with one vertex.** -/
lemma treeAct_injective' : Function.Injective (treeAct R A) := treeAct_injective A

variable (R A) in
/-- **The pre-Lie operad is the operad of rooted trees**: an operation with inputs `A` is a
combination of labelled rooted trees with vertex set `A`, by its action on the trees with one
vertex (Chapoton and Livernet). -/
noncomputable def treeEquiv : PreLie R A ≃ₗ[R] (RTree A →₀ R) :=
  (LinearEquiv.ofInjective (treeAct R A) treeAct_injective').trans
    ((LinearEquiv.ofEq _ _ range_treeAct).trans
      (Finsupp.supportedEquivFinsupp {T : RootedTree A | T.S = Finset.univ}))

/-- The tree of the action of an operation. -/
lemma treeEquiv_apply (p : PreLie R A) (T : RTree A) :
    treeEquiv R A p T = treeAct R A p T.1 := rfl

/-- **The pre-Lie product is the tree with two vertices**, `0` the root and `1` its child. -/
lemma treeAct_mu : treeAct R (Fin 2) (mu R)
    = Finsupp.single (graft (vtx (0 : Fin 2)) (vtx 1) 0) 1 := by
  rw [treeAct_apply, graftAlg_act_mu, graftMul_single]
  unfold graftProd
  rw [vtx_S, vtx_S, if_pos (Finset.disjoint_singleton.2 (by decide)), Finset.sum_singleton]

end PreLie

/-- **The dimension of the pre-Lie operad is the number of labelled rooted trees**, over a
field. -/
theorem PreLie.finrank_eq_card (K : Type u) [Field K] (A : Type) [Fintype A] [DecidableEq A] :
    Module.finrank K (PreLie K A) = Fintype.card (RTree A) := by
  rw [(PreLie.treeEquiv K A).finrank_eq, Module.finrank_finsupp_self]


/-- **Cayley's formula for rooted trees**: there are `nⁿ⁻¹` labelled rooted trees on `n ≥ 1`
vertices. -/
theorem card_RTree (A : Type) [Fintype A] [DecidableEq A] [Nonempty A] :
    Fintype.card (RTree A) = Fintype.card A ^ (Fintype.card A - 1) := by
  rw [← Cayley.card_sigma_forests, ← Finset.card_univ]
  refine Finset.card_bij (fun T _ => (⟨T.1.root, T.1.par⟩ : Σ _ : A, A → A)) ?_ ?_ ?_
  · intro T _
    show (⟨T.1.root, T.1.par⟩ : Σ _ : A, A → A) ∈ _
    refine Finset.mem_sigma.2 ⟨Finset.mem_univ _, Cayley.mem_forests.2 ⟨?_, ?_, ?_⟩⟩
    · intro a ha
      have har : a = T.1.root := by
        by_contra h'
        exact ha (Finset.mem_sdiff.2 ⟨Finset.mem_univ a, by simpa using h'⟩)
      rw [har]
      exact T.1.par_root
    · intro a _
      exact Finset.mem_univ _
    · obtain ⟨d, hd⟩ := T.1.acyc
      have hS : ∀ a, a ∈ T.1.S := fun a => by rw [T.2]; exact Finset.mem_univ a
      refine ⟨d, fun a ha => hd a (hS a) ?_⟩
      simpa using (Finset.mem_sdiff.1 ha).2
  · intro T₁ _ T₂ _ h
    simp only [Sigma.mk.inj_iff, heq_eq_eq] at h
    exact Subtype.ext (RootedTree.ext (T₁.2.trans T₂.2.symm) h.2 h.1)
  · rintro ⟨r, f⟩ hf
    obtain ⟨-, hf⟩ := Finset.mem_sigma.1 hf
    obtain ⟨h1, -, d, hd⟩ := Cayley.mem_forests.1 hf
    let T : RootedTree A :=
      { S := Finset.univ
        par := f
        root := r
        root_mem := Finset.mem_univ r
        par_root := h1 r (by simp)
        par_not_mem := fun a ha => absurd (Finset.mem_univ a) ha
        par_mem := fun a _ => Finset.mem_univ _
        acyc := ⟨d, fun a _ har => hd a (by simpa using har)⟩ }
    exact ⟨⟨T, rfl⟩, Finset.mem_univ _, rfl⟩

/-- **`dim PreLie(n) = nⁿ⁻¹`**: the pre-Lie operad has dimension `nⁿ⁻¹` on a set of `n ≥ 1`
inputs, over a field (Chapoton and Livernet). -/
theorem PreLie.finrank_eq (K : Type u) [Field K] (A : Type) [Fintype A] [DecidableEq A]
    [Nonempty A] : Module.finrank K (PreLie K A) = Fintype.card A ^ (Fintype.card A - 1) := by
  rw [PreLie.finrank_eq_card, card_RTree]

end Operad
