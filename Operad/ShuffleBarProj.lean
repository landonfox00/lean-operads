/-
# The bar construction of the presented operad as a quotient

Step (2c) of the bridge between symmetric and shuffle operads (Dotsenko–Khoroshkin), second part.
Let `E` be a graded linear species over a field `K` with an even basis `c k` of each `E (Fin k)`
indexed by `BinGen G k`, `T = FreeGrL K E`, `Ī` its ideal of the operations with at least two
inputs, relators `r n ⊆ T (Fin n)`, `P = Koszul.Pres K E r = T/(r)` and `Ī_P` its ideal of the
operations with at least two inputs.

* **The projection of the bar constructions** (`ShuffleBarSym.barProjGen`): the projection
  `T → P` sends `Ī` into `Ī_P`, so it induces `B(T, Ī) → B(P, Ī_P)`, the morphism of free graded
  operads `FreeGrL.mapSp (ShuffleBarSym.barProjGen c hc r)` extending `sĪ → sĪ_P` (`Bar.mapGen`).
  It is **a chain map** (`ShuffleBarSym.barProj_d`, from `Bar.map_d`), **onto**
  (`ShuffleBarSym.barProj_surjective`: `sĪ → sĪ_P` is onto, `ShuffleBarSym.barProjGen_surjective`)
  and keeps the number of vertices; over a field of characteristic zero it maps the trees with `s`
  vertices onto those of `B(P, Ī_P)` (`ShuffleBarSym.exists_lift_vx`).
* **Its kernel** is the ideal `ShuffleBarSym.Krel` of `B(T, Ī)` generated by the suspended
  relators `s((r) ∩ Ī)`, the kernel of `sĪ → sĪ_P` (`ShuffleBarSym.barProjGen_eq_zero_iff`,
  `ShuffleBarSym.mem_Krel_iff`, from `FreeGrL.mem_kerSpan_iff`).
* **Homology of the quotient** (`ShuffleBarSym.lower_iff`): every cycle of `B(P, Ī_P)(Fin n)` with
  `s` vertices is the boundary of one with `s + 1` iff every tree `x` of `B(T, Ī)(Fin n)` with `s`
  vertices and `d x ∈ Krel` is `d y` modulo `Krel` for some `y` with `s + 1` vertices. Hence, for
  relators with at least three inputs, **`P` is Koszul iff for every `n ≥ 2` the comparison
  morphism `P^¡(n) → B(P, Ī_P)(n)` maps onto the cycles with `n - 1` vertices and the homology of
  `B(T, Ī)(Fin n) / Krel` vanishes below the top degree** (`ShuffleBarSym.isKoszul_iff_free`).
* **The shuffle relators** `ShuffleBarSym.Rsh`: the span of the coordinates of `r 3` in the basis
  `ShuffleBarSym.tBasis`. Through `ΦL : B(T, Ī)(Fin n) ≃ supported (barSet G n)`, which matches the
  vertex counts with the degrees `ShuffleBar.C` and the differentials (step 2b), the vanishing of
  the homology of `B(T, Ī)(Fin n) / Krel` below the top degree is the clause of
  `ShuffleBar.IsKoszul` in arity `n` as soon as `ΦL` maps `Krel` onto the relator subcomplex
  `ShuffleBar.J ⊓ supported (barSet G n)` (`ShuffleBarSym.lower_iff_shuffle`). So **`P` is Koszul
  iff `ShuffleBar.IsKoszul K R`, given that identification and the surjectivity of `P^¡` onto the
  top cycles** (`ShuffleBarSym.isKoszul_iff_shuffle_of`).

The surjectivity of `P^¡(n)` onto the cycles of `B(P, Ī_P)(Fin n)` with `n - 1` vertices is
proved in `Operad/ShuffleBarTop.lean` (`ShuffleBarSym.toBar_surj_top`), and the identification
`ΦL (Krel) = ShuffleBar.J K (Rsh c hc r) ⊓ supported (barSet G n)`, for relators of arity three
stable under the permutations of `Fin 3`, in `Operad/ShuffleBarJ.lean`
(`ShuffleBarSym.map_ΦL_Krel`), which completes step 2c (`ShuffleBarSym.isKoszul_iff_shuffle`).
-/
import Operad.ShuffleBarQuot
import Operad.BarMap

universe u v

namespace Operad

open Sym GerBV

namespace Bar

variable {K : Type u} [Field K] [CharZero K]
  {P : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (P A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (P A)] [GrOperad K P]
  {P' : (A : Type) → [Fintype A] → [DecidableEq A] → Type v}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (P' A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (P' A)] [GrOperad K P']
  (I : GrOperadIdeal K P) (I' : GrOperadIdeal K P')
  (hI1 : ∀ (B : Type) [Fintype B] [DecidableEq B], Fintype.card B ≤ 1 → ∀ y ∈ I.sub B, y = 0)
  {n : ℕ} (π : FreeGrL K (BarGen I) (Fin n) →ₗ[K] FreeGrL K (BarGen I') (Fin n))
  (hπ : Function.Surjective π)
  (hπv : ∀ j y, y ∈ FreeGrL.vx K (BarGen I) j (Fin n) → π y ∈ FreeGrL.vx K (BarGen I') j (Fin n))

include hI1 hπ hπv in
/-- **A surjection of bar constructions keeping the number of vertices maps the trees with `s`
vertices onto those with `s` vertices.** -/
theorem exists_lift_vx_of {s : ℕ} {z : FreeGrL K (BarGen I') (Fin n)}
    (hz : z ∈ FreeGrL.vx K (BarGen I') s (Fin n)) :
    ∃ x ∈ FreeGrL.vx K (BarGen I) s (Fin n), π x = z := by
  obtain ⟨x', rfl⟩ := hπ z
  obtain ⟨cc, hcc, rfl⟩ := exists_decomp I hI1 x'
  refine ⟨cc s, hcc s, (sub_eq_zero.1 (eq_zero_of_mem_iSup_ne I' (s := s)
    (Submodule.sub_mem _ hz (hπv _ _ (hcc s))) ?_)).symm⟩
  rw [map_sum]
  by_cases hs : s ∈ Finset.range n
  · rw [← Finset.add_sum_erase _ _ hs, add_sub_cancel_left]
    exact Submodule.sum_mem _ fun j hj => Submodule.mem_iSup_of_mem j
      (Submodule.mem_iSup_of_mem (Finset.ne_of_mem_erase hj) (hπv _ _ (hcc j)))
  · rw [vx_eq_zero I hI1 (by simpa using hs) (hcc s), map_zero, sub_zero]
    exact Submodule.sum_mem _ fun j hj => Submodule.mem_iSup_of_mem j
      (Submodule.mem_iSup_of_mem (fun h => hs (h ▸ hj)) (hπv _ _ (hcc j)))

include hI1 hπ hπv in
/-- **The homology of a quotient of bar constructions**: for a surjective chain map `π` keeping
the number of vertices, with kernel `𝒦`, every cycle of the target with `s` vertices is the
boundary of one with `s + 1` iff every `x` with `s` vertices and `d x ∈ 𝒦` is `d y` modulo `𝒦`
for some `y` with `s + 1` vertices. -/
theorem lower_iff_of (hπd : ∀ y, π (d I (Fin n) y) = d I' (Fin n) (π y))
    (𝒦 : Submodule K (FreeGrL K (BarGen I) (Fin n))) (hker : ∀ x, x ∈ 𝒦 ↔ π x = 0) {s : ℕ} :
    (∀ z ∈ FreeGrL.vx K (BarGen I') s (Fin n), d I' (Fin n) z = 0 →
      ∃ w ∈ FreeGrL.vx K (BarGen I') (s + 1) (Fin n), d I' (Fin n) w = z) ↔
    ∀ x ∈ FreeGrL.vx K (BarGen I) s (Fin n), d I (Fin n) x ∈ 𝒦 →
      ∃ y ∈ FreeGrL.vx K (BarGen I) (s + 1) (Fin n), x - d I (Fin n) y ∈ 𝒦 := by
  constructor
  · intro h x hx hdx
    rw [hker, hπd] at hdx
    obtain ⟨w, hw, hdw⟩ := h _ (hπv _ _ hx) hdx
    obtain ⟨y, hy, rfl⟩ := exists_lift_vx_of I I' hI1 π hπ hπv hw
    refine ⟨y, hy, ?_⟩
    rw [hker, map_sub, hπd, hdw, sub_self]
  · intro h z hz hdz
    obtain ⟨x, hx, rfl⟩ := exists_lift_vx_of I I' hI1 π hπ hπv hz
    obtain ⟨y, hy, hxy⟩ := h x hx (by rw [hker, hπd, hdz])
    rw [hker, map_sub, hπd, sub_eq_zero] at hxy
    exact ⟨_, hπv _ _ hy, hxy.symm⟩

end Bar

/-- **Homology modulo subspaces, transported along an injective chain map**: for `Φ : V → W`
injective, intertwining `d_V` and `d_W`, mapping the degrees `V_t` onto `W_t` and `𝒦` onto
`J ∩ range Φ`, every `x ∈ V_s` with `d x ∈ 𝒦` is `d y` modulo `𝒦` for some `y ∈ V_{s+1}` iff
the same holds in `W` modulo `J`. -/
theorem Submodule.lower_iff_of_map {R : Type*} [CommRing R] {V W : Type*} [AddCommGroup V]
    [Module R V] [AddCommGroup W] [Module R W] {dV : V →ₗ[R] V} {dW : W →ₗ[R] W} (Φ : V →ₗ[R] W)
    (hΦ : Function.Injective Φ) (hd : ∀ x, Φ (dV x) = dW (Φ x)) (Vs : ℕ → Submodule R V)
    (Ws : ℕ → Submodule R W) (hVW : ∀ t, Submodule.map Φ (Vs t) = Ws t) (𝒦 : Submodule R V)
    (J : Submodule R W) (hJ : Submodule.map Φ 𝒦 = J ⊓ LinearMap.range Φ) (s : ℕ) :
    (∀ x ∈ Vs s, dV x ∈ 𝒦 → ∃ y ∈ Vs (s + 1), x - dV y ∈ 𝒦) ↔
    ∀ X ∈ Ws s, dW X ∈ J → ∃ Y ∈ Ws (s + 1), X - dW Y ∈ J := by
  have hmem : ∀ x, Φ x ∈ J ↔ x ∈ 𝒦 := fun x => by
    constructor
    · intro h
      have h' : Φ x ∈ J ⊓ LinearMap.range Φ := ⟨h, LinearMap.mem_range_self _ x⟩
      rw [← hJ] at h'
      obtain ⟨k, hk, hkx⟩ := h'
      rwa [← hΦ hkx]
    · intro h
      have h' : Φ x ∈ Submodule.map Φ 𝒦 := Submodule.mem_map_of_mem h
      rw [hJ] at h'
      exact h'.1
  have hC : ∀ t X, X ∈ Ws t ↔ ∃ x ∈ Vs t, Φ x = X := fun t X => by
    rw [← hVW t]
    rfl
  constructor
  · intro h X hX hdX
    obtain ⟨x, hx, rfl⟩ := (hC s X).1 hX
    rw [← hd, hmem] at hdX
    obtain ⟨y, hy, hxy⟩ := h x hx hdX
    refine ⟨Φ y, (hC _ _).2 ⟨y, hy, rfl⟩, ?_⟩
    rw [← hd, ← map_sub, hmem]
    exact hxy
  · intro h x hx hdx
    rw [← hmem, hd] at hdx
    obtain ⟨Y, hY, hXY⟩ := h _ ((hC s _).2 ⟨x, hx, rfl⟩) hdx
    obtain ⟨y, hy, rfl⟩ := (hC _ Y).1 hY
    refine ⟨y, hy, ?_⟩
    rw [← hmem, map_sub, hd]
    exact hXY

namespace ShuffleBarSym

variable {K : Type u} [Field K] {E : (A : Type) → [Fintype A] → [DecidableEq A] → Type u}
  [∀ (A : Type) [Fintype A] [DecidableEq A], AddCommGroup (E A)]
  [∀ (A : Type) [Fintype A] [DecidableEq A], Module K (E A)] [GrSpecies K E]
  {G : Type} [Fintype G] [DecidableEq G]
  (c : ∀ k, Module.Basis (BinGen G k) K (E (Fin k)))
  (hc : ∀ k (β : BinGen G k), GrSpecies.par (R := K) false (c k β) = c k β)
  (r : ∀ n : ℕ, Set (FreeGrL K E (Fin n)))

local notation "𝒥" => GrOperadIdeal.span K r

/-- **The projection sends `Ī` into `Ī_P`.** -/
lemma proj_mem_Ipres {A : Type} [Fintype A] [DecidableEq A] (x : FreeGrL K E A)
    (hx : x ∈ (Ibar K E c hc).sub A) : (𝒥).proj A x ∈ (Ipres K E c hc r).sub A := by
  by_cases h : 2 ≤ Fintype.card A
  · rw [GrOperadIdeal.atLeastTwo_sub_of_le h]
    trivial
  · rw [GrOperadIdeal.atLeastTwo_sub_of_lt (by omega), Submodule.mem_bot] at hx
    rw [hx, map_zero]
    exact zero_mem _

/-- **The projection of the suspended ideals** `sĪ → sĪ_P`. -/
noncomputable def barProjGen :
    GrSpeciesHom K (BarGen (Ibar K E c hc)) (BarGen (Ipres K E c hc r)) :=
  Bar.mapGen (𝒥).projHom fun _ _ _ x hx => proj_mem_Ipres c hc r x hx

lemma val_barProjGen {A : Type} [Fintype A] [DecidableEq A] (w : BarGen (Ibar K E c hc) A) :
    IdealSp.val _ ((barProjGen c hc r).app A w) = (𝒥).proj A (IdealSp.val _ w) := rfl

/-- **The kernel of `sĪ → sĪ_P` is the suspension of `(r) ∩ Ī`.** -/
lemma barProjGen_eq_zero_iff {A : Type} [Fintype A] [DecidableEq A]
    (w : BarGen (Ibar K E c hc) A) :
    (barProjGen c hc r).app A w = 0 ↔ IdealSp.val _ w ∈ (𝒥).sub A := by
  rw [← GrOperadIdeal.proj_eq_zero_iff, ← val_barProjGen]
  exact ⟨fun h => by rw [h]; rfl, fun h => IdealSp.ext _ h⟩

/-- **`sĪ → sĪ_P` is onto.** -/
theorem barProjGen_surjective (A : Type) [Fintype A] [DecidableEq A] :
    Function.Surjective ((barProjGen c hc r).app A) := by
  intro w
  by_cases h : 2 ≤ Fintype.card A
  · obtain ⟨y, hy⟩ := (𝒥).proj_surjective A (IdealSp.val _ w)
    refine ⟨IdealSp.mk _ y (by rw [GrOperadIdeal.atLeastTwo_sub_of_le h]; trivial),
      IdealSp.ext _ ?_⟩
    rw [val_barProjGen]
    exact hy
  · have hw : IdealSp.val _ w = 0 := by
      have := IdealSp.mem _ w
      rwa [GrOperadIdeal.atLeastTwo_sub_of_lt (by omega), Submodule.mem_bot] at this
    exact ⟨0, IdealSp.ext _ (by rw [map_zero, hw]; rfl)⟩

/-- **The projection `B(T, Ī) → B(P, Ī_P)` is onto.** -/
theorem barProj_surjective (A : Type) [Fintype A] [DecidableEq A] :
    Function.Surjective ((FreeGrL.mapSp (barProjGen c hc r)).app A) :=
  FreeGrL.mapSp_surjective _ (barProjGen_surjective c hc r) A

/-- **The projection `B(T, Ī) → B(P, Ī_P)` is a chain map.** -/
theorem barProj_d {A : Type} [Fintype A] [DecidableEq A]
    (x : FreeGrL K (BarGen (Ibar K E c hc)) A) :
    (FreeGrL.mapSp (barProjGen c hc r)).app A (Bar.d (Ibar K E c hc) A x)
      = Bar.d (Ipres K E c hc r) A ((FreeGrL.mapSp (barProjGen c hc r)).app A x) :=
  Bar.map_d _ _ x

variable (K E) in
/-- **The relator ideal of the bar construction**: the ideal of `B(T, Ī)` generated by the
suspended relators, the kernel of `sĪ → sĪ_P`. -/
noncomputable abbrev Krel : GrOperadIdeal K (FreeGrL K (BarGen (Ibar K E c hc))) :=
  FreeGrL.kerSpan K (barProjGen c hc r)

/-- **The kernel of `B(T, Ī) → B(P, Ī_P)` is the relator ideal.** -/
theorem mem_Krel_iff {A : Type} [Fintype A] [DecidableEq A]
    (x : FreeGrL K (BarGen (Ibar K E c hc)) A) :
    x ∈ (Krel K E c hc r).sub A ↔ (FreeGrL.mapSp (barProjGen c hc r)).app A x = 0 :=
  FreeGrL.mem_kerSpan_iff _ (barProjGen_surjective c hc r) x

local notation "𝒱T" => FreeGrL.vx K (BarGen (Ibar K E c hc))
local notation "𝒱P" => FreeGrL.vx K (BarGen (Ipres K E c hc r))

variable [CharZero K]

/-- **The trees with `s` vertices of `B(P, Ī_P)` lift to trees with `s` vertices of
`B(T, Ī)`.** -/
theorem exists_lift_vx {n s : ℕ} {z : FreeGrL K (BarGen (Ipres K E c hc r)) (Fin n)}
    (hz : z ∈ 𝒱P s (Fin n)) :
    ∃ x ∈ 𝒱T s (Fin n), (FreeGrL.mapSp (barProjGen c hc r)).app (Fin n) x = z :=
  Bar.exists_lift_vx_of (Ibar K E c hc) (Ipres K E c hc r)
    (GrOperadIdeal.atLeastTwo_hI1 (free_zero c hc)) _ (barProj_surjective c hc r (Fin n))
    (fun _ _ hy => FreeGrL.mapSp_mem_vx hy) hz

/-- **The homology of `B(P, Ī_P)` in `B(T, Ī)` modulo the relator ideal**: in arity `n`, every
cycle with `s` vertices is the boundary of one with `s + 1` iff every tree `x` with `s` vertices
of `B(T, Ī)` with `d x ∈ Krel` is a boundary `d y` modulo `Krel`, `y` with `s + 1` vertices. -/
theorem lower_iff {n s : ℕ} :
    (∀ z ∈ 𝒱P s (Fin n), Bar.d (Ipres K E c hc r) (Fin n) z = 0 →
      ∃ w ∈ 𝒱P (s + 1) (Fin n), Bar.d (Ipres K E c hc r) (Fin n) w = z) ↔
    ∀ x ∈ 𝒱T s (Fin n), Bar.d (Ibar K E c hc) (Fin n) x ∈ (Krel K E c hc r).sub (Fin n) →
      ∃ y ∈ 𝒱T (s + 1) (Fin n),
        x - Bar.d (Ibar K E c hc) (Fin n) y ∈ (Krel K E c hc r).sub (Fin n) :=
  Bar.lower_iff_of (Ibar K E c hc) (Ipres K E c hc r)
    (GrOperadIdeal.atLeastTwo_hI1 (free_zero c hc)) _ (barProj_surjective c hc r (Fin n))
    (fun _ _ hy => FreeGrL.mapSp_mem_vx hy) (barProj_d c hc r) _ (mem_Krel_iff c hc r)

variable {r} in
include hc in
/-- **The Koszul criterion for binary quadratic data, in the free bar construction**: for
relators with at least three inputs, over a field of characteristic zero, `P` is Koszul iff for
every `n ≥ 2` the comparison morphism `P^¡(n) → B(P, Ī_P)(n)` maps onto the cycles with `n - 1`
vertices, and in `B(T, Ī)(Fin n)` modulo the relator ideal `Krel` every cycle with `s + 1 < n`
vertices is the boundary of one with `s + 1`. -/
theorem isKoszul_iff_free (hr2 : ∀ n, n < 3 → r n = ∅) :
    Koszul.IsKoszul K E r ↔ ∀ n, 2 ≤ n →
      (∀ z ∈ 𝒱P (n - 1) (Fin n), Bar.d (Ipres K E c hc r) (Fin n) z = 0 →
        ∃ x, (Koszul.toBar (Ipres K E c hc r) (hE_pres c hc r)).app (Fin n) x = z) ∧
      ∀ s, s + 1 < n → ∀ x ∈ 𝒱T s (Fin n),
        Bar.d (Ibar K E c hc) (Fin n) x ∈ (Krel K E c hc r).sub (Fin n) →
        ∃ y ∈ 𝒱T (s + 1) (Fin n),
          x - Bar.d (Ibar K E c hc) (Fin n) y ∈ (Krel K E c hc r).sub (Fin n) :=
  (isKoszul_iff_cycles c hc r hr2).trans (forall_congr' fun _ => imp_congr_right fun _ =>
    and_congr_right fun _ => forall_congr' fun _ => imp_congr_right fun _ => lower_iff c hc r)

omit [CharZero K] in
/-- **The shuffle relators**: the coordinates of the relators of arity three in the basis
`tBasis` of `T (Fin 3)`, as functions on the shuffle monomials of arity three. -/
noncomputable def Rsh : Submodule K (LTree.Mono G 3 → K) :=
  Submodule.span K ((fun x σ => (tBasis c hc (Fin 3)).repr x
    ⟨σ.1, (Fintype.card_fin 3).symm ▸ σ.2⟩) '' r 3)

/-- **The homology of `B(T, Ī) / Krel` below the top degree is that of the shuffle bar
construction modulo the relator subcomplex**, given that `ΦL` maps `Krel` onto
`ShuffleBar.J K R ⊓ supported (barSet G n)`: in arity `n ≥ 2`, the clause of `isKoszul_iff_free`
in degree `s` is the clause of `ShuffleBar.IsKoszul` in degree `s`. -/
theorem lower_iff_shuffle (R : Submodule K (LTree.Mono G 3 → K)) {n : ℕ} (hn : 2 ≤ n)
    (hJ : Submodule.map (ΦL c hc n) ((Krel K E c hc r).sub (Fin n))
      = ShuffleBar.J K R ⊓ Finsupp.supported K K (barSet G n)) (s : ℕ) :
    (∀ x ∈ 𝒱T s (Fin n), Bar.d (Ibar K E c hc) (Fin n) x ∈ (Krel K E c hc r).sub (Fin n) →
      ∃ y ∈ 𝒱T (s + 1) (Fin n),
        x - Bar.d (Ibar K E c hc) (Fin n) y ∈ (Krel K E c hc r).sub (Fin n)) ↔
    ∀ X ∈ ShuffleBar.C (E := G) K n s, ShuffleBar.d K X ∈ ShuffleBar.J K R →
      ∃ Y ∈ ShuffleBar.C (E := G) K n (s + 1), X - ShuffleBar.d K Y ∈ ShuffleBar.J K R :=
  Submodule.lower_iff_of_map (ΦL c hc n) (ΦL_injective c hc n) (ΦL_d c hc)
    (fun t => FreeGrL.vx K (BarGen (Ibar K E c hc)) t (Fin n))
    (fun t => ShuffleBar.C (E := G) K n t)
    (fun t => (congrArg (Submodule.map (ΦL c hc n)) (deg_eq_vx c hc n t)).symm.trans
      (map_ΦL_deg c hc hn t)) ((Krel K E c hc r).sub (Fin n))
    (ShuffleBar.J K R) (by rw [hJ, ΦL_range]) s

variable {r} in
include hc in
/-- **The bridge, given the two remaining identifications**: for relators with at least three
inputs, over a field of characteristic zero, if `ΦL` maps the relator ideal `Krel` onto
`ShuffleBar.J K R ⊓ supported (barSet G n)` in every arity `n ≥ 2` and `P^¡(n)` maps onto the
cycles of `B(P, Ī_P)(Fin n)` with `n - 1` vertices, then `P` is Koszul iff the shuffle operad
presented by `R` is (`ShuffleBar.IsKoszul`). -/
theorem isKoszul_iff_shuffle_of (hr2 : ∀ n, n < 3 → r n = ∅)
    (R : Submodule K (LTree.Mono G 3 → K))
    (hJ : ∀ n, 2 ≤ n → Submodule.map (ΦL c hc n) ((Krel K E c hc r).sub (Fin n))
      = ShuffleBar.J K R ⊓ Finsupp.supported K K (barSet G n))
    (htop : ∀ n, 2 ≤ n → ∀ z ∈ 𝒱P (n - 1) (Fin n), Bar.d (Ipres K E c hc r) (Fin n) z = 0 →
      ∃ x, (Koszul.toBar (Ipres K E c hc r) (hE_pres c hc r)).app (Fin n) x = z) :
    Koszul.IsKoszul K E r ↔ ShuffleBar.IsKoszul K R := by
  rw [isKoszul_iff_free c hc hr2]
  constructor
  · intro h n s hs
    exact (lower_iff_shuffle c hc r R (by omega) (hJ n (by omega)) s).1
      ((h n (by omega)).2 s hs)
  · intro h n hn
    exact ⟨htop n hn, fun s hs => (lower_iff_shuffle c hc r R hn (hJ n hn) s).2 (h n s hs)⟩

end ShuffleBarSym

end Operad
