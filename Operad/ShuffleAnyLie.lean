/-
# The Lie operad: the Jacobi rule is a quadratic Gröbner basis, and `dim Lie(n) = (n - 1)!`

As a shuffle operad, the Lie operad is generated by the bracket, one shuffle generator, with the
Jacobi rule `[[x₀, x₁], x₂] = [[x₀, x₂], x₁] + [x₀, [x₁, x₂]]` led by the left comb
(`LieSh.rules`, in `Operad.ShuffleIsoPoisLie`). The rule is one of the six rules of the Poisson
operad (`PoisShGen.rules`), and everything here is read off the Poisson operad.

* **Monomials in the bracket are Poisson monomials** (`LieSh.brM`), by relabelling the vertices
  (`STree.mapV`), which commutes with substitution, subtrees and replacement
  (`STree.mapV_subst`, `STree.get?_mapV`). A context of monomials in the bracket is a context of
  Poisson monomials (`LieSh.exists_ctx`), so **the ideal of the Jacobi rule maps into the ideal
  of the Poisson rules** (`LieSh.map_ideal_le`).
* **A monomial in the bracket is normal exactly when its Poisson monomial is**
  (`LieSh.normal_brM`, `LieSh.normal_of_brM`): the leading monomials of the five other rules
  contain a product.
* Hence **the normal monomials are independent modulo the ideal** (`LieSh.disjoint_normal`),
  those of the Poisson operad being so; every ambiguity is resolvable (`LieSh.res_amb`), **the
  Jacobi rule is a quadratic Gröbner basis and the Lie operad is Koszul** (`LieSh.isKoszul`),
  and the normal monomials are a PBW basis (`LieSh.basis`).
* **There are `(|A| - 1)!` normal monomials on `A`** (`LieSh.card_irr`). The reading word of
  `Operad.PoisDim` is a bijection from the normal Poisson monomials on `A` to the arrangements
  of `A` (`LieSh.exists_pois_read_eq`); a normal Poisson monomial has no product exactly when
  its reading word begins with the least leaf (`PoisDim.read_lie`, `LieSh.isLie_of_read`,
  `LieSh.exists_mapV_eq`). So the rest of the reading word is a bijection from the normal
  monomials in the bracket to the arrangements of the other leaves
  (`LieSh.tailRead_bijective`).
* **`dim Lie(n) = (n - 1)!`** (`Lie.finrank_eq`), through the isomorphism `LieSh.presIso`.
-/
import Operad.ShuffleIsoPoisLie
import Operad.ShuffleBarJ

universe u w x

namespace Operad

open STree

/-! ## Relabelling the vertices of a tree -/

namespace STree

variable {B : ℕ → Type w} {B' : ℕ → Type x} (g : ∀ k, B k → B' k)

/-- **Relabelling the vertices commutes with substitution at the leaves.** -/
lemma mapV_subst : ∀ (t : STree B) (xs : ℕ → STree B),
    (t.subst xs).mapV g = (t.mapV g).subst fun a => (xs a).mapV g
  | leaf _, _ => rfl
  | node β c, xs => by
    rw [subst_node, mapV_node, mapV_node, subst_node]
    congr 1
    funext j
    exact mapV_subst (c j) xs

/-- **Relabelling the vertices commutes with taking a subtree.** -/
lemma get?_mapV : ∀ (p : List ℕ) (t : STree B), (t.mapV g).get? p = (t.get? p).map (mapV g)
  | [], t => by simp
  | _ :: _, leaf _ => rfl
  | i :: p, node β c => by
    rw [mapV_node, get?_node_cons, get?_node_cons]
    split_ifs with h
    · exact get?_mapV p (c ⟨i, h⟩)
    · rfl

/-- Relabelling the vertices along injective maps is injective. -/
lemma mapV_injective (hg : ∀ k, Function.Injective (g k)) : Function.Injective (mapV g) := by
  intro t
  induction t with
  | leaf a =>
    intro t' h
    cases t' with
    | leaf b =>
      rw [mapV_leaf, mapV_leaf] at h
      rw [STree.leaf.inj h]
    | node β' c' =>
      rw [mapV_leaf, mapV_node] at h
      cases h
  | node β c ih =>
    intro t' h
    cases t' with
    | leaf b =>
      rw [mapV_leaf, mapV_node] at h
      cases h
    | node β' c' =>
      rw [mapV_node, mapV_node] at h
      obtain ⟨rfl, hβ, hc⟩ := STree.node.inj h
      obtain rfl := hg _ (eq_of_heq hβ)
      congr 1
      funext j
      exact ih j (congrFun (eq_of_heq hc) j)

end STree

namespace LieSh

variable (K : Type u) [Field K]

/-! ## Lie monomials as Poisson monomials -/

/-- The bracket of the Poisson operad, for the generator of the Lie operad. -/
def toBr : ∀ k, ComGen k → PoisShGen k
  | _, .mu => .br

lemma toBr_injective (k : ℕ) : Function.Injective (toBr k) := fun a b _ => by
  cases a
  cases b
  rfl

/-- **A monomial in the bracket as a Poisson monomial.** -/
def brM {A : Finset ℕ} (m : SMono ComGen A) : SMono PoisShGen A :=
  ⟨m.1.mapV toBr, (isShuffle_mapV toBr m.1).2 m.2.1, (labels_mapV toBr m.1).trans m.2.2⟩

lemma brM_injective (A : Finset ℕ) : Function.Injective (brM (A := A)) := fun _ _ h =>
  Subtype.ext (mapV_injective toBr toBr_injective (congrArg Subtype.val h))

lemma mapV_bin (x y : STree ComGen) :
    (ComGen.bin x y).mapV toBr = PoisShGen.bin .br (x.mapV toBr) (y.mapV toBr) := by
  rw [ComGen.bin, PoisShGen.bin, mapV_node]
  congr 1
  funext j
  fin_cases j <;> rfl

lemma brM_lcomb : brM ComGen.lcomb = PoisShGen.lcomb .br .br :=
  Subtype.ext (by
    show (ComGen.bin (ComGen.bin (leaf 0) (leaf 1)) (leaf 2)).mapV toBr = _
    rw [mapV_bin, mapV_bin]
    rfl)

lemma brM_tcomb : brM ComGen.tcomb = PoisShGen.tcomb .br .br :=
  Subtype.ext (by
    show (ComGen.bin (ComGen.bin (leaf 0) (leaf 2)) (leaf 1)).mapV toBr = _
    rw [mapV_bin, mapV_bin]
    rfl)

lemma brM_rcomb : brM ComGen.rcomb = PoisShGen.rcomb .br .br :=
  Subtype.ext (by
    show (ComGen.bin (leaf 0) (ComGen.bin (leaf 1) (leaf 2))).mapV toBr = _
    rw [mapV_bin, mapV_bin]
    rfl)

/-- **A context of monomials in the bracket is a context of Poisson monomials.** -/
lemma exists_ctx {A B : Finset ℕ} {f : SMono ComGen A → SMono ComGen B} (hf : IsSCtx f)
    (ℓ : SMono ComGen A) :
    ∃ f' : SMono PoisShGen A → SMono PoisShGen B, IsSCtx f' ∧ ∀ g, f' (brM g) = brM (f g) := by
  obtain ⟨p, xs, hp, hxs, hfe⟩ := hf.normal ℓ
  have hU : (brM (f ℓ)).1.get? p = some ((brM ℓ).1.subst fun a => (xs a).mapV toBr) := by
    show ((f ℓ).1.mapV toBr).get? p = _
    rw [get?_mapV, hp, Option.map_some, mapV_subst]
    rfl
  have hm : StrictMonoOn (fun a => ((xs a).mapV toBr).first) (A : Set ℕ) := fun a ha b hb hab => by
    simp only [first_mapV]
    exact hxs.mono (Finset.mem_coe.1 ha) (Finset.mem_coe.1 hb) hab
  refine ⟨ctxOf (brM (f ℓ)) p (brM ℓ) _ hU hm, isSCtx_ctxOf _ _ _ _ _ _, fun g => Subtype.ext ?_⟩
  show ((f ℓ).1.mapV toBr).replace p ((g.1.mapV toBr).subst fun a => (xs a).mapV toBr) =
    (f g).1.mapV toBr
  rw [hfe g, mapV_replace, mapV_subst]

/-- **The ideal of the Jacobi rule maps into the ideal of the rules of the Poisson operad.** -/
theorem map_ideal_le (A : Finset ℕ) :
    Submodule.map (Finsupp.lmapDomain K K (brM (A := A))) ((rules K).rw A).ideal ≤
      ((PoisShGen.rules K).rw A).ideal := by
  rw [Rules.ideal_eq_span, Submodule.map_span, Rules.ideal_eq_span]
  refine Submodule.span_le.2 ?_
  rintro _ ⟨_, ⟨r, f, hf, rfl⟩, rfl⟩
  obtain ⟨f', hf', hc⟩ := exists_ctx (f := f) hf ((rules K).lead r)
  refine Submodule.subset_span ⟨PoisShGen.Rule.jac, f', hf', ?_⟩
  show Finsupp.mapDomain brM (Finsupp.mapDomain f _) = _
  rw [← Finsupp.mapDomain_comp, show brM ∘ f = f' ∘ brM from funext fun g => (hc g).symm,
    Finsupp.mapDomain_comp]
  congr 1
  have key : Finsupp.mapDomain (brM (A := ComGen.three)) (Finsupp.single ComGen.lcomb (1 : K) -
      (Finsupp.single ComGen.tcomb 1 + Finsupp.single ComGen.rcomb 1)) =
    Finsupp.single (PoisShGen.lcomb .br .br) 1 -
      (Finsupp.single (PoisShGen.tcomb .br .br) 1 +
        Finsupp.single (PoisShGen.rcomb .br .br) 1) := by
    rw [Finsupp.mapDomain_sub, Finsupp.mapDomain_add, Finsupp.mapDomain_single,
      Finsupp.mapDomain_single, Finsupp.mapDomain_single, brM_lcomb, brM_tcomb, brM_rcomb]
  exact key

/-! ## Normal monomials -/

/-- A tree in the bracket whose Poisson tree is a vertex is a vertex, and that vertex is a
bracket. -/
lemma eq_bin_of_mapV {s : STree ComGen} {e : PoisShGen 2} {X Y : STree PoisShGen}
    (h : s.mapV toBr = PoisShGen.bin e X Y) :
    e = .br ∧ ∃ x y, s = ComGen.bin x y ∧ x.mapV toBr = X ∧ y.mapV toBr = Y := by
  cases s with
  | leaf a =>
    rw [mapV_leaf, PoisShGen.bin] at h
    cases h
  | node β c =>
    cases β
    rw [ComGen.node_eq_bin, mapV_bin, PoisShGen.bin, PoisShGen.bin] at h
    obtain ⟨-, he, hc⟩ := STree.node.inj h
    have hc' := eq_of_heq hc
    exact ⟨(eq_of_heq he).symm, c 0, c 1, ComGen.node_eq_bin c, congrFun hc' 0, congrFun hc' 1⟩

lemma subst_lcomb (x y z : STree ComGen) :
    ComGen.lcomb.1.subst (ComGen.ins x y z) = ComGen.bin (ComGen.bin x y) z := by
  simp only [ComGen.lcomb, ComGen.subst_bin, subst_leaf']
  rfl

/-- **A monomial in which the left comb occurs is not normal.** -/
lemma not_normal_of_get? {A : Finset ℕ} {m : SMono ComGen A} {p : List ℕ}
    {x y z : STree ComGen} (hp : m.1.get? p = some (ComGen.bin (ComGen.bin x y) z))
    (hxy : x.first < y.first) (hyz : y.first < z.first) : ¬ (rules K).Normal m := fun h =>
  have hU : m.1.get? p = some (ComGen.lcomb.1.subst (ComGen.ins x y z)) := by
    rw [hp, subst_lcomb]
  h () _ (isSCtx_ctxOf m p ComGen.lcomb _ hU (ComGen.strictMonoOn_ins hxy hyz))
    (ctxOf_self m p _ _ hU (ComGen.strictMonoOn_ins hxy hyz))

/-- **A normal monomial in the bracket is a normal Poisson monomial**: the leading monomials of
the other rules of the Poisson operad contain a product. -/
theorem normal_brM {A : Finset ℕ} {m : SMono ComGen A} (hm : (rules K).Normal m) :
    (PoisShGen.rules K).Normal (brM m) := by
  intro r f' hf' he
  obtain ⟨p, xs', hp, hxs, -⟩ := IsSCtx.normal hf' ((PoisShGen.rules K).lead r)
  rw [he] at hp
  have hp' : (m.1.get? p).map (mapV toBr) =
      some (((PoisShGen.rules K).lead r).1.subst xs') := (get?_mapV toBr p m.1).symm.trans hp
  obtain ⟨s, hs, hse⟩ := Option.map_eq_some_iff.1 hp'
  cases r
  · have h1 : s.mapV toBr =
        PoisShGen.bin .br (PoisShGen.bin .br (xs' 0) (xs' 1)) (xs' 2) := by
      rw [hse]
      show (PoisShGen.lcomb .br .br).1.subst xs' = _
      simp only [PoisShGen.lcomb, PoisShGen.subst_bin, subst_leaf']
    obtain ⟨-, a, z, rfl, ha, hz⟩ := eq_bin_of_mapV h1
    obtain ⟨-, x, y, rfl, hx, hy⟩ := eq_bin_of_mapV ha
    refine not_normal_of_get? K hs ?_ ?_ hm
    · have h : (xs' 0).first < (xs' 1).first := hxs.mono
        (Finset.mem_coe.2 (show (0 : ℕ) ∈ PoisShGen.three by decide))
        (Finset.mem_coe.2 (show (1 : ℕ) ∈ PoisShGen.three by decide)) (by decide)
      rwa [← hx, ← hy, first_mapV, first_mapV] at h
    · have h : (xs' 1).first < (xs' 2).first := hxs.mono
        (Finset.mem_coe.2 (show (1 : ℕ) ∈ PoisShGen.three by decide))
        (Finset.mem_coe.2 (show (2 : ℕ) ∈ PoisShGen.three by decide)) (by decide)
      rwa [← hy, ← hz, first_mapV, first_mapV] at h
  · have h1 : s.mapV toBr =
        PoisShGen.bin .br (xs' 0) (PoisShGen.bin .mul (xs' 1) (xs' 2)) := by
      rw [hse]
      show (PoisShGen.rcomb .br .mul).1.subst xs' = _
      simp only [PoisShGen.rcomb, PoisShGen.subst_bin, subst_leaf']
    obtain ⟨-, a, z, rfl, -, hz⟩ := eq_bin_of_mapV h1
    cases (eq_bin_of_mapV hz).1
  · have h1 : s.mapV toBr =
        PoisShGen.bin .br (PoisShGen.bin .mul (xs' 0) (xs' 2)) (xs' 1) := by
      rw [hse]
      show (PoisShGen.tcomb .br .mul).1.subst xs' = _
      simp only [PoisShGen.tcomb, PoisShGen.subst_bin, subst_leaf']
    obtain ⟨-, a, z, rfl, ha, -⟩ := eq_bin_of_mapV h1
    cases (eq_bin_of_mapV ha).1
  · have h1 : s.mapV toBr =
        PoisShGen.bin .br (PoisShGen.bin .mul (xs' 0) (xs' 1)) (xs' 2) := by
      rw [hse]
      show (PoisShGen.lcomb .br .mul).1.subst xs' = _
      simp only [PoisShGen.lcomb, PoisShGen.subst_bin, subst_leaf']
    obtain ⟨-, a, z, rfl, ha, -⟩ := eq_bin_of_mapV h1
    cases (eq_bin_of_mapV ha).1
  · have h1 : s.mapV toBr =
        PoisShGen.bin .mul (xs' 0) (PoisShGen.bin .mul (xs' 1) (xs' 2)) := by
      rw [hse]
      show (PoisShGen.rcomb .mul .mul).1.subst xs' = _
      simp only [PoisShGen.rcomb, PoisShGen.subst_bin, subst_leaf']
    cases (eq_bin_of_mapV h1).1
  · have h1 : s.mapV toBr =
        PoisShGen.bin .mul (PoisShGen.bin .mul (xs' 0) (xs' 2)) (xs' 1) := by
      rw [hse]
      show (PoisShGen.tcomb .mul .mul).1.subst xs' = _
      simp only [PoisShGen.tcomb, PoisShGen.subst_bin, subst_leaf']
    cases (eq_bin_of_mapV h1).1

/-- **A monomial in the bracket which is a normal Poisson monomial is normal.** -/
theorem normal_of_brM {A : Finset ℕ} {m : SMono ComGen A}
    (h : (PoisShGen.rules K).Normal (brM m)) : (rules K).Normal m := by
  intro r f hf he
  obtain ⟨f', hf', hc⟩ := exists_ctx (f := f) hf ((rules K).lead r)
  refine h PoisShGen.Rule.jac f' hf' ?_
  have h1 := hc ((rules K).lead r)
  rw [he] at h1
  exact (congrArg f' brM_lcomb.symm).trans h1

/-- **The normal monomials are independent modulo the ideal of the Jacobi rule**: their Poisson
monomials are normal, and independent modulo the larger ideal. -/
theorem disjoint_normal (A : Finset ℕ) :
    Disjoint (Finsupp.supported K K {t : SMono ComGen A | (rules K).Normal t})
      ((rules K).rw A).ideal := by
  rw [Submodule.disjoint_def]
  intro v hv hI
  have h1 : Finsupp.mapDomain brM v ∈
      Finsupp.supported K K {t : SMono PoisShGen A | (PoisShGen.rules K).Normal t} := by
    rw [Finsupp.mem_supported] at hv ⊢
    intro t ht
    classical
    obtain ⟨m, hm, rfl⟩ := Finset.mem_image.1 (Finsupp.mapDomain_support (Finset.mem_coe.1 ht))
    exact normal_brM K (hv (Finset.mem_coe.2 hm))
  have h2 : Finsupp.mapDomain brM v ∈ ((PoisShGen.rules K).rw A).ideal :=
    map_ideal_le K A ⟨v, hI, rfl⟩
  have h0 := Submodule.disjoint_def.1 (PoisShGen.disjoint_normal (K := K) A) _ h1 h2
  exact Finsupp.mapDomain_injective (brM_injective A) (h0.trans Finsupp.mapDomain_zero.symm)

/-- **Every ambiguity of the Jacobi rule is resolvable.** -/
theorem res_amb {C : Finset ℕ} {r₁ r₂ : Unit} (B : (rules K).Amb C r₁ r₂) : B.Res :=
  B.res_of_isCompl (disjoint_normal K C)

/-! ## PBW and Koszul -/

lemma weight_lead (r : Unit) : ((rules K).lead r).1.weight = 2 := rfl

lemma weight_tail (r : Unit) : ∀ m ∈ ((rules K).tail r).support, m.1.weight = 2 := by
  intro m hm
  classical
  rcases Finset.mem_union.1 (Finsupp.support_add hm) with h | h <;>
    rw [Finset.mem_singleton.1 (Finsupp.support_single_subset h)] <;> rfl

/-- **The Lie operad is Koszul**: the Jacobi rule is a quadratic Gröbner basis. -/
theorem isKoszul : (rules K).IsKoszul :=
  (rules K).isKoszul_of_critical (weight_lead K) (weight_tail K) fun B _ => res_amb K B

/-- **The PBW basis of the Lie operad**: on every set of leaves, the normal monomials are a basis
of the quotient by the ideal of the Jacobi rule. -/
noncomputable def basis (A : Finset ℕ) :
    Module.Basis ((rules K).rw A).Irr K ((SMono ComGen A →₀ K) ⧸ ((rules K).rw A).ideal) :=
  STree.basisOfCritical (rules K) ((rules K).hlead_of_quad (weight_lead K))
    (fun B _ => res_amb K B) A

/-! ## The number of normal monomials -/

omit [Field K] in
/-- The least leaf of a monomial on `A` is the least element of `A`. -/
lemma first_eq_min' {E : ℕ → Type} {A : Finset ℕ} (hA : A.Nonempty) (m : SMono E A) :
    m.1.first = A.min' hA :=
  le_antisymm (first_le m.isShuffle _ (m.mem_labels.2 (Finset.min'_mem A hA)))
    (Finset.min'_le A _ (m.mem_labels.1 (first_mem m.isShuffle)))

/-- The Poisson tree of a tree in the bracket has no product at the root. -/
lemma isLie_toPE_mapV (s : STree ComGen) : PoisDim.IsLie (PoisShGen.toPE (s.mapV toBr)) := by
  cases s with
  | leaf a =>
    intro g A B h
    cases h
  | node β c =>
    cases β
    rw [ComGen.node_eq_bin, mapV_bin, PoisShGen.toPE_bin]
    exact PoisDim.isLie_bracket (σ := 1)

/-- **A structurally normal Poisson tree without a product at the root is a tree in the
bracket.** -/
lemma exists_mapV_eq (s : STree PoisShGen) : PoisDim.NF (PoisShGen.toPE s) →
    PoisDim.IsLie (PoisShGen.toPE s) → ∃ s₀ : STree ComGen, s₀.mapV toBr = s := by
  induction s with
  | leaf a => exact fun _ _ => ⟨leaf a, rfl⟩
  | node e c ih =>
    intro hN hL
    cases e
    · rw [PoisShGen.node_eq_bin, PoisShGen.toPE_bin] at hL
      cases hL _ _ _ (PoisDim.kids_ndσ (PoisShGen.op .mul) 1 _ _)
    · rw [PoisShGen.node_eq_bin, PoisShGen.toPE_bin] at hN
      obtain ⟨a, ha⟩ := ih 0 (PoisDim.NF.left (σ := 1) hN) (PoisDim.NF.lie_left (σ := 1) hN)
      obtain ⟨b, hb⟩ := ih 1 (PoisDim.NF.right (σ := 1) hN) (PoisDim.NF.lie_right (σ := 1) hN)
      exact ⟨ComGen.bin a b, by rw [mapV_bin, ha, hb, PoisShGen.node_eq_bin]⟩

/-- **A Poisson monomial whose reading word begins with the least leaf has no product at the
root**: under a product the second input is read first, and its leaves are larger than the least
leaf of the first. -/
lemma isLie_of_read {A : Finset ℕ} (hA : A.Nonempty) {U : SMono PoisShGen A} {v : List ℕ}
    (hr : PoisDim.read (PoisShGen.toPE U.1) = A.min' hA :: v) :
    PoisDim.IsLie (PoisShGen.toPE U.1) := by
  have hfirst : (PoisShGen.toPE U.1).first = A.min' hA := by
    rw [PoisShGen.first_toPE]
    exact first_eq_min' hA U
  have hs := PoisShGen.isShuffle_toPE U.isShuffle
  generalize PoisShGen.toPE U.1 = t at hr hfirst hs
  cases t with
  | leaf a =>
    intro g A B h
    cases h
  | node e c =>
    obtain ⟨⟨g⟩, σ⟩ := e
    rw [PoisDim.node_eq_ndσ] at hr hfirst hs ⊢
    cases g
    · exfalso
      rw [PoisDim.read_mul] at hr
      obtain ⟨-, hY, hXY⟩ := PoisDim.isShuffle_ndσ hs
      rw [PoisDim.first_ndσ] at hfirst
      cases hy : PoisDim.read (c 1) with
      | nil => exact PoisDim.read_ne_nil _ hy
      | cons y ys =>
        rw [hy, List.cons_append] at hr
        have hy0 : y = A.min' hA := (List.cons.inj hr).1
        have hle := PoisDim.first_le_read hY (x := y) (by rw [hy]; exact List.mem_cons_self)
        omega
    · exact PoisDim.isLie_bracket

/-- **Every arrangement of `A` is the reading word of a normal Poisson monomial**: the reading
word is injective on the normal monomials, and there are `|A|!` of each. -/
theorem exists_pois_read_eq {A : Finset ℕ} (hA : A.Nonempty) {w : List ℕ}
    (hw : w ∈ AssShGen.arr A) :
    ∃ U : SMono PoisShGen A, (PoisShGen.rules K).Normal U ∧
      PoisDim.read (PoisShGen.toPE U.1) = w := by
  have hmem : ∀ U : SMono PoisShGen A, PoisDim.read (PoisShGen.toPE U.1) ∈ AssShGen.arr A :=
    fun U => AssShGen.mem_arr.2 (by rw [PoisDim.coe_read, PoisShGen.labels_toPE, U.labels_eq])
  let f : ((PoisShGen.rules K).rw A).Irr → AssShGen.arr A := fun U => ⟨_, hmem U.1⟩
  have hf : Function.Injective f := by
    rintro ⟨U, hU⟩ ⟨U', hU'⟩ h
    have h' : PoisDim.read (PoisShGen.toPE U.1) = PoisDim.read (PoisShGen.toPE U'.1) :=
      congrArg Subtype.val h
    rw [(PoisShGen.rules K).mem_irr_iff] at hU hU'
    have hn : ∀ V : SMono PoisShGen A, (PoisShGen.toPE V.1).labels.Nodup := fun V => by
      rw [PoisShGen.labels_toPE]
      exact V.nodup
    exact Subtype.ext (Subtype.ext (PoisShGen.toPE_injective (PoisDim.read_injective _ _
      (PoisShGen.nf_of_normal hU U.1 [] (get?_nil _))
      (PoisShGen.nf_of_normal hU' U'.1 [] (get?_nil _))
      (PoisShGen.isShuffle_toPE U.isShuffle) (PoisShGen.isShuffle_toPE U'.isShuffle)
      (hn U) (hn U') h')))
  have hcard : Nat.card (AssShGen.arr A) ≤ Nat.card ((PoisShGen.rules K).rw A).Irr := by
    rw [Nat.card_eq_fintype_card, Fintype.card_coe, AssShGen.card_arr,
      ← PoisShGen.finrank_eq_factorial (K := K) hA,
      Module.finrank_eq_nat_card_basis (PoisShGen.basis K A)]
  obtain ⟨U, hU⟩ := (hf.bijective_of_nat_card_le hcard).2 ⟨w, hw⟩
  exact ⟨U.1, (PoisShGen.rules K).mem_irr_iff.1 U.2, congrArg Subtype.val hU⟩

omit [Field K] in
lemma coe_eq_erase {A : Finset ℕ} {a : ℕ} {v : List ℕ}
    (h : ((a :: v : List ℕ) : Multiset ℕ) = A.val) : (v : Multiset ℕ) = (A.erase a).val := by
  rw [Finset.erase_val, ← h, ← Multiset.cons_coe, Multiset.erase_cons_head]

/-- **The reading word of a normal monomial in the bracket is the least leaf followed by an
arrangement of the others.** -/
lemma exists_read_eq {A : Finset ℕ} (hA : A.Nonempty) {m : SMono ComGen A}
    (hm : (rules K).Normal m) : ∃ v ∈ AssShGen.arr (A.erase (A.min' hA)),
      PoisDim.read (PoisShGen.toPE (brM m).1) = A.min' hA :: v := by
  have hN := PoisShGen.nf_of_normal (normal_brM K hm) (brM m).1 [] (get?_nil _)
  obtain ⟨v, hv⟩ := PoisDim.read_lie _ hN (isLie_toPE_mapV m.1)
  rw [PoisShGen.first_toPE, first_eq_min' hA (brM m)] at hv
  refine ⟨v, AssShGen.mem_arr.2 (coe_eq_erase ?_), hv⟩
  rw [← hv, PoisDim.coe_read, PoisShGen.labels_toPE, (brM m).labels_eq]

/-- **The arrangement of the leaves other than the least read on a normal monomial.** -/
noncomputable def tailRead {A : Finset ℕ} (hA : A.Nonempty) :
    ((rules K).rw A).Irr → AssShGen.arr (A.erase (A.min' hA)) := fun m =>
  ⟨(PoisDim.read (PoisShGen.toPE (brM m.1).1)).tail, by
    obtain ⟨v, hv, hr⟩ := exists_read_eq K hA ((rules K).mem_irr_iff.1 m.2)
    rw [hr, List.tail_cons]
    exact hv⟩

lemma tailRead_bijective {A : Finset ℕ} (hA : A.Nonempty) :
    Function.Bijective (tailRead K hA) := by
  refine ⟨?_, ?_⟩
  · rintro ⟨m, hm⟩ ⟨m', hm'⟩ h
    have ht : (PoisDim.read (PoisShGen.toPE (brM m).1)).tail =
        (PoisDim.read (PoisShGen.toPE (brM m').1)).tail := congrArg Subtype.val h
    rw [(rules K).mem_irr_iff] at hm hm'
    obtain ⟨v, -, hr⟩ := exists_read_eq K hA hm
    obtain ⟨v', -, hr'⟩ := exists_read_eq K hA hm'
    rw [hr, hr', List.tail_cons, List.tail_cons] at ht
    have hn : ∀ V : SMono PoisShGen A, (PoisShGen.toPE V.1).labels.Nodup := fun V => by
      rw [PoisShGen.labels_toPE]
      exact V.nodup
    have he : PoisShGen.toPE (brM m).1 = PoisShGen.toPE (brM m').1 :=
      PoisDim.read_injective _ _
        (PoisShGen.nf_of_normal (normal_brM K hm) (brM m).1 [] (get?_nil _))
        (PoisShGen.nf_of_normal (normal_brM K hm') (brM m').1 [] (get?_nil _))
        (PoisShGen.isShuffle_toPE (brM m).isShuffle) (PoisShGen.isShuffle_toPE (brM m').isShuffle)
        (hn _) (hn _) (by rw [hr, hr', ht])
    exact Subtype.ext (brM_injective A (Subtype.ext (PoisShGen.toPE_injective he)))
  · rintro ⟨v, hv⟩
    have hw : A.min' hA :: v ∈ AssShGen.arr A := AssShGen.mem_arr.2 (by
      rw [← Multiset.cons_coe, AssShGen.mem_arr.1 hv, Finset.erase_val,
        Multiset.cons_erase (Finset.min'_mem A hA)])
    obtain ⟨U, hUn, hUr⟩ := exists_pois_read_eq K hA hw
    obtain ⟨s₀, hs₀⟩ := exists_mapV_eq U.1 (PoisShGen.nf_of_normal hUn U.1 [] (get?_nil _))
      (isLie_of_read hA hUr)
    let m : SMono ComGen A := ⟨s₀, (isShuffle_mapV toBr s₀).1 (hs₀ ▸ U.isShuffle),
      (labels_mapV toBr s₀).symm.trans (hs₀ ▸ U.labels_eq)⟩
    have hbm : brM m = U := Subtype.ext hs₀
    refine ⟨⟨m, (rules K).mem_irr_iff.2 (normal_of_brM K (hbm ▸ hUn))⟩, Subtype.ext ?_⟩
    show (PoisDim.read (PoisShGen.toPE (brM m).1)).tail = v
    rw [hbm, hUr, List.tail_cons]

/-- **There are `(|A| - 1)!` normal monomials on a nonempty set `A` of leaves.** -/
theorem card_irr {A : Finset ℕ} (hA : A.Nonempty) :
    Nat.card ((rules K).rw A).Irr = (A.card - 1).factorial := by
  rw [Nat.card_eq_of_bijective _ (tailRead_bijective K hA), Nat.card_eq_fintype_card,
    Fintype.card_coe, AssShGen.card_arr, Finset.card_erase_of_mem (Finset.min'_mem A hA)]

/-- **The quotient by the ideal of the Jacobi rule has dimension `(|A| - 1)!`** on a nonempty
set `A` of leaves. -/
theorem finrank_eq_factorial {A : Finset ℕ} (hA : A.Nonempty) :
    Module.finrank K ((SMono ComGen A →₀ K) ⧸ ((rules K).rw A).ideal) =
      (A.card - 1).factorial := by
  rw [Module.finrank_eq_nat_card_basis (basis K A), card_irr K hA]

lemma finrank_presented (A : Type) [Fintype A] [LinearOrder A] [Nonempty A] :
    Module.finrank K ((rules K).Presented A) = (Fintype.card A - 1).factorial :=
  (finrank_eq_factorial K (Finset.nonempty_range_iff.2 Fintype.card_ne_zero)).trans
    (by rw [Finset.card_range])

end LieSh

/-- **`dim Lie(n) = (n - 1)!`**: the Lie operad has dimension `(|A| - 1)!` on a nonempty finite
set `A` of inputs, over a field. -/
theorem Lie.finrank_eq (K : Type u) [Field K] (A : Type) [Fintype A] [DecidableEq A]
    [Nonempty A] : Module.finrank K (Lie K A) = (Fintype.card A - 1).factorial := by
  rw [(SymOperad.mapEquiv (R := K) (P := Lie K) (Fintype.equivFin A)).finrank_eq]
  haveI : Nonempty (Fin (Fintype.card A)) := ⟨⟨0, Fintype.card_pos⟩⟩
  have h := ((LieSh.presIso K).linearEquiv (Fin (Fintype.card A))).finrank_eq
  rw [LieSh.finrank_presented, Fintype.card_fin] at h
  exact h.symm

end Operad
